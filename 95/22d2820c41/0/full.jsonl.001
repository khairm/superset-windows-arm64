},{"label":"Finished only","description":"Only the 'chat finished' notification; questions and failures stay as today."}],"multiSelect":false}],"answers":{"How should the notification text be laid out?":"Context in title (Recommended)","When the workspace has only one tab, does the tab name still show?":"Omit tab (Recommended)","Which companion alerts get the project/workspace/tab context?":"All alert types (Recommended)"},"annotations":{}},"sourceToolAssistantUUID":"c8af0c4c-175f-4462-8d43-b9182a0cdd14","session_id":"41b65f55-7b51-4cfd-82d1-d1d1eec49d91","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\khair\\Code Projects\\fork-superset-windows-arm64","sessionId":"41b65f55-7b51-4cfd-82d1-d1d1eec49d91","version":"2.1.233","gitBranch":"main","slug":"jolly-singing-lemur"}
