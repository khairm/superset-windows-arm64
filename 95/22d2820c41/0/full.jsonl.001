\t\tconst guardsAbstained: AnswerGuardName[] = [...ANSWER_GUARD_NAMES];\n3147\t\tconst evaluation = Object.fromEntries(\n3148\t\t\tANSWER_GUARD_NAMES.map((guard) => [guard, false]),\n3149\t\t) as GuardEvaluation;\n3150\t\tlet written = 0;\n3151\t\n3152\t\tconst abort = (reason: string, index: number): InjectionResult => ({\n3153\t\t\tkind: \"unconfirmed\",\n3154\t\t\treason,\n3155\t\t\tabortedAt: index,\n3156\t\t\twritten,\n3157\t\t\tguardsPassed,\n3158\t\t\tguardsAbstained,\n3159\t\t\tevaluation,\n3160\t\t});\n3161\t\n3162\t\tfor (let index = 0; index < keystrokes.length; index += 1) {\n3163\t\t\tconst keystroke = keystrokes[index];\n3164\t\t\tif (keystroke === undefined) return abort(\"missing keystroke\", index);\n3165\t\t\tif (deps.now() >= deadlineMs) {\n3166\t\t\t\treturn abort(\"sequence deadline exceeded\", index);\n3167\t\t\t}\n3168\t\n3169\t\t\tconst extension = deps.leases.extend(leaseId, deps.now());\n3170\t\t\tif (!extension.ok) {\n3171\t\t\t\tdeps.log({\n3172\t\t\t\t\tevent: \"companion.answer.lease_lost\",\n3173\t\t\t\t\tquestionId: question.questionId,\n3174\t\t\t\t\tleaseId,\n3175\t\t\t\t\treason: extension.reason,\n3176\t\t\t\t\tkeystrokeIndex: index,\n3177\t\t\t\t});\n3178\t\t\t\treturn abort(`lease ${extension.reason}`, index);\n3179\t\t\t}\n3180\t\n3181\t\t\tlet result: { success: true } | { error: string };\n3182\t\t\ttry {\n3183\t\t\t\tresult = writer.write({\n3184\t\t\t\t\tterminalId: host.hostTerminalId,\n3185\t\t\t\t\tworkspaceId: host.hostWorkspaceId,\n3186\t\t\t\t\tdata: keystroke.data,\n3187\t\t\t\t});\n3188\t\t\t} catch (error) {\n3189\t\t\t\tdeps.log({\n3190\t\t\t\t\tevent: \"companion.answer.write_threw\",\n3191\t\t\t\t\tquestionId: question.questionId,\n3192\t\t\t\t\tterminalId: question.terminalId,\n3193\t\t\t\t\tkeystrokeIndex: index,\n3194\t\t\t\t\terror: error instanceof Error ? error.message : String(error),\n3195\t\t\t\t});\n3196\t\t\t\treturn abort(\"pty write threw\", index);\n3197\t\t\t}\n3198\t\n3199\t\t\tif (\"error\" in result) {\n3200\t\t\t\tdeps.log({\n3201\t\t\t\t\tevent: \"companion.answer.write_refused\",\n3202\t\t\t\t\tquestionId: question.questionId,\n3203\t\t\t\t\tterminalId: question.terminalId,\n3204\t\t\t\t\tkeystrokeIndex: index,\n3205\t\t\t\t\twritten,\n3206\t\t\t\t\terror: result.error,\n3207\t\t\t\t});\n3208\t\t\t\treturn abort(`pty write refused: ${result.error}`, index);\n3209\t\t\t}\n3210\t\n3211\t\t\twritten += 1;\n3212\t\t}\n3213\t\n3214\t\treturn {\n3215\t\t\tkind: \"confirmed\",\n3216\t\t\tguardsPassed,\n3217\t\t\tguardsAbstained,\n3218\t\t\tevaluation,\n3219\t\t};\n3220\t}\n3221\t\n3222\t/**\n3223\t * A snapshot that never throws into the critical section. A source that fails is\n3224\t * `null`, which every caller treats as \"do not write\" — never as \"carry on\".\n3225\t */\n3226\tasync function safeSnapshot(\n3227\t\tdeps: AnswerDeps,\n3228\t\tterminalId: TerminalId,\n3229\t): Promise<string | null> {\n3230\t\ttry {\n3231\t\t\treturn await deps.snapshotScreen(terminalId);\n3232\t\t} catch (error) {\n3233\t\t\tdeps.log({\n3234\t\t\t\tevent: \"companion.answer.snapshot_error\",\n3235\t\t\t\tterminalId,\n3236\t\t\t\terror: error instanceof Error ? error.message : String(error),\n3237\t\t\t});\n3238\t\t\treturn null;\n3239\t\t}\n3240\t}\n3241\t\n3242\t/**\n3243\t * Polls the emulator until the screen differs from `previous`, proving the TUI\n3244\t * consumed our last byte and the mirror caught up. Returns the new screen, or\n3245\t * `null` on timeout or on an unreadable emulator — never the stale screen.\n3246\t */\n3247\tasync function awaitScreenAdvance(\n3248\t\tdeps: AnswerDeps,\n3249\t\tterminalId: TerminalId,\n3250\t\tprevious: string,\n3251\t\tdeadlineMs: EpochMs,\n3252\t): Promise<string | null> {\n3253\t\tfor (;;) {\n3254\t\t\tconst screen = await safeSnapshot(deps, terminalId);\n3255\t\t\tif (screen === null) return null;\n3256\t\t\tif (screen !== previous) return screen;\n3257\t\t\tif (deps.now() >= deadlineMs) return null;\n3258\t\t\tawait sleep(