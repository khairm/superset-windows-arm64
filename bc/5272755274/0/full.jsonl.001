n1269\t * never looked at `data`. A sequence labelled\n1270\t * `[toggle_digit \"1\", submit_tab \"\\r\", submit_return \"\\r\"]` therefore PASSED\n1271\t * every assertion, while its raw bytes are `1\\r\\r`: a bare return immediately\n1272\t * after a toggle, which on a multi-select flips a row and does not submit. That\n1273\t * is precisely the shape the check exists to catch, so the check was checking the\n1274\t * wrong thing. Labels are what a future bug gets wrong; bytes are what the picker\n1275\t * consumes, so bytes are what is asserted.\n1276\t */\n1277\texport function assertKeystrokeBytes(\n1278\t\tshape: AnswerShape,\n1279\t\tkeystrokes: readonly Keystroke[],\n1280\t): void {\n1281\t\tfor (let index = 0; index < keystrokes.length; index += 1) {\n1282\t\t\tconst keystroke = keystrokes[index];\n1283\t\t\tif (keystroke === undefined) {\n1284\t\t\t\tthrow selfCheck(`shape ${shape}: missing keystroke at ${index}`);\n1285\t\t\t}\n1286\t\t\tconst at = `shape ${shape} keystroke ${index} (${keystroke.kind})`;\n1287\t\t\tswitch (keystroke.kind) {\n1288\t\t\t\tcase \"select_digit\":\n1289\t\t\t\tcase \"toggle_digit\":\n1290\t\t\t\tcase \"freetext_open\": {\n1291\t\t\t\t\tif (!SINGLE_DIGIT.test(keystroke.data)) {\n1292\t\t\t\t\t\tthrow selfCheck(\n1293\t\t\t\t\t\t\t`${at}: data must be a single row digit 1-9, got ${JSON.stringify(keystroke.data)}`,\n1294\t\t\t\t\t\t);\n1295\t\t\t\t\t}\n1296\t\t\t\t\tif (keystroke.optionIndex === null) {\n1297\t\t\t\t\t\tthrow selfCheck(`${at}: a digit keystroke must name its optionIndex`);\n1298\t\t\t\t\t}\n1299\t\t\t\t\tif (keystroke.data !== String(keystroke.optionIndex + 1)) {"}]},"uuid":"7b5d0d43-f129-491d-8f6c-00cf9cc6dda3","timestamp":"2026-08-12T11:14:20.941Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\khair\\Code Projects\\fork-superset-windows-arm64\\packages\\host-service\\src\\companion\\keystrokes.ts","content":"\t\t);\n\t}\n\tconst slot = item.freeTextOption.index;\n\treturn [\n\t\t{\n\t\t\tkind: \"