d: host.hostTerminalId,\n1418\t\t\t\t\tworkspaceId: host.hostWorkspaceId,\n1419\t\t\t\t\tdata: frame.data,\n1420\t\t\t\t});\n1421\t\t\t} catch (error) {\n1422\t\t\t\tdeps.log({\n1423\t\t\t\t\tevent: \"companion.answer.write_threw\",\n1424\t\t\t\t\tquestionId: question.questionId,\n1425\t\t\t\t\tterminalId: question.terminalId,\n1426\t\t\t\t\tframeIndex,\n1427\t\t\t\t\terror: error instanceof Error ? error.message : String(error),\n1428\t\t\t\t});\n1429\t\t\t\treturn abort(\"pty write threw\", frame.abortAt, \"unknown\");\n1430\t\t\t}\n1431\t\n1432\t\t\tif (\"error\" in result) {\n1433\t\t\t\tdeps.log({\n1434\t\t\t\t\tevent: \"companion.answer.write_refused\",\n1435\t\t\t\t\tquestionId: question.questionId,\n1436\t\t\t\t\tterminalId: question.terminalId,\n1437\t\t\t\t\tframeIndex,\n1438\t\t\t\t\twritten,\n1439\t\t\t\t\twriteOutcome: result.writeOutcome,\n1440\t\t\t\t\terror: result.error,\n1441\t\t\t\t});\n1442\t\t\t\treturn abort(\n1443\t\t\t\t\t`pty write refused: ${result.error}`,\n1444\t\t\t\t\tframe.abortAt,\n1445\t\t\t\t\tresult.writeOutcome,\n1446\t\t\t\t);\n1447\t\t\t}\n1448\t\n1449\t\t\twritten += frame.acknowledgedKeystrokes;\n1450\t\t}\n1451\t\n1452\t\treturn { kind: \"confirmed\" };\n1453\t}\n1454\t\n1455\t/**\n1456\t * A snapshot that never throws into the critical section. A source that fails is\n1457\t * `null`, which every caller treats as \"do not write\" — never as \"carry on\".\n1458\t */\n1459\tasync function safeSnapshot(\n1460\t\tdeps: AnswerDeps,\n1461\t\tterminalId: TerminalId,\n1462\t): Promise<string | null> {\n1463\t\ttry {\n1464\t\t\treturn await deps.snapshotScreen(terminalId);\n1465\t\t} catch (error) {\n1466\t\t\tdeps.log({\n1467\t\t\t\tevent: \"companion.answer.snapshot_error\",\n1468\t\t\t\tterminalId,\n1469\t\t\t\terror: error instanceof Error ? error.message : String(error),\n1470\t\t\t});\n1471\t\t\treturn null;\n1472\t\t}\n1473\t}\n1474\t\n1475\t/**\n1476\t * Polls the emulator until the screen differs from `previous`, proving the