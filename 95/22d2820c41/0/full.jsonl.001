{"parentUuid":"3dd0ce01-3ef7-4c8e-80cb-31e62633d7a3","isSidechain":false,"promptId":"5548f27b-2b1d-4e0e-84da-bd27822c3dc9","type":"user","message":{"role":"user","content":[{"tool_use_id":"call_G7raX0CFT6OB5yQBk5kU1jbx","type":"tool_result","content":"75\t// ---------------------------------------------------------------------------\n76\t// tunables (bridge-internal; none of these are on the wire)\n77\t// ---------------------------------------------------------------------------\n78\t\n79\t/**\n80\t * How long a request will wait for the per-terminal lock. On expiry NOTHING has\n81\t * been written — the critical section never ran — and the client is told so.\n82\t */\n83\texport const LOCK_WAIT_TIMEOUT_MS = 5_000;\n84\t\n85\t/** Poll interval while waiting for the emulator mirror to reflect our last byte. */\n86\texport const SCREEN_ADVANCE_POLL_MS = 25;\n87\t\n88\t/**\n89\t * (ANSWER-FRAME-PACING) Fixed inter-frame settling time proven against a real\n90\t * Claude Code 2.1.228 N=4 picker. Daemon write acknowledgements report only that\n91\t * the PTY accepted a frame; they arrive before the TUI advances to the next item.\n92\t * Protocol-v3 therefore waits this long after every acknowledged non-final frame.\n93\t */\n94\texport const ANSWER_INTER_FRAME_DELAY_MS = 500;\n95\t\n96\t/**\n97\t * Unpaced execution allowance for one sequence. Pacing is added dynamically for\n98\t * every legal inter-frame gap; it must not consume this allowance.\n99\t */\n100\texport const SEQUENCE_EXECUTION_ALLOWANCE_MS = 10_000;\n101\t\n102\t/**\n103\t * Maximum frames any legal encoded prompt can contain: 32 questions, each a\n104\t * multi-select group of all nine digit-addressable options plus one advance\n105\t * arrow, followed by one review-screen return: `32 * (9 + 1) + 1 = 321`.\n106\t * Although capture permits 32 options, rows 10..32 have no safe single-key\n107\t * encoding and are refused by `digitFor`.\n108\t */\n109\texport const MAX_ENCODED_ANSWER_FRAMES =\n110\t\tMAX_QUESTIONS_PER_PROMPT * (MAX_DIGIT_ADDRESSABLE_INDEX + 2) + 1;\n111\t\n112\t/** The largest dynamic deadline admitted by the legal frame bound above. */\n113\texport const MAX_SEQUENCE_DEADLINE_MS =\n114\t\tSEQUENCE_EXECUTION_ALLOWANCE_MS +\n115\t\t(MAX_ENCODED_ANSWER_FRAMES - 1) * ANSWER_INTER_FRAME_DELAY_MS;\n116\t\n117\t/** PROTOCOL §7.5 — a message body is 1..8 192 chars. */\n118\texport const MESSAGE_MAX_CHARS = 8_192;\n119\t\n120\t/**\n121\t * (MESSAGE-ECHO) How long `/v1/message` waits for the composer to render the\n122\t * text it just pasted, before it will write the trailing submit.\n123\t *\n124\t * A paste of up to 8 192 chars can require a substantial repaint. The wait is\n125\t * bounded because the\n126\t * terminal lock is held throughout.\n127\t */\n128\texport const MESSAGE_ECHO_TIMEOUT_MS = 2_000;\n129\t\n130\t/**\n131\t * (MESSAGE-ECHO) Squashed characters of the message used as the on-screen\n132\t * anchor. Long enough that matching it by chance is implausible, short enough to\n133\t * survive the composer hard-wrapping.\n134\t */"}]},"uuid":"4e5dd1a7-cdb8-40ad-96a0-6d8e85764175","timestamp":"2026-08-12T17:41:17.061Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\khair\\Code Projects\\fork-superset-windows-arm64\\.claude\\worktrees\\agent-a97cb2eaada150f8f\\packages\\host-service\\src\\companion\\answer.ts","content":"// ---------------------------------------------------------------------------\n// tunables (bridge-internal; none of these are on the wire)\n// ---------------------------------------------------------------------------\n\n/**\n * How long a request will wait for the per-terminal lock. On expiry NOTHING has\n * been written — the critical section never ran — and the client is told so.\n */\nexport const LOCK_WAIT_TIMEOUT_MS = 5_000;\n\n/** Poll interval while waiting for the emulator mirror to reflect our last byte. */\nexport const SCREEN_ADVANCE_POLL_MS = 25;\n\n/**\n * (ANSWER-FRAME-PACING) Fixed inter-frame settling time proven against a real\n * Claude Code 2.1.228 N=4 picker. Daemon write acknowledgements report only that\n * the PTY accepted a frame; they arrive before the TUI advances to the next item.\n * Protocol-v3 therefore waits this long after every acknowledged non-final frame.\n */\nexport const ANSWER_INTER_FRAME_DELAY_MS = 500;\n\n/**\n * Unpaced execution allowance for one sequence. Pacing is added dynamically for\n * every legal inter-frame gap; it must not consume this allowance.\n */\nexport const SEQUENCE_EXECUTION_ALLOWANCE_MS = 10_000;\n\n/**\n * Maximum frames any legal encoded prompt can contain: 32 questions, each a\n * multi-select group of all nine digit-addressable options plus one advance\n * arrow, followed by one review-screen return: `32 * (9 + 1) + 1 = 321`.\n * Although capture permits 32 options, rows 10..32 have no safe single-key\n * encoding and are refused by `digitFor`.\n */\nexport const MAX_ENCODED_ANSWER_FRAMES =\n\tMAX_QUESTIONS_PER_PROMPT * (MAX_DIGIT_ADDRESSABLE_INDEX + 2) + 1;\n\n/** The largest dynamic deadline admitted by the legal frame bound above. */\nexport const MAX_SEQUENCE_DEADLINE_MS =\n\tSEQUENCE_EXECUTION_ALLOWANCE_MS +\n\t(MAX_ENCODED_ANSWER_FRAMES - 1) * ANSWER_INTER_FRAME_DELAY_MS;\n\n/** PROTOCOL §7.5 — a message body is 1..8 192 chars. */\nexport const MESSAGE_MAX_CHARS = 8_192;\n\n/**\n * (MESSAGE-ECHO) How long `/v1/message` waits for the composer to render the\n * text it just pasted, before it will write the trailing submit.\n *\n * A paste of up to 8 192 chars can require a substantial repaint. The wait is\n * bounded because the\n * terminal lock is held throughout.\n */\nexport const MESSAGE_ECHO_TIMEOUT_MS = 2_000;\n\n/**\n * (MESSAGE-ECHO) Squashed characters of the message used as the on-screen\n * anchor. Long enough that matching it by chance is implausible, short enough to\n * survive the composer hard-wrapping.\n */","numLines":60,"startLine":75,"totalLines":2487}},"sourceToolAssistantUUID":"3dd