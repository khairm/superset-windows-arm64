is block used to build an `in_flight` record and durably write it just\n1110\t\t\t\t// before taking the lock, with a long comment explaining that the ~15 s of\n1111\t\t\t\t// lock-wait-plus-sequence was a window in which the client's recovery read\n1112\t\t\t\t// answered \"the desktop never saw this request\". Writing it HERE only narrowed\n1113\t\t\t\t// that window; it could not close it, because everything above this line —\n1114\t\t\t\t// preflight, the agent-kind check, the writer probe, the lease — still ran\n1115\t\t\t\t// before the record existed.\n1116\t\t\t\t//\n1117\t\t\t\t// The claim now happens at the very top of `handleAnswer`, as an atomic\n1118\t\t\t\t// compare-and-set, so by the time control reaches here the requestId has been\n1119\t\t\t\t// occupied for the whole of that work and a status read can only ever report\n1120\t\t\t\t// `in_flight`. The unwritable-store branch is gone with it: a claim that cannot\n1121\t\t\t\t// be persisted throws out of `claimForAnswer` before any of this runs, which is\n1122\t\t\t\t// the same refusal one step earlier and without a record to take back out.\n1123\t\n1124\t\t\t\tconst result = await deps.locks.runExclusive(\n1125\t\t\t\t\tquestion.terminalId,\n1126\t\t\t\t\tLOCK_WAIT_TIMEOUT_MS,\n1127\t\t\t\t\t() => {\n1128\t\t\t\t\t\t// The preflight happened before audit I/O and lock acquisition. Re-check\n1129\t\t\t\t\t\t// the store at the last synchronous point before the first PTY write so a\n1130\t\t\t\t\t\t// desk answer or superseding capture cannot turn this answer into composer\n1131\t\t\t\t\t\t// text or an answer to the replacement picker. This is question identity,\n1132\t\t\t\t\t\t// not screen/transcript/session evidence.\n1133\t\t\t\t\t\trequireCurrentPendingAnswerQuestion(deps, request);\n1134\t\t\t\t\t\tlet durableFence: LedgerRecord | null;\n1135\t\t\t\t\t\ttry {\n1136\t\t\t\t\t\t\tdurableFence = deps.ledger.beginWrite(\n1137\t\t\t\t\t\t\t\trequest.requestId,\n1138\t\t\t\t\t\t\t\tlease.leaseId,\n1139\t\t\t\t\t\t\t);\n1140\t\t\t\t\t\t} catch (error) {\n1141\t\t\t\t\t\t\tdeps.log({\n1142\t\t\t\t\t\t\t\tevent: \"companion.answer.begin_write_failed\",\n1143\t\t\t\t\t\t\t\trequestId: request.requestId,\n1144\t\t\t\t\t\t\t\tquestionId: request.questionId,\n1145\t\t\t\t\t\t\t\terror: error instanceof Error ? error.message : String(error),\n1146\t\t\t\t\t\t\t});\n1147\t\t\t\t\t\t\tthrow sealed(\n1148\t\t\t\t\t\t\t\t503,\n1149\t\t\t\t\t\t\t\t\"internal\",\n1150\t\t\t\t\t\t\t\t\"the durable write fence could not be established; nothing was written — submit a new request to retry\",\n1151\t\t\t\t\t\t\t);\n1152\t\t\t\t\t\t}\n1153\t\t\t\t\t\tif (durableFence !== null) {\n1154\t\t\t\t\t\t\tthrow sealed(\n1155\t\t\t\t\t\t\t\t409,\n1156\t\t\t\t\t\t\t\t\"already_resolved\",\n1157\t\t\t\t\t\t\t\tdurableFence.status === \"confirmed\"\n1158\t\t\t\t\t\t\t\t\t? \"an answer for this question was already delivered; it will not be typed again\"\n1159\t\t\t\t\t\t\t\t\t: \"an answer for this question may already have been delivered; it will not be typed again\",\n1160\t\t\t\t\t\t\t\t{\n1161\t\t\t\t\t\t\t\t\tresolvedBy: null,\n1162\t\t\t\t\t\t\t\t\tresolvedAtMs: durableFence.resolvedAtMs,\n1163\t\t\t\t\t\t\t\t\toutcome:\n1164\t\t\t\t\t\t\t\t\t\tdurableFence.status === \"confirmed\" ? \"answered\" : \"unknown\",\n1165\t\t\t\t\t\t\t\t},\n1166\t\t\t\t\t\t\t);\n1167\t\t\t\t\t\t}\n1168\t\t\t\t\t\treturn injectSequence(deps, {\n1169\t\t\t\t\t\t\tquestion,\n1170\t\t\t\t\t\t\thost,\n1171\t\t\t\t\t\t\tkeystrokes,\n1172\t\t\t\t\t\t\tleaseId: lease.leaseId,\n1173\t\t\t\t\t\t\tacknowledgedInputSupported: prepared.acknowledgedInputSupported,\n1174\t\t\t\t\t\t\twriter,\n1175\t\t\t\t\t\t});\n1176\t\t\t\t\t},\n1177\t\t\t\t);\n1178\t\n1179\t\t\t\tif (result.kind === \"confirmed\") {\n1180\t\t\t\t\tconst resolvedAtMs = deps.now();\n1181\t\t\t\t\tconst record: AnswerAttemptRecord = {\n1182\t\t\t\t\t\t...baseAttempt,\n1183\t\t\t\t\t\tstatus: \"confirmed\",\n1184\t\t\t\t\t\tresolvedAtMs,\n1185\t\t\t\t\t\