{"parentUuid":"8bce639b-b59b-418e-bd26-55659bf1920a","isSidechain":false,"promptId":"0a8de032-5fd3-4106-bcf4-797ed6a2efc2","type":"user","message":{"role":"user","content":[{"tool_use_id":"call_knfKtngAZgCnlQ9ozmDSBZCu","type":"tool_result","content":"2080\t\t\t\t\t\t),\n2081\t\t\t\t\t) as GuardEvaluation);\n2082\t\treturn { guardsPassed, guardsAbstained, evaluation };\n2083\t}\n2084\t\n2085\t/** A source that throws or answers `null` counts as FALSE. Never \"probably fine\". */\n2086\tasync function readGuardSource(\n2087\t\tname: AnswerGuardName,\n2088\t\tdeps: AnswerDeps,\n2089\t\tread: () => Promise<GuardSourceResult>,\n2090\t): Promise<boolean> {\n2091\t\ttry {\n2092\t\t\tconst value = await read();\n2093\t\t\tif (value === null) {\n2094\t\t\t\tdeps.log({\n2095\t\t\t\t\tevent: \"companion.guard.indeterminate\",\n2096\t\t\t\t\tguard: name,\n2097\t\t\t\t\tresult: false,\n2098\t\t\t\t});\n2099\t\t\t\treturn false;\n2100\t\t\t}\n2101\t\t\treturn value;\n2102\t\t} catch (error) {\n2103\t\t\tdeps.log({\n2104\t\t\t\tevent: \"companion.guard.error\",\n2105\t\t\t\tguard: name,\n2106\t\t\t\tresult: false,\n2107\t\t\t\terror: error instanceof Error ? error.message : String(error),\n2108\t\t\t});\n2109\t\t\treturn false;\n2110\t\t}\n2111\t}\n2112\t\n2113\t/**\n2114\t * The reader for a `veto_only` guard, which has DIFFERENT null semantics from\n2115\t * every other class and therefore cannot share `readGuardSource`.\n2116\t *\n2117\t * `GUARD_CLASSES` defines veto_only as \"Absence is a sound veto; presence is\n2118\t * never evidence\". Only an AFFIRMATIVE `false` — the source was read and the\n2119\t * thing is genuinely absent — may veto. `null` means the source could not be\n2120\t * read at all, which is not absence and therefore not a veto.\n2121\t *\n2122\t * Running a veto_only guard through `readGuardSource` collapses `null` to\n2123\t * `false` and turns it into a MANDATORY POSITIVE: with no marker reader wired,\n2124\t * guard 6 would fail 100% of answers with `guard_failed{askq_marker}` — a\n2125\t * refusal indistinguishable, to the client, from a question that went stale.\n2126\t * That is the fail-fast rule inverted: silent, and wrong in a way that looks\n2127\t * routine.\n2128\t */\n2129\tasync function readVetoGuardSource(\n2130\t\tname: AnswerGuardName,\n2131\t\tdeps: AnswerDeps,\n2132\t\tread: () => Promise<GuardSourceResult>,\n2133\t): Promise<boolean> {\n2134\t\ttry {\n2135\t\t\tconst value = await read();\n2136\t\t\tif (value === null) {\n2137\t\t\t\tdeps.log({\n2138\t\t\t\t\tevent: \"companion.guard.unreadable_no_veto\",\n2139\t\t\t\t\tguard: name,\n2140\t\t\t\t\tresult: true,\n2141\t\t\t\t});\n2142\t\t\t\treturn true;\n2143\t\t\t}\n2144\t\t\treturn value;\n2145\t\t} catch (error) {\n2146\t\t\t// A source that THREW is also \"could not read\", not \"absent\".\n2147\t\t\tdeps.log({\n2148\t\t\t\tevent: \"companion.guard.error\",\n2149\t\t\t\tguard: name,\n2150\t\t\t\tresult: true,\n2151\t\t\t\terror: error instanceof Error ? error.message : String(error),\n2152\t\t\t});\n2153\t\t\treturn true;\n2154\t\t}\n2155\t}\n2156\t\n2157\t/**\n2158\t * (GUARD4-ABSTAIN) The reader for a guard in `ABSTAINING_GUARDS`, which needs\n2159\t * the RAW tri-state rather than `readGuardSource`'s collapse to `false`.\n2160\t *\n2161\t * \"Could not read\" and \"read, and it is clear\" are the same outcome for such a\n2162\t * guard — neither refuses — but they are not the same DIAGNOSIS, and the abstain\n2163\t * event says which one happened. Collapsing them first would throw that away at\n2164\t * the only place it is cheap to keep.\n2165\t */\n2166\tasync function readAbstainingGuardSource(\n2167\t\tname: AnswerGuardName,\n2168\t\tdeps: AnswerDeps,\n2169\t\tread: () => Promise<GuardSourceResult>,\n2170\t): Promise<GuardSourceResult> {\n2171\t\ttry {\n2172\t\t\treturn await read();\n2173\t\t} catch (error) {\n2174\t\t\tdeps.log({\n2175\t\t\t\tevent: \"companion.guard.error\",\n2176\t\t\t\tguard: name,\n2177\t\t\t\tresult: null,\n2178\t\t\t\terror: error instanceof Error ? error.message : String(error),\n2179\t\t\t});\n2180\t\t\treturn null;\n2181\t\t}\n2182\t}\n2183\t\n2184\t/**\n2185\t * §11.3 — all six guards, evaluated inside the caller's critical section.\n2186\t *\n2187\t * Order is load-bearing FIRST and short-circuiting. That is the mechanism by\n2188\t * which a forgeable source can never appear on a permitting path: if guard 1 or\n2189\t * guard 5 fails, the forgeable sources are not even read.\n2190\t *\n2191\t * `screen` is passed in rather than fetched, so the caller can prove the same\n2192\t * snapshot backed the decision and the write.\n2193\t */\n2194\texport async function evaluateGuards(\n2195\t\tdeps: AnswerDeps,\n2196\t\tinput: {\n2197\t\t\tquestion: PendingQuestion;\n2198\t\t\tscreen: string;\n2199\t\t\texpectation: ScreenExpectation;\n2200\t\t\trequireOptionIndex: number | null;\n2201\t\t},\n2202\t): Promise<GuardOutcome> {\n2203\t\tconst evaluation: GuardEvaluation = {\n2204\t\t\ttranscript: false,\n2205\t\t\tscreen: false,\n2206\t\t\tbinding: false,\n2207\t\t\tpermission_axis: false,\n2208\t\t\tsession: false,\n2209\t\t\taskq_marker: false,\n2210\t\t};\n2211\t\tconst passed: AnswerGuardName[] = [];\n2212\t\t/** (GUARD4-ABSTAIN) Guards carried on a non-positive reading. */\n2213\t\tconst abstained: AnswerGuardName[] = [];\n2214\t\t/**\n2215\t\t * Every step through the stack is checked against `GUARD_EVALUATION_ORDER`, so\n2216\t\t * the classification's ordering rule is enforced against what this function\n2217\t\t * ACTUALLY does rather than against the shape of the source below.\n2218\t\t *\n2219\t\t * (GUARD4-ABSTAIN) The position is its OWN counter and no longer\n2220\t\t * `passed.length`. An abstaining guard advances the stack without joining\n2221\t\t * `passed` — it did not pass, and `guardsPassed` is the durable audit answer\n2222\t\t * to \"what permitted this write\" — so deriving position from that array would\n2223\t\t * throw the self-check off by one for every guard after it.\n2224\t\t */\n2225\t\tlet position = 0;\n2226\t\tconst at = (guard: AnswerGuardName): void => {\n2227\t\t\tif (GUARD_EVALUATION_ORDER[position] !== guard) {\n2228\t\t\t\tthrow new Error(\n2229\t\t\t\t\t`(COMPANION-BRIDGE) guard stack self-check: reached ${guard} at position ${position}, where GUARD_EVALUATION_ORDER requires ${String(GUARD_EVALUATION_ORDER[position])}`,\n2230\t\t\t\t);\n2231\t\t\t}\n2232\t\t};\n2233\t\tconst advance = (guard: AnswerGuardName): void => {\n2234\t\t\tat(guard);\n2235\t\t\tposition += 1;\n2236\t\t\tpassed.push(guard);\n2237\t\t};\n2238\t\t/**\n2239\t\t * (GUARD4-ABSTAIN) Walk past a guard WITHOUT recording it as passed. The two\n2240\t\t * arrays are disjoint by construction, so a durable row can never say a guard\n2241\t\t * both permitted the write and read false.\n2242\t\t */\n2243\t\tconst abstain = (guard: AnswerGuardName): void => {\n2244\t\t\tat(guard);\n2245\t\t\tposition += 1;\n2246\t\t\tabstained.push(guard);\n2247\t\t};\n2248\t\tconst fail = (\n2249\t\t\tguard: AnswerGuardName,\n2250\t\t\tscreenMatch: PickerScreenMatch | null,\n2251\t\t) => {\n2252\t\t\tat(guard);\n2253\t\t\treturn {\n2254\t\t\t\tevaluation,\n2255\t\t\t\tpassed,\n2256\t\t\t\tabstained,\n2257\t\t\t\tfailed: guard,\n2258\t\t\t\tscreenMatch,\n2259\t\t\t} satisfies GuardOutcome;\n2260\t\t};\n2261\t\n2262\t\t// --- guard 1: the tool call has not already been answered (LOAD-BEARING) ---\n2263\t\tconst alreadyAnswered = await readGuardSource(\n2264\t\t\t\"transcript\",\n2265\t\t\tdeps,\n2266\t\t\tasync () => {\n2267\t\t\t\tconst exists = await deps.toolResultExists({\n2268\t\t\t\t\tterminalId: input.question.terminalId,\n2269\t\t\t\t\tsessionId: input.question.sessionId,\n2270\t\t\t\t\ttoolUseId: input.question.toolUseId,\n2271\t\t\t\t});\n2272\t\t\t\t// An unreadable transcript is `null` -> false -> guard fails. Inverting\n2273\t\t\t\t// here would turn \"cannot check\" into \"no result yet\", which is the\n2274\t\t\t\t// exact mistake this stack exists to avoid.\n2275\t\t\t\treturn exists === null ? null : !exists;\n2276\t\t\t},\n2277\t\t);\n2278\t\tevaluation.transcript = alreadyAnswered;\n2279\t\tif (!alreadyAnswered) return fail(\"transcript\", null);\n2280\t\tadvance(\"transcript\");\n2281\t\n2282\t\t// --- guard 5: the picker is on screen showing THIS question (LOAD-BEARING) ---\n2283\t\tconst screenMatch = evaluateScreenGuard({\n2284\t\t\tscreen: input.screen,\n2285\t\t\tquestion: input.question,\n2286\t\t\texpectation: input.expectation,\n2287\t\t\trequireOptionIndex: input.requireOptionIndex,\n2288\t\t});\n2289\t\tevaluation.screen = screenMatch.ok;\n2290\t\tif (!screenMatch.ok) return fail(\"screen\", screenMatch);\n2291\t\tadvance(\"screen\");\n2292\t\n2293\t\t// Everything below is either forgeable or merely supporting. It can only\n2294\t\t// REFUSE from here; the two guards that can permit have already passed.\n2295\t\n2296\t\t// --- guard 3: the session is alive (supporting) ---\n2297\t\tconst sessionOk = await readGuardSource(\"session\", deps, () =>\n2298\t\t\tdeps.sessionActive(input.question.terminalId),\n2299\t\t);\n2300\t\tevaluation.session = sessionOk;\n2301\t\tif (!sessionOk) return fail(\"session\", screenMatch);\n2302\t\tadvance(\"session\");\n2303\t\n2304\t\t// --- guard 2: the agent<->session binding still matches (FORGEABLE) ---\n2305\t\tconst bindingOk = await readGuardSource(\"binding\", deps, async () => {\n2306\t\t\tconst binding = await deps.agentBinding(input.question.terminalId);\n2307\t\t\tif (binding === null) return null;\n2308\t\t\tif (!binding.bound) return false;\n2309\t\t\tif (binding.kind !== \"claude\") return false;\n2310\t\t\t// A /resume or a restart mints a new agent session; the captured question\n2311\t\t\t// belongs to the old one and its tool_use_id can no longer be answered.\n2312\t\t\tif (binding.agentSessionId === null) return null;\n2313\t\t\treturn binding.agentSessionId === input.question.sessionId;\n2314\t\t});\n2315\t\tevaluation.binding = bindingOk;\n2316\t\tif (!bindingOk) return fail(\"binding\", screenMatch);\n2317\t\tadvance(\"binding\");\n2318\t\n2319\t\t// --- guard 4: the permission axis is still latched (FORGEABLE, ABSTAINS) ---\n2320\t\tconst permissionAxis = await readAbstainingGuardSource(\n2321\t\t\t\"permission_axis\",\n2322\t\t\tdeps,\n2323\t\t\t() => deps.permissionAxisLatched(input.question.terminalId),\n2324\t\t);\n2325\t\t// The RAW reading, never written up to `true`. The ledger's `guards` column is\n2326\t\t// evidence about what was observed, and an abstain must not be able to forge a\n2327\t\t// record of a latch that was not there.\n2328\t\tevaluation.permission_axis = permissionAxis === true;\n2329\t\tif (permissionAxis === true) {\n2330\t\t\tadvance(\"permission_axis\");\n2331\t\t} else {\n2332\t\t\t// (GUARD4-ABSTAIN) TWO conditions, both checked here rather than inferred\n2333\t\t\t// from the fact that guard 4 runs fourth:\n2334\t\t\t//\n2335\t\t\t//  1. every load-bearing guard actually passed, read back off `evaluation`,\n2336\t\t\t//     so a reordering makes the axis refuse again rather than quietly\n2337\t\t\t//     abstain on a stack that has proved less than it claims;\n2338\t\t\t//  2. this guard is on the abstain list, which `assertGuardClassification`\n2339\t\t\t//     holds to its own rules at module load.\n2340\t\t\t//\n2341\t\t\t// There is deliberately NO expectation-form condition. The axis used to\n2342\t\t\t// keep its refusal on weak `same_prompt` keystrokes (the free-text tail) to\n2343\t\t\t// catch a desk Escape mid-sequence — but the latch is overwritten by ANY\n2344\t\t\t// later hook event, so on a busy terminal it reads clear while the picker\n2345\t\t\t// is verifiably still up, and it vetoed 2/2 legitimate free-text answers\n2346\t\t\t// mid-write, aborting between the editor-open digit and the submit and\n2347\t\t\t// leaving a half-open editor behind. A forgeable latch whose false-veto\n2348\t\t\t// aborts a proven sequence partway is strictly worse than completing the\n2349\t\t\t// proven sequence: the write window is sub-second, the per-keystroke\n2350\t\t\t// load-bearing guards (transcript + screen) still run before every byte,\n2351\t\t\t// and the operator has one seat. The axis is evidence in the ledger now,\n2352\t\t\t// never a veto.\n2353\t\t\tconst loadBearingPassed = LOAD_BEARING_GUARDS.every(\n2354\t\t\t\t(guard) => evaluation[guard],\n2355\t\t\t);\n2356\t\t\tif (!loadBearingPassed || !ABSTAINING_GUARDS.includes(\"permission_axis\")) {\n2357\t\t\t\treturn fail(\"permission_axis\", screenMatch);\n2358\t\t\t}\n2359\t\t\tdeps.log({\n2360\t\t\t\tevent: \"companion.guard.abstain\",\n2361\t\t\t\tguard: \"permission_axis\",\n2362\t\t\t\tguardClass: GUARD_CLASSES.permission_axis,\n2363\t\t\t\t// The two readings an abstain covers, kept apart: a latch the next hook\n2364\t\t\t\t// event overwrote, versus a store this process could not read at all.\n2365\t\t\t\treading: permissionAxis === null ? \"unreadable\" : \"clear\",\n2366\t\t\t\tloadBearing: [...LOAD_BEARING_GUARDS],\n2367\t\t\t\texpectation: input.expectation.kind,\n2368\t\t\t\tquestionId: input.question.questionId,\n2369\t\t\t\tterminalId: input.question.terminalId,\n2370\t\t\t});\n2371\t\t\tabstain(\"permission_axis\");\n2372\t\t}\n2373\t\n2374\t\t// --- guard 6: the .askq marker still exists (VETO ONLY) ---\n2375\t\t// Presence is NOT evidence — markers leak. Only its absence is used, and only\n2376\t\t// to refuse. An unreadable marker directory also refuses.\n2377\t\tconst markerPresent = await readVetoGuardSource(\"askq_marker\", deps, () =>\n2378\t\t\tdeps.askqMarkerExists({\n2379\t\t\t\tterminalId: input.question.terminalId,\n2380\t\t\t\tagentId: input.question.agentId,\n2381\t\t\t\tagentType: input.question.agentType,\n2382\t\t\t}),\n2383\t\t);\n2384\t\tevaluation.askq_marker = markerPresent;\n2385\t\tif (!markerPresent) return fail(\"askq_marker\", screenMatch);\n2386\t\tadvance(\"askq_marker\");\n2387\t\n2388\t\treturn { evaluation, passed, abstained, failed: null, screenMatch };\n2389\t}\n2390\t\n2391\t// ---------------------------------------------------------------------------\n2392\t// errors\n2393\t// ---------------------------------------------------------------------------\n2394\t\n2395\t/** The sealed codes this module is allowed to emit. A closed set, per §10. */\n2396\ttype SealedCode =\n2397\t\t| \"stale_question\"\n2398\t\t| \"already_resolved\"\n2399\t\t| \"lease_held\"\n2400\t\t| \"guard_failed\"\n2401\t\t| \"picker_open\"\n2402\t\t| \"capability_unsupported\"\n2403\t\t/** (ANSWER-LEDGER) The fence. See where it is thrown for why not `already_resolved`. */\n2404\t\t| \"request_closed\"\n2405\t\t| \"write_disabled\"\n2406\t\t| \"bad_request\"\n2407\t\t| \"internal\";\n2408\t\n2409\tfunction sealed(\n2410\t\tstatusCode: number,\n2411\t\tcode: SealedCode,\n2412\t\tmessage: string,\n2413\t\tdetail: Record<string, unknown> | null = null,\n2414\t): SealedError {\n2415\t\treturn new SealedError(statusCode, {\n2416\t\t\tcode,\n2417\t\t\tmessage,\n2418\t\t\tretryAfterMs: null,\n2419\t\t\tdetail,\n2420\t\t});\n2421\t}\n2422\t\n2423\t/**\n2424\t * Maps a pure encoding failure. Every one of these provably wrote nothing: the\n2425\t * encoder runs before the lock is taken and touches no terminal.\n2426\t */\n2427\tfunction sealedFromEncoding(error: KeystrokeEncodingError): SealedError {\n2428\t\tif (error.reason === \"shape_unproven\") {\n2429\t\t\treturn sealed(\n2430\t\t\t\t501,\n2431\t\t\t\t\"capability_unsupported\",\n2432\t\t\t\t\"this prompt shape has no proven byte sequence and is refused rather than guessed; answer it at the desk\",\n2433\t\t\t\t{ capability: \"answer.multiselect\", reason: error.reason },\n2434\t\t\t);\n2435\t\t}\n2436\t\treturn sealed(400, \"bad_request\", error.message, { reason: error.reason });\n2437\t}\n2438\t\n2439\t// ---------------------------------------------------------------------------\n2440\t// idempotency\n2441\t// ---------------------------------------------------------------------------\n2442\t//\n2443\t// (ANSWER-LEDGER) The ~900-line JSON attempt store that used to live here — its\n2444\t// `answer-attempts.json`, its rise-only witness, its quarantine and degrade\n2445\t// paths, its PRUNE-FLOOR and STORE-CLOSED guards — is gone. `attempt-ledger.ts`\n2446\t// replaced it with a table and a transaction.\n2447\t//\n2448\t// It was not deleted for being untidy. It could not close the race it existed to\n2449\t// describe: a status read can overtake an admitted answer, and deciding between\n2450\t// them needs an atomic compare-and-set that a read-modify-rewrite of a file\n2451\t// cannot provide. Every mechanism above was in service of DETECTING that the file\n2452\t// had rolled back, which was a true and useless thing to know.\n2453\t//\n2454\t// Two accepted weaknesses went with it. Its durability rested on an undocumented\n2455\t// inference about NTFS rename ordering (see `writeFileDurable`); SQLite's is\n2456\t// documented, and asserted at FULL. And it validated the file as a WHOLE, so one\n2457\t// incoherent record quarantined every other record's 24 hours — rows validate\n2458\t// individually now, so a corrupt row costs exactly one requestId its status.\n2459\t//\n2460\t// The message path keeps its own small in-memory store below: a message has no\n2461\t// question and no lease, and it makes no coverage claim, so it needs none of this.\n2462\t\n2463\t/**\n2464\t * §7.5 — the message path's own idempotency record. Kept separate from\n2465\t * `AnswerAttemptRecord` rather than folded into it: a message has no question\n2466\t * and no lease, and inventing empty values for those would put fiction into the\n2467\t * audit trail the residual race (§11.7) depends on.\n2468\t */\n2469\texport interface MessageAttemptRecord {\n2470\t\trequestId: RequestId;\n2471\t\tterminalId: TerminalId;\n2472\t\tstartedAtMs: EpochMs;\n2473\t\tstatus: \"sent\" | \"unconfirmed\" | \"failed\";\n2474\t\tsentAtMs: EpochMs | null;\n2475\t}\n2476\t\n2477\texport interface MessageAttemptStore {\n2478\t\tget(requestId: RequestId): MessageAttemptRecord | null;\n2479\t\tput(record: MessageAttemptRecord): void;\n2480\t\tprune(nowMs: EpochMs): number;\n2481\t}\n2482\t\n2483\texport function createMessageAttemptStore(\n2484\t\toptions: { retentionMs?: DurationMs } = {},\n2485\t): MessageAttemptStore {\n2486\t\tconst retentionMs = options.retentionMs ?? ANSWER_ATTEMPT_RETENTION_MS;\n2487\t\tconst records = new Map<RequestId, MessageAttemptRecord>();\n2488\t\treturn {\n2489\t\t\tget(requestId) {\n2490\t\t\t\treturn records.get(requestId) ?? null;\n2491\t\t\t},\n2492\t\t\tput(record) {\n2493\t\t\t\trecords.set(record.requestId, record);\n2494\t\t\t},\n2495\t\t\tprune(nowMs) {\n2496\t\t\t\tlet dropped = 0;\n2497\t\t\t\tfor (const [requestId, record] of [...records]) {\n2498\t\t\t\t\tif (nowMs - record.startedAtMs <= retentionMs) continue;\n2499\t\t\t\t\trecords.delete(requestId);\n2500\t\t\t\t\tdropped += 1;\n2501\t\t\t\t}\n2502\t\t\t\treturn dropped;\n2503\t\t\t},\n2504\t\t};\n2505\t}\n2506\t\n2507\t// ---------------------------------------------------------------------------\n2508\t// POST /v1/answer\n2509\t// ---------------------------------------------------------------------------\n2510\t\n2511\t/**\n2512\t * Advances the durable claim and reads it back from the DB before reporting\n2513\t * success. A PTY acknowledgement proves where the bytes went; only this readback\n2514\t * proves the outcome survived. Callers downgrade landed bytes to `unconfirmed`\n2515\t * when this returns false, while the original `in_flight` claim remains a fence.\n2516\t */\n2517\tasync function recordOutcome(\n2518\t\tdeps: AnswerDeps,\n2519\t\trecord: AnswerAttemptRecord,\n2520\t): Promise<boolean> {\n2521\t\ttry {\n2522\t\t\tif (record.status === \"in_flight\") return true;\n2523\t\t\tdeps.ledger.recordOutcome({\n2524\t\t\t\trequestId: record.requestId,\n2525\t\t\t\tstatus: record.status,\n2526\t\t\t\tresolvedAtMs: record.resolvedAtMs,\n2527\t\t\t\tfailureCode: record.failureCode,\n2528\t\t\t\tguardsPassed: record.guardsPassed,\n2529\t\t\t\tleaseId: record.leaseId,\n2530\t\t\t});\n2531\t\t\tconst durable = deps.ledger.get(record.requestId);\n2532\t\t\tif (durable?.status !== record.status) {\n2533\t\t\t\tthrow new Error(\n2534\t\t\t\t\t`ledger outcome verification read ${durable?.status ?? \"missing\"}, expected ${record.status}`,\n2535\t\t\t\t);\n2536\t\t\t}\n2537\t\t\treturn true;\n2538\t\t} catch (error) {\n2539\t\t\tdeps.log({\n2540\t\t\t\tevent: \"companion.answer.attempt_persist_failed\",\n2541\t\t\t\trequestId: record.requestId,\n2542\t\t\t\tquestionId: record.questionId,\n2543\t\t\t\tstatus: record.status,\n2544\t\t\t\terror: error instanceof Error ? error.message : String(error),\n2545\t\t\t});\n2546\t\t\treturn false;\n2547\t\t}\n2548\t}\n2549\t\n2550\tasync function appendAnswerAudit(\n2551\t\tdeps: AnswerDeps,\n2552\t\tentry: AuditEntry,\n2553\t): Promise<void> {\n2554\t\ttry {\n2555\t\t\tawait deps.audit.append(entry);\n2556\t\t} catch (error) {\n2557\t\t\tdeps.log({\n2558\t\t\t\tevent: \"companion.answer.audit_persist_failed\",\n2559\t\t\t\trequestId: entry.requestId,\n2560\t\t\t\tquestionId: entry.questionId,\n2561\t\t\t\tterminalId: entry.terminalId,\n2562\t\t\t\toutcome: entry.outcome,\n2563\t\t\t\terror: error instanceof Error ? error.message : String(error),\n2564\t\t\t});\n2565\t\t}\n2566\t}\n2567\t\n2568\t// ---------------------------------------------------------------------------\n2569\t// the shared pre-lock preflight\n2570\t// ---------------------------------------------------------------------------\n2571\t\n2572\t/**\n2573\t * The ONLY agent kind either write path may type into.\n2574\t *\n2575\t * Both endpoints used to state this for themselves, so \"which agents are\n2576\t * writable\" was one policy living in two places: `handleAnswer` special-cased\n2577\t * `codex` and then rejected everything that was not `claude`, while\n2578\t * `handleMessage` rejected everything that was not `claude` with a different\n2579\t * code. Widening the bridge to a second agent had to be remembered twice, and\n2580\t * the failure of remembering is a write to an agent whose picker semantics the\n2581\t * byte contract in `keystrokes.ts` was never proven against.\n2582\t */\n2583\tconst WRITABLE_AGENT_KIND: AgentKind = \"claude\";\n2584\t\n2585\t/**\n2586\t * The binding half of the preflight, shared by both write paths: this terminal\n2587\t * carries an agent binding, and that agent is one the bridge may write to.\n2588\t *\n2589\t * Only the POLICY is shared. The refusal for a non-writable kind is supplied by\n2590\t * the caller, because the two endpoints mean genuinely different things by it —\n2591\t * an answer to a Codex picker is a capability this version does not have, while\n2592\t * a message to ANY non-Claude agent cannot be sent at all because the picker\n2593\t * store that gates the trailing `\\r` is structurally blind to it.\n2594\t *\n2595\t * Deliberately returns nothing. This helper belongs only to `/v1/message`;\n2596\t * `(ANSWER-GUARDLESS)` never re-reads mutable agent-binding state.\n2597\t */\n2598\tasync function assertWritableBinding(\n2599\t\tdeps: AnswerDeps,\n2600\t\tterminalId: TerminalId,\n2601\t\tnotWritable: (kind: AgentKind) => SealedError,\n2602\t): Promise<void> {\n2603\t\tconst binding = await deps.agentBinding(terminalId);\n2604\t\tif (binding === null || !binding.bound) {\n2605\t\t\tthrow sealed(412, \"guard_failed\", \"terminal has no agent binding\", {\n2606\t\t\t\tguard: \"no_agent_binding\",\n2607\t\t\t});\n2608\t\t}\n2609\t\tif (binding.kind !== WRITABLE_AGENT_KIND) throw notWritable(binding.kind);\n2610\t}\n2611\t\n2612\t/**\n2613\t * `/v1/message` resolves the requested opaque wire handle to a live\n2614\t * `(terminal, workspace)` pair. Both ids come back together — see\n2615\t * `AnswerDeps.resolveHostTerminal` for why resolving them separately once made\n2616\t * every message fail as `Terminal session not found`.\n2617\t */\n2618\tasync function requireHostTerminal(\n2619\t\tdeps: AnswerDeps,\n2620\t\tterminalId: TerminalId,\n2621\t): Promise<HostTerminalRef> {\n2622\t\tconst host = await deps.resolveHostTerminal(terminalId);\n2623\t\tif (host === null) {\n2624\t\t\tthrow sealed(\n2625\t\t\t\t503,\n2626\t\t\t\t\"internal\",\n2627\t\t\t\t\"the requested terminal is unavailable; no message bytes were written\",\n2628\t\t\t);\n2629\t\t}\n2630\t\treturn host;\n2631\t}\n2632\t\n2633\tfunction requirePendingAnswerQuestion(\n2634\t\tdeps: AnswerDeps,\n2635\t\trequest: Pick<AnswerRequest, \"questionId\" | \"fingerprint\">,\n2636\t): PendingQuestion {\n2637\t\tconst question = deps.questions.get(request.questionId);\n2638\t\tif (question === null) {\n2639\t\t\tthrow sealed(410, \"stale_question\", \"unknown question\");\n2640\t\t}\n2641\t\tif (question.state === \"resolved\") {\n2642\t\t\tthrow sealed(\n2643\t\t\t\t409,\n2644\t\t\t\t\"already_resolved\",\n2645\t\t\t\t\"this question was already answered\",\n2646\t\t\t\t{\n2647\t\t\t\t\tresolvedBy: question.resolvedBy,\n2648\t\t\t\t\tresolvedAtMs: question.resolvedAtMs,\n2649\t\t\t\t\toutcome: \"answered\",\n2650\t\t\t\t},\n2651\t\t\t);\n2652\t\t}\n2653\t\tif (question.state !== \"pending\") {\n2654\t\t\tthrow sealed(410, \"stale_question\", `question is ${question.state}`);\n2655\t\t}\n2656\t\tif (question.fingerprint !== request.fingerprint) {\n2657\t\t\tthrow sealed(\n2658\t\t\t\t410,\n2659\t\t\t\t\"stale_question\",\n2660\t\t\t\t\"fingerprint no longer matches; the question moved on\",\n2661\t\t\t);\n2662\t\t}\n2663\t\treturn question;\n2664\t}\n2665\t\n2666\tfunction requireCurrentPendingAnswerQuestion(\n2667\t\tdeps: AnswerDeps,\n2668\t\trequest: Pick<AnswerRequest, \"questionId\" | \"fingerprint\">,\n2669\t): PendingQuestion {\n2670\t\tconst question = requirePendingAnswerQuestion(deps, request);\n2671\t\tif (\n2672\t\t\tdeps.questions.byHostTerminal(question.hostTerminalId)?.questionId !==\n2673\t\t\tquestion.questionId\n2674\t\t) {\n2675\t\t\tthrow sealed(\n2676\t\t\t\t410,\n2677\t\t\t\t\"stale_question\",\n2678\t\t\t\t\"the captured question changed before the terminal write; nothing was written\",\n2679\t\t\t);\n2680\t\t}\n2681\t\treturn question;\n2682\t}\n2683\t\n2684\t/**\n2685\t * The whole write.\n2686\t *\n2687\t * Refusals are cheap and happen before anything is acquired; the lease and the\n2688\t * terminal lock are taken in that order, and the lease is released on every exit\n2689\t * path. Audit appends are attempted around the write but can never veto input or\n2690\t * replace its outcome.\n2691\t */\n2692\texport async function handleAnswer(\n2693\t\tdeps: AnswerDeps,\n2694\t\tctx: SealedRequestContext,\n2695\t\trequest: AnswerRequest,\n2696\t): Promise<AnswerResponse> {\n2697\t\t// Intake, before the ledger claim and every guard: a refused or fenced\n2698\t\t// answer must show an arrival line next to its refusal, not silence. Item\n2699\t\t// KINDS only — free-text bodies never reach a log."}]},"uuid":"e6b27a28-46cd-4e71-aa5e-3b608073b151","timestamp":"2026-08-10T22:42:26.149Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\khair\\Code Projects\\fork-superset-windows-arm64\\packages\\host-service\\src\\companion\\answer.ts","content":"\t\t\t\t\t),\n\t\t\t\t) as GuardEvaluation);\n\treturn { guardsPassed, guardsAbstained, evaluation };\n}\n\n/** A source that throws or answers `null` counts as FALSE. Never \"probably fine\". */\nasync function readGuardSource(\n\tname: AnswerGuardName,\n\tdeps: AnswerDeps,\n\tread: () => Promise<GuardSourceResult>,\n): Promise<boolean> {\n\ttry {\n\t\tconst value = await read();\n\t\tif (value === null) {\n\t\t\tdeps.log({\n\t\t\t\tevent: \"companion.guard.indeterminate\",\n\t\t\t\tguard: name,\n\t\t\t\tresult: false,\n\t\t\t});\n\t\t\treturn false;\n\t\t}\n\t\treturn value;\n\t} catch (error) {\n\t\tdeps.log({\n\t\t\tevent: \"companion.guard.error\",\n\t\t\tguard: name,\n\t\t\tresult: false,\n\t\t\terror: error instanceof Error ? error.message : String(error),\n\t\t});\n\t\treturn false;\n\t}\n}\n\n/**\n * The reader for a `veto_only` guard, which has DIFFERENT null semantics from\n * every other class and therefore cannot share `readGuardSource`.\n *\n * `GUARD_CLASSES` defines veto_only as \"Absence is a sound veto; presence is\n * never evidence\". Only an AFFIRMATIVE `false` — the source was read and the\n * thing is genuinely absent — may veto. `null` means the source could not be\n * read at all, which is not absence and therefore not a veto.\n *\n * Running a veto_only guard through `readGuardSource` collapses `null` to\n * `false` and turns it into a MANDATORY POSITIVE: with no marker reader wired,\n * guard 6 would fail 100% of answers with `guard_failed{askq_marker}` — a\n * refusal indistinguishable, to the client, from a question that went stale.\n * That is the fail-fast rule inverted: silent, and wrong in a way that looks\n * routine.\n */\nasync function readVetoGuardSource(\n\tname: AnswerGuardName,\n\tdeps: AnswerDeps,\n\tread: () => Promise<GuardSourceResult>,\n): Promise<boolean> {\n\ttry {\n\t\tconst value = await read();\n\t\tif (value === null) {\n\t\t\tdeps.log({\n\t\t\t\tevent: \"companion.guard.unreadable_no_veto\",\n\t\t\t\tguard: name,\n\t\t\t\tresult: true,\n\t\t\t});\n\t\t\treturn true;\n\t\t}\n\t\treturn value;\n\t} catch (error) {\n\t\t// A source that THREW is also \"could not read\", not \"absent\".\n\t\tdeps.log({\n\t\t\tevent: \"companion.guard.error\",\n\t\t\tguard: name,\n\t\t\tresult: true,\n\t\t\terror: error instanceof Error ? error.message : String(error),\n\t\t});\n\t\treturn true;\n\t}\n}\n\n/**\n * (GUARD4-ABSTAIN) The reader for a guard in `ABSTAINING_GUARDS`, which needs\n * the RAW tri-state rather than `readGuardSource`'s collapse to `false`.\n *\n * \"Could not read\" and \"read, and it is clear\" are the same outcome for such a\n * guard — neither refuses — but they are not the same DIAGNOSIS, and the abstain\n * event says which one happened. Collapsing them first would throw that away at\n * the only place it is cheap to keep.\n */\nasync function readAbstainingGuardSource(\n\tname: AnswerGuardName,\n\tdeps: AnswerDeps,\n\tread: () => Promise<GuardSourceResult>,\n): Promise<GuardSourceResult> {\n\ttry {\n\t\treturn await read();\n\t} catch (error) {\n\t\tdeps.log({\n\t\t\tevent: \"companion.guard.error\",\n\t\t\tguard: name,\n\t\t\tresult: null,\n\t\t\terror: error instanceof Error ? error.message : String(error),\n\t\t});\n\t\treturn null;\n\t}\n}\n\n/**\n * §11.3 — all six guards, evaluated inside the caller's critical section.\n *\n * Order is load-bearing FIRST and short-circuiting. That is the mechanism by\n * which a forgeable source can never appear on a permitting path: if guard 1 or\n * guard 5 fails, the forgeable sources are not even read.\n *\n * `screen` is passed in rather than fetched, so the caller can prove the same\n * snapshot backed the decision and the write.\n */\nexport async function evaluateGuards(\n\tdeps: AnswerDeps,\n\tinput: {\n\t\tquestion: PendingQuestion;\n\t\tscreen: string;\n\t\texpectation: ScreenExpectation;\n\t\trequireOptionIndex: number | null;\n\t},\n): Promise<GuardOutcome> {\n\tconst evaluation: GuardEvaluation = {\n\t\ttranscript: false,\n\t\tscreen: false,\n\t\tbinding: false,\n\t\tpermission_axis: false,\n\t\tsession: false,\n\t\taskq_marker: false,\n\t};\n\tconst passed: AnswerGuardName[] = [];\n\t/** (GUARD4-ABSTAIN) Guards carried on a non-positive reading. */\n\tconst abstained: AnswerGuardName[] = [];\n\t/**\n\t * Every step through the stack is checked against `GUARD_EVALUATION_ORDER`, so\n\t * the classification's ordering rule is enforced against what this function\n\t * ACTUALLY does rather than against the shape of the source below.\n\t *\n\t * (GUARD4-ABSTAIN) The position is its OWN counter and no longer\n\t * `passed.length`. An abstaining guard advances the stack without joining\n\t * `passed` — it did not pass, and `guardsPassed` is the durable audit answer\n\t * to \"what permitted this write\" — so deriving position from that array would\n\t * throw the self-check off by one for every guard after it.\n\t */\n\tlet position = 0;\n\tconst at = (guard: AnswerGuardName): void => {\n\t\tif (GUARD_EVALUATION_ORDER[position] !== guard) {\n\t\t\tthrow new Error(\n\t\t\t\t`(COMPANION-BRIDGE) guard stack self-check: reached ${guard} at position ${position}, where GUARD_EVALUATION_ORDER requires ${String(GUARD_EVALUATION_ORDER[position])}`,\n\t\t\t);\n\t\t}\n\t};\n\tconst advance = (guard: AnswerGuardName): void => {\n\t\tat(guard);\n\t\tposition += 1;\n\t\tpassed.push(guard);\n\t};\n\t/**\n\t * (GUARD4-ABSTAIN) Walk past a guard WITHOUT recording it as passed. The two\n\t * arrays are disjoint by construction, so a durable row can never say a guard\n\t * both permitted the write and read false.\n\t */\n\tconst abstain = (guard: AnswerGuardName): void => {\n\t\tat(guard);\n\t\tposition += 1;\n\t\tabstained.push(guard);\n\t};\n\tconst fail = (\n\t\tguard: AnswerGuardName,\n\t\tscreenMatch: PickerScreenMatch | null,\n\t) => {\n\t\tat(guard);\n\t\treturn {\n\t\t\tevaluation,\n\t\t\tpassed,\n\t\t\tabstained,\n\t\t\tfailed: guard,\n\t\t\tscreenMatch,\n\t\t} satisfies GuardOutcome;\n\t};\n\n\t// --- guard 1: the tool call has not already been answered (LOAD-BEARING) ---\n\tconst alreadyAnswered = await readGuardSource(\n\t\t\"transcript\",\n\t\tdeps,\n\t\tasync () => {\n\t\t\tconst exists = await deps.toolResultExists({\n\t\t\t\tterminalId: input.question.terminalId,\n\t\t\t\tsessionId: input.question.sessionId,\n\t\t\t\ttoolUseId: input.question.toolUseId,\n\t\t\t});\n\t\t\t// An unreadable transcript is `null` -> false -> guard fails. Inverting\n\t\t\t// here would turn \"cannot check\" into \"no result yet\", which is the\n\t\t\t// exact mistake this stack exists to avoid.\n\t\t\treturn exists === null ? null : !exists;\n\t\t},\n\t);\n\tevaluation.transcript = alreadyAnswered;\n\tif (!alreadyAnswered) return fail(\"transcript\", null);\n\tadvance(\"transcript\");\n\n\t// --- guard 5: the picker is on screen showing THIS question (LOAD-BEARING) ---\n\tconst screenMatch = evaluateScreenGuard({\n\t\tscreen: input.screen,\n\t\tquestion: input.question,\n\t\texpectation: input.expectation,\n\t\trequireOptionIndex: input.requireOptionIndex,\n\t});\n\tevaluation.screen = screenMatch.ok;\n\tif (!screenMatch.ok) return fail(\"screen\", screenMatch);\n\tadvance(\"screen\");\n\n\t// Everything below is either forgeable or merely supporting. It can only\n\t// REFUSE from here; the two guards that can permit have already passed.\n\n\t// --- guard 3: the session is alive (supporting) ---\n\tconst sessionOk = await readGuardSource(\"session\", deps, () =>\n\t\tdeps.sessionActive(input.question.terminalId),\n\t);\n\tevaluation.session = sessionOk;\n\tif (!sessionOk) return fail(\"session\", screenMatch);\n\tadvance(\"session\");\n\n\t// --- guard 2: the agent<->session binding still matches (FORGEABLE) ---\n\tconst bindingOk = await readGuardSource(\"binding\", deps, async () => {\n\t\tconst binding = await deps.agentBinding(input.question.terminalId);\n\t\tif (binding === null) return null;\n\t\tif (!binding.bound) return false;\n\t\tif (binding.kind !== \"claude\") return false;\n\t\t// A /resume or a restart mints a new agent session; the captured question\n\t\t// belongs to the old one and its tool_use_id can no longer be answered.\n\t\tif (binding.agentSessionId === null) return null;\n\t\treturn binding.agentSessionId === input.question.sessionId;\n\t});\n\tevaluation.binding = bindingOk;\n\tif (!bindingOk) return fail(\"binding\", screenMatch);\n\tadvance(\"binding\");\n\n\t// --- guard 4: the permission axis is still latched (FORGEABLE, ABSTAINS) ---\n\tconst permissionAxis = await readAbstainingGuardSource(\n\t\t\"permission_axis\",\n\t\tdeps,\n\t\t() => deps.permissionAxisLatched(input.question.terminalId),\n\t);\n\t// The RAW reading, never written up to `true`. The ledger's `guards` column is\n\t// evidence about what was observed, and an abstain must not be able to forge a\n\t// record of a latch that was not there.\n\tevaluation.permission_axis = permissionAxis === true;\n\tif (permissionAxis === true) {\n\t\tadvance(\"permission_axis\");\n\t} else {\n\t\t// (GUARD4-ABSTAIN) TWO conditions, both checked here rather than inferred\n\t\t// from the fact that guard 4 runs fourth:\n\t\t//\n\t\t//  1. every load-bearing guard actually passed, read back off `evaluation`,\n\t\t//     so a reordering makes the axis refuse again rather than quietly\n\t\t//     abstain on a stack that has proved less than it claims;\n\t\t//  2. this guard is on the abstain list, which `assertGuardClassification`\n\t\t//     holds to its own rules at module load.\n\t\t//\n\t\t// There is deliberately NO expectation-form condition. The axis used to\n\t\t// keep its refusal on weak `same_prompt` keystrokes (the free-text tail) to\n\t\t// catch a desk Escape mid-sequence — but the latch is overwritten by ANY\n\t\t// later hook event, so on a busy terminal it reads clear while the picker\n\t\t// is verifiably still up, and it vetoed 2/2 legitimate free-text answers\n\t\t// mid-write, aborting between the editor-open digit and the submit and\n\t\t// leaving a half-open editor behind. A forgeable latch whose false-veto\n\t\t// aborts a proven sequence partway is strictly worse than completing the\n\t\t// proven sequence: the write window is sub-second, the per-keystroke\n\t\t// load-bearing guards (transcript + screen) still run before every byte,\n\t\t// and the operator has one seat. The axis is evidence in the ledger now,\n\t\t// never a veto.\n\t\tconst loadBearingPassed = LOAD_BEARING_GUARDS.every(\n\t\t\t(guard) => evaluation[guard],\n\t\t);\n\t\tif (!loadBearingPassed || !ABSTAINING_GUARDS.includes(\"permission_axis\")) {\n\t\t\treturn fail(\"permission_axis\", screenMatch);\n\t\t}\n\t\tdeps.log({\n\t\t\tevent: \"companion.guard.abstain\",\n\t\t\tguard: \"permission_axis\",\n\t\t\tguardClass: GUARD_CLASSES.permission_axis,\n\t\t\t// The two readings an abstain covers, kept apart: a latch the next hook\n\t\t\t// event overwrote, versus a store this process could not read at all.\n\t\t\treading: permissionAxis === null ? \"unreadable\" : \"clear\",\n\t\t\tloadBearing: [...LOAD_BEARING_GUARDS],\n\t\t\texpectation: input.expectation.kind,\n\t\t\tquestionId: input.question.questionId,\n\t\t\tterminalId: input.question.terminalId,\n\t\t});\n\t\tabstain(\"permission_axis\");\n\t}\n\n\t// --- guard 6: the .askq marker still exists (VETO ONLY) ---\n\t// Presence is NOT evidence — markers leak. Only its absence is used, and only\n\t// to refuse. An unreadable marker directory also refuses.\n\tconst markerPresent = await readVetoGuardSource(\"askq_marker\", deps, () =>\n\t\tdeps.askqMarkerExists({\n\t\t\tterminalId: input.question.terminalId,\n\t\t\tagentId: input.question.agentId,\n\t\t\tagentType: input.question.agentType,\n\t\t}),\n\t);\n\tevaluation.askq_marker = markerPresent;\n\tif (!markerPresent) return fail(\"askq_marker\", screenMatch);\n\tadvance(\"askq_marker\");\n\n\treturn { evaluation, passed, abstained, failed: null, screenMatch };\n}\n\n// ---------------------------------------------------------------------------\n// errors\n// ---------------------------------------------------------------------------\n\n/** The sealed codes this module is allowed to emit. A closed set, per §10. */\ntype SealedCode =\n\t| \"stale_question\"\n\t| \"already_resolved\"\n\t| \"lease_held\"\n\t| \"guard_failed\"\n\t| \"picker_open\"\n\t| \"capability_unsupported\"\n\t/** (ANSWER-LEDGER) The fence. See where it is thrown for why not `already_resolved`. */\n\t| \"request_closed\"\n\t| \"write_disabled\"\n\t| \"bad_request\"\n\t| \"internal\";\n\nfunction sealed(\n\tstatusCode: number,\n\tcode: SealedCode,\n\tmessage: string,\n\tdetail: Record<string, unknown> | null = null,\n): SealedError {\n\treturn new SealedError(statusCode, {\n\t\tcode,\n\t\tmessage,\n\t\tretryAfterMs: null,\n\t\tdetail,\n\t});\n}\n\n/**\n * Maps a pure encoding failure. Every one of these provably wrote nothing: the\n * encoder runs before the lock is taken and touches no terminal.\n */\nfunction sealedFromEncoding(error: KeystrokeEncodingError): SealedError {\n\tif (error.reason === \"shape_unproven\") {\n\t\treturn sealed(\n\t\t\t501,\n\t\t\t\"capability_unsupported\",\n\t\t\t\"this prompt shape has no proven byte sequence and is refused rather than guessed; answer it at the desk\",\n\t\t\t{ capability: \"answer.multiselect\", reason: error.reason },\n\t\t);\n\t}\n\treturn sealed(400, \"bad_request\", error.message, { reason: error.reason });\n}\n\n// ---------------------------------------------------------------------------\n// idempotency\n// ---------------------------------------------------------------------------\n//\n// (ANSWER-LEDGER) The ~900-line JSON attempt store that used to live here — its\n// `answer-attempts.json`, its rise-only witness, its quarantine and degrade\n// paths, its PRUNE-FLOOR and STORE-CLOSED guards — is gone. `attempt-ledger.ts`\n// replaced it with a table and a transaction.\n//\n// It was not deleted for being untidy. It could not close the race it existed to\n// describe: a status read can overtake an admitted answer, and deciding between\n// them needs an atomic compare-and-set that a read-modify-rewrite of a file\n// cannot provide. Every mechanism above was in service of DETECTING that the file\n// had rolled back, which was a true and useless thing to know.\n//\n// Two accepted weaknesses went with it. Its durability rested on an undocumented\n// inference about NTFS rename ordering (see `writeFileDurable`); SQLite's is\n// documented, and asserted at FULL. And it validated the file as a WHOLE, so one\n// incoherent record quarantined every other record's 24 hours — rows validate\n// individually now, so a corrupt row costs exactly one requestId its status.\n//\n// The message path keeps its own small in-memory store below: a message has no\n// question and no lease, and it makes no coverage claim, so it needs none of this.\n\n/**\n * §7.5 — the message path's own idempotency record. Kept separate from\n * `AnswerAttemptRecord` rather than folded into it: a message has no question\n * and no lease, and inventing empty values for those would put fiction into the\n * audit trail the residual race (§11.7) depends on.\n */\nexport interface MessageAttemptRecord {\n\trequestId: RequestId;\n\tterminalId: TerminalId;\n\tstartedAtMs: EpochMs;\n\tstatus: \"sent\" | \"unconfirmed\" | \"failed\";\n\tsentAtMs: EpochMs | null;\n}\n\nexport interface MessageAttemptStore {\n\tget(requestId: RequestId): MessageAttemptRecord | null;\n\tput(record: MessageAttemptRecord): void;\n\tprune(nowMs: EpochMs): number;\n}\n\nexport function createMessageAttemptStore(\n\toptions: { retentionMs?: DurationMs } = {},\n): MessageAttemptStore {\n\tconst retentionMs = options.retentionMs ?? ANSWER_ATTEMPT_RETENTION_MS;\n\tconst records = new Map<RequestId, MessageAttemptRecord>();\n\treturn {\n\t\tget(requestId) {\n\t\t\treturn records.get(requestId) ?? null;\n\t\t},\n\t\tput(record) {\n\t\t\trecords.set(record.requestId, record);\n\t\t},\n\t\tprune(nowMs) {\n\t\t\tlet dropped = 0;\n\t\t\tfor (const [requestId, record] of [...records]) {\n\t\t\t\tif (nowMs - record.startedAtMs <= retentionMs) continue;\n\t\t\t\trecords.delete(requestId);\n\t\t\t\tdropped += 1;\n\t\t\t}\n\t\t\treturn dropped;\n\t\t},\n\t};\n}\n\n// ---------------------------------------------------------------------------\n// POST /v1/answer\n// ---------------------------------------------------------------------------\n\n/**\n * Advances the durable claim and reads it back from the DB before reporting\n * success. A PTY acknowledgement proves where the bytes went; only this readback\n * proves the outcome survived. Callers downgrade landed bytes to `unconfirmed`\n * when this returns false, while the original `in_flight` claim remains a fence.\n */\nasync function recordOutcome(\n\tdeps: AnswerDeps,\n\trecord: AnswerAttemptRecord,\n): Promise<boolean> {\n\ttry {\n\t\tif (record.status === \"in_flight\") return true;\n\t\tdeps.ledger.recordOutcome({\n\t\t\trequestId: record.requestId,\n\t\t\tstatus: record.status,\n\t\t\tresolvedAtMs: record.resolvedAtMs,\n\t\t\tfailureCode: record.failureCode,\n\t\t\tguardsPassed: record.guardsPassed,\n\t\t\tleaseId: record.leaseId,\n\t\t});\n\t\tconst durable = deps.ledger.get(record.requestId);\n\t\tif (durable?.status !== record.status) {\n\t\t\tthrow new Error(\n\t\t\t\t`ledger outcome verification read ${durable?.status ?? \"missing\"}, expected ${record.status}`,\n\t\t\t);\n\t\t}\n\t\treturn true;\n\t} catch (error) {\n\t\tdeps.log({\n\t\t\tevent: \"companion.answer.attempt_persist_failed\",\n\t\t\trequestId: record.requestId,\n\t\t\tquestionId: record.questionId,\n\t\t\tstatus: record.status,\n\t\t\terror: error instanceof Error ? error.message : String(error),\n\t\t});\n\t\treturn false;\n\t}\n}\n\nasync function appendAnswerAudit(\n\tdeps: AnswerDeps,\n\tentry: AuditEntry,\n): Promise<void> {\n\ttry {\n\t\tawait deps.audit.append(entry);\n\t} catch (error) {\n\t\tdeps.log({\n\t\t\tevent: \"companion.answer.audit_persist_failed\",\n\t\t\trequestId: entry.requestId,\n\t\t\tquestionId: entry.questionId,\n\t\t\tterminalId: entry.terminalId,\n\t\t\toutcome: entry.outcome,\n\t\t\terror: error instanceof Error ? error.message : String(error),\n\t\t});\n\t}\n}\n\n// ---------------------------------------------------------------------------\n// the shared pre-lock preflight\n// ---------------------------------------------------------------------------\n\n/**\n * The ONLY agent kind either write path may type into.\n *\n * Both endpoints used to state this for themselves, so \"which agents are\n * writable\" was one policy living in two places: `handleAnswer` special-cased\n * `codex` and then rejected everything that was not `claude`, while\n * `handleMessage` rejected everything that was not `claude` with a different\n * code. Widening the bridge to a second agent had to be remembered twice, and\n * the failure of remembering is a write to an agent whose picker semantics the\n * byte contract in `keystrokes.ts` was never proven against.\n */\nconst WRITABLE_AGENT_KIND: AgentKind = \"claude\";\n\n/**\n * The binding half of the preflight, shared by both write paths: this terminal\n * carries an agent binding, and that agent is one the bridge may write to.\n *\n * Only the POLICY is shared. The refusal for a non-writable kind is supplied by\n * the caller, because the two endpoints mean genuinely different things by it —\n * an answer to a Codex picker is a capability this version does not have, while\n * a message to ANY non-Claude agent cannot be sent at all because the picker\n * store that gates the trailing `\\r` is structurally blind to it.\n *\n * Deliberately returns nothing. This helper belongs only to `/v1/message`;\n * `(ANSWER-GUARDLESS)` never re-reads mutable agent-binding state.\n */\nasync function assertWritableBinding(\n\tdeps: AnswerDeps,\n\tterminalId: TerminalId,\n\tnotWritable: (kind: AgentKind) => SealedError,\n): Promise<void> {\n\tconst binding = await deps.agentBinding(terminalId);\n\tif (binding === null || !binding.bound) {\n\t\tthrow sealed(412, \"guard_failed\", \"terminal has no agent binding\", {\n\t\t\tguard: \"no_agent_binding\",\n\t\t});\n\t}\n\tif (binding.kind !== WRITABLE_AGENT_KIND) throw notWritable(binding.kind);\n}\n\n/**\n * `/v1/message` resolves the requested opaque wire handle to a live\n * `(terminal, workspace)` pair. Both ids come back together — see\n * `AnswerDeps.resolveHostTerminal` for why resolving them separately once made\n * every message fail as `Terminal session not found`.\n */\nasync function requireHostTerminal(\n\tdeps: AnswerDeps,\n\tterminalId: TerminalId,\n): Promise<HostTerminalRef> {\n\tconst host = await deps.resolveHostTerminal(terminalId);\n\tif (host === null) {\n\t\tthrow sealed(\n\t\t\t503,\n\t\t\t\"internal\",\n\t\t\t\"the requested terminal is unavailable; no message bytes were written\",\n\t\t);\n\t}\n\treturn host;\n}\n\nfunction requirePendingAnswerQuestion(\n\tdeps: AnswerDeps,\n\trequest: Pick<AnswerRequest, \"questionId\" | \"fingerprint\">,\n): PendingQuestion {\n\tconst question = deps.questions.get(request.questionId);\n\tif (question === null) {\n\t\tthrow sealed(410, \"stale_question\", \"unknown question\");\n\t}\n\tif (question.state === \"resolved\") {\n\t\tthrow sealed(\n\t\t\t409,\n\t\t\t\"already_resolved\",\n\t\t\t\"this question was already answered\",\n\t\t\t{\n\t\t\t\tresolvedBy: question.resolvedBy,\n\t\t\t\tresolvedAtMs: question.resolvedAtMs,\n\t\t\t\toutcome: \"answered\",\n\t\t\t},\n\t\t);\n\t}\n\tif (question.state !== \"pending\") {\n\t\tthrow sealed(410, \"stale_question\", `question is ${question.state}`);\n\t}\n\tif (question.fingerprint !== request.fingerprint) {\n\t\tthrow sealed(\n\t\t\t410,\n\t\t\t\"stale_question\",\n\t\t\t\"fingerprint no longer matches; the question moved on\",\n\t\t);\n\t}\n\treturn question;\n}\n\nfunction requireCurrentPendingAnswerQuestion(\n\tdeps: AnswerDeps,\n\trequest: Pick<AnswerRequest, \"questionId\" | \"fingerprint\">,\n): PendingQuestion {\n\tconst question = requirePendingAnswerQuestion(deps, request);\n\tif (\n\t\tdeps.questions.byHostTerminal(question.hostTerminalId)?.questionId !==\n\t\tquestion.questionId\n\t) {\n\t\tthrow sealed(\n\t\t\t410,\n\t\t\t\"stale_question\",\n\t\t\t\"the captured question changed before the terminal write; nothing was written\",\n\t\t);\n\t}\n\treturn question;\n}\n\n/**\n * The whole write.\n *\n * Refusals are cheap and happen before anything is acquired; the lease and the\n * terminal lock are taken in that order, and the lease is released on every exit\n * path. Audit appends are attempted around the write but can never veto input or\n * replace its outcome.\n */\nexport async function handleAnswer(\n\tdeps: AnswerDeps,\n\tctx: SealedRequestContext,\n\trequest: AnswerRequest,\n): Promise<AnswerResponse> {\n\t// Intake, before the ledger claim and every guard: a refused or fenced\n\t// answer must show an arrival line next to its refusal, not silence. Item\n\t// KINDS only — free-text bodies never reach a log.","numLines":620,"startLine":2080,"totalLines":4259}},"sourceToolAssistantUUID":"8bce639b-b59b-418e-bd26-55659bf1920a","session_id":"41b65f55-7b51-4cfd-82d1-d1d1eec49d91","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\khair\\Code Projects\\fork-superset-windows-arm64","sessionId":"41b65f55-7b51-4cfd-82d1-d1d1eec49d91","version":"2.1.226","gitBranch":"main","slug":"jolly-singing-lemur"}
