\t\t\t\toutcome: \"unconfirmed\",\n  1322\t\t\t\t\tfailureCode: null,\n  1323\t\t\t\t});\n  1324\t\t\t\tthrow error;\n  1325\t\t\t} finally {\n  1326\t\t\t\t// Released on confirmed, on guard_failed, on unconfirmed and on any\n  1327\t\t\t\t// unexpected throw. A lease that outlives its answer would lock the\n  1328\t\t\t\t// question out until its TTL lapsed.\n  1329\t\t\t\tdeps.leases.release(lease.leaseId);\n  1330\t\t\t}\n  1331\t\t} catch (error) {\n  1332\t\t\t// A row still `in_flight` here means the throw got past every path that\n  1333\t\t\t// records its own outcome, so this is the last chance to stop it claiming\n  1334\t\t\t// forever that keystrokes are landing.\n  1335\t\t\t//\n  1336\t\t\t// A SealedError is a REFUSAL with a known reason, recorded verbatim so §11.4's\n  1337\t\t\t// replay can say why. Anything else is a fault of unknown extent — it could\n  1338\t\t\t// have escaped after bytes moved — so it degrades to `unconfirmed` rather than\n  1339\t\t\t// to a `failed` that would assert nothing was typed.\n  1340\t\t\tconst durableStatus = deps.ledger.get(request.requestId)?.status;\n  1341\t\t\tif (durableStatus === \"claimed\" || durableStatus === \"in_flight\") {\n  1342\t\t\t\tdeps.ledger.recordOutcome({\n  1343\t\t\t\t\trequestId: request.requestId,\n  1344\t\t\t\t\t...(error instanceof SealedError\n  1345\t\t\t\t\t\t? {\n  1346\t\t\t\t\t\t\t\tstatus: \"failed\" as const,\n  1347\t\t\t\t\t\t\t\tfailureCode: error.body.code as AttemptFailureCode,\n  1348\t\t\t\t\t\t\t}\n  1349\t\t\t\t\t\t: { status: \"unconfirmed\" as const, failureCode: null }),\n  1350\t\t\t\t\tresolvedAtMs: null,\n  1351\t\t\t\t\tguardsPassed: [],\n  1352\t\t\t\t\tleaseId: null,\n  1353\t\t\t\t});\n  1354\t\t\t}\n  1355\t\t\tthrow error;\n  1356\t\t}\n  1357\t}\n  1358\t\n  1359\t// ---------------------------------------------------------------------------\n  1360\t// the critical section\n  1361\t// ---------------------------------------------------------------------