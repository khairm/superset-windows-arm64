n93\t} from \"./http\";\n94\timport {\n95\t\tcreateKeyStore,\n96\t\tcreateSendNonceSource,\n97\t\ttype KeyStore,\n98\t\topenStateAnchor,\n99\t\ttype SendNonceSource,\n100\t\ttype StateAnchor,"}]},"uuid":"a0a0c672-71d5-4322-ac18-771732c61f18","timestamp":"2026-08-10T22:43:50.894Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\khair\\Code Projects\\fork-superset-windows-arm64\\packages\\host-service\\src\\companion\\index.ts","content":"/**\n * (COMPANION-BRIDGE) — composition root for the companion bridge.\n *\n * Wires the sealed HTTP listener, the read-only event stream, the pairing\n * window, the question store, the answer path, push and the audit log, and hands\n * host-service a single start/stop handle.\n *\n * Contract with the rest of host-service:\n *  - it runs IN-PROCESS with the pty writer, because exact-current-question\n *    arbitration and injection must share one terminal critical section (§11.3);\n *  - it fails loud on a taken port, a missing secret, or an unreadable device\n *    store — the companion feature is then reported unavailable in the desktop\n *    UI rather than silently degraded;\n *  - it never blocks the main thread on fs (nonce cache, audit log) — the\n *    renderer's `superset-app://` loader starves and the window stays blank.\n *\n * This module owns WIRING AND LIFECYCLE ONLY. Every behaviour lives in a sibling\n * module. Where a source of truth genuinely does not exist yet, an observational\n * adapter reports `null` or throws with the exact remedy — it NEVER fabricates a\n * value that would make a tree look healthy. Answer injection does not use those\n * observations as eligibility gates.\n */\n\nimport { access } from \"node:fs/promises\";\nimport { createServer as createNetServer } from \"node:net\";\nimport { homedir } from \"node:os\";\nimport { join } from \"node:path\";\nimport hostServicePackageJson from \"@superset/host-service/package.json\" with {\n\ttype: \"json\",\n};\nimport Database from \"better-sqlite3\";\nimport { drizzle } from \"drizzle-orm/better-sqlite3\";\nimport type { HostDb } from \"../db\";\nimport * as hostDbSchema from \"../db/schema\";\nimport { getDaemonClient } from \"../terminal/daemon-client-singleton\";\nimport {\n\tisLiveTerminalSession,\n\tprepareAcknowledgedInputSession,\n\tsnapshotSession,\n\twriteAcknowledgedInputToSession,\n\twriteFramedInputToSession,\n} from \"../terminal/terminal\";\nimport type { TerminalAgentStore } from \"../terminal-agents\";\nimport {\n\tgetCompanionQuestionSink,\n\tsetCompanionQuestionSink,\n} from \"../trpc/router/notifications\";\nimport { createAccessValidator } from \"./access-jwt\";\nimport { resolveAgentKind } from \"./agent-kind\";\nimport {\n\ttype AnswerDeps,\n\tassertAnswerDeps,\n\tcreateMessageAttemptStore,\n\ttype GuardSourceResult,\n\ttype HostTerminalRef,\n\thandleAnswer,\n\thandleAnswerStatus,\n\thandleMessage,\n\ttype MessageAttemptStore,\n\ttype TerminalAgentInfo,\n} from \"./answer\";\nimport { type AttemptLedger, createAttemptLedger } from \"./attempt-ledger\";\nimport { type AuditLog, createAuditLog, hashJsonPayload } from \"./audit\";\nimport {\n\tBRIDGE_CAPABILITIES,\n\tBRIDGE_HOST,\n\tBRIDGE_PORT,\n\ttype CompanionPaths,\n\tCURATION_RECHECK_MS,\n\tensureCompanionDirs,\n\tisCompanionBridgeEnabled,\n\tLOG_PREFIX,\n\tloadAccessServiceToken,\n\tloadFcmServiceAccountMeta,\n\tNONCE_CACHE_COMPACT_INTERVAL_MS,\n\tPUSH_QUESTION_EXPIRY_MS,\n\tresolveCompanionPaths,\n} from \"./config\";\nimport {\n\tassertDurableSqlite,\n\tcreateReplayCache,\n\ttype ReplayCache,\n\tsleep,\n} from \"./crypto\";\nimport { createDeviceStore, type DeviceStore } from \"./device-store\";\nimport {\n\ttype BridgeHttpServer,\n\ttype BridgeLogger,\n\tcreateBridgeHttpServer,\n\ttype FreeTextAuthorizationPolicy,\n\tROUTE_GATED_CAPABILITIES,\n\ttype SealedHandlers,\n} from \"./http\";\nimport {\n\tcreateKeyStore,\n\tcreateSendNonceSource,\n\ttype KeyStore,\n\topenStateAnchor,\n\ttype SendNonceSource,\n\ttype StateAnchor,","numLines":100,"startLine":1,"totalLines":2653}},"sourceToolAssistantUUID":"1bc82872-045d-4362-845c-634728062830","session_id":"41b65f55-7b51-4cfd-82d1-d1d1eec49d91","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\khair\\Code Projects\\fork-superset-windows-arm64","sessionId":"41b65f55-7b51-4cfd-82d1-d1d1eec49d91","version":"2.1.226","gitBranch":"main","slug":"jolly-singing-lemur"}
{"parentUuid":"c0c97517-fdb6-4601-8755-c56ffe092655","isSidechain":false,"promptId":"0a8de032-5fd3-4106-bcf4-797ed6a2efc2","type":"user","message":{"role":"user","content":[{"tool_use_id":"call_anfevNYm4LwlflIMAy21daBN","type":"tool_result","content":"1\t/**\n2\t * (COMPANION-BRIDGE) — answer injection and idempotency (§11).\n3\t *\n4\t * (ANSWER-GUARDLESS) A pending, captured Claude question is directly answerable\n5\t * from a paired phone or watch. After the request boundary validates question\n6\t * identity and answer shape, `encodeAnswer` produces the proven byte sequence and\n7\t * `injectSequence` writes it to the captured terminal under the per-terminal lock.\n8\t * No transcript, screen, renderer, Windows interactive-session, agent-binding,\n9\t * permission-latch or marker observation may veto or downgrade that write.\n10\t *\n11\t * The lock, answer-wide lease and durable request ledger remain: they prevent two\n12\t * devices from interleaving bytes and make retries idempotent. Each PTY write is\n13\t * counted only after the daemon acknowledges `pty.write`, and the response is\n14\t * confirmed only after the ledger outcome is written and read back. An actual PTY\n15\t * failure prevents confirmation; a ledger failure after landed bytes returns an\n16\t * honest, duplicate-fenced `unconfirmed` outcome.\n17\t *\n18\t * Legacy guard-analysis helpers remain temporarily for historical tests. They\n19\t * have no production caller; answer attempts record empty guard arrays and\n20\t * `null` evaluation for persisted audit-schema compatibility.\n21\t */\n22\t\n23\timport type {\n24\t\tAttemptLedger,\n25\t\tLedgerRecord,\n26\t\tStatusOutcome,\n27\t} from \"./attempt-ledger\";\n28\timport { type AuditLog, hashJsonPayload } from \"./audit\";\n29\timport { ANSWER_ATTEMPT_RETENTION_MS } from \"./config\";\n30\timport type { AcknowledgedInputFailureKind } from \"../terminal/DaemonClient\";\n31\timport { sleep } from \"./crypto\";\n32\timport {\n33\t\tcreateRawPtyWriter,\n34\t\tencodeAnswer,\n35\t\tfindForbiddenControlChar,\n36\t\tfindUnpairedSurrogate,\n37\t\ttype Keystroke,\n38\t\tKeystrokeEncodingError,\n39\t\tMESSAGE_ALLOWED_C0,\n40\t\tprovenMultiSelectFreeTextDetectLabels,\n41\t\ttype RawPtyWriter,\n42\t\ttype RawWriteFn,\n43\t\ttype RawWriteResult,\n44\t\ttype ScreenExpectation,\n45\t} from \"./keystrokes\";\n46\timport {\n47\t\ttype LeaseRegistry,\n48\t\ttype TerminalLockRegistry,\n49\t\tTerminalLockTimeoutError,\n50\t} from \"./lease\";\n51\timport type { PendingQuestion, QuestionStore } from \"./question-store\";\n52\timport {\n53\t\ttype AgentKind,\n54\t\ttype AnswerAttemptRecord,\n55\t\ttype AnswerGuardName,\n56\t\ttype AnswerRequest,\n57\t\ttype AnswerResponse,\n58\t\ttype AnswerStatusOutcome,\n59\t\ttype AnswerStatusRequest,\n60\t\ttype AnswerStatusResponse,\n61\t\ttype AttemptFailureCode,\n62\t\ttype AuditEntry,\n63\t\ttype DurationMs,\n64\t\ttype EpochMs,\n65\t\ttype GuardEvaluation,\n66\t\ttype MessageRequest,\n67\t\ttype MessageResponse,\n68\t\ttype QuestionId,\n69\t\ttype QuestionItem,\n70\t\ttype QuestionOption,\n71\t\ttype RequestId,\n72\t\tSealedError,\n73\t\ttype SealedRequestContext,\n74\t\ttype TerminalId,\n75\t} from \"./types\";\n76\t\n77\t// ---------------------------------------------------------------------------\n78\t// tunables (bridge-internal; none of these are on the wire)\n79\t// ---------------------------------------------------------------------------\n80\t\n81\t/**\n82\t * How long a request will wait for the per-terminal lock. On expiry NOTHING has\n83\t * been written — the critical section never ran — and the client is told so.\n84\t */\n85\texport const LOCK_WAIT_TIMEOUT_MS = 5_000;\n86\t\n87\t/** Poll interval while waiting for the emulator mirror to reflect our last byte. */\n88\texport const SCREEN_ADVANCE_POLL_MS = 25;\n89\t\n90\t/**\n91\t * Hard ceiling on one keystroke sequence. Bounds how long the terminal lock can\n92\t * be held, and keeps the sequence inside the answer lease's TTL.\n93\t */\n94\texport const SEQUENCE_DEADLINE_MS = 10_000;\n95\t\n96\t/** PROTOCOL §7.5 — a message body is 1..8 192 chars. */\n97\texport const MESSAGE_MAX_CHARS = 8_192;\n98\t\n99\t/**\n100\t * (MESSAGE-ECHO) How long `/v1/message` waits for the composer to render the\n101\t * text it just pasted, before it will write the trailing submit.\n102\t *\n103\t * A paste of up to 8 192 chars can require a substantial repaint. The wait is\n104\t * bounded because the\n105\t * terminal lock is held throughout.\n106\t */\n107\texport const MESSAGE_ECHO_TIMEOUT_MS = 2_000;\n108\t\n109\t/**\n110\t * (MESSAGE-ECHO) Squashed characters of the message used as the on-screen\n111\t * anchor. Long enough that matching it by chance is implausible, short enough to\n112\t * survive the composer hard-wrapping.\n113\t */\n114\texport const MESSAGE_ECHO_ANCHOR_CHARS = 24;\n115\t\n116\t/**\n117\t * (MESSAGE-ECHO) The FLOOR on that anchor. Below it the echo proves nothing and\n118\t * the submit is withheld.\n119\t *\n120\t * `MESSAGE_ECHO_ANCHOR_CHARS` is a ceiling — `slice(0, 24)` of a three-character\n121\t * message is the whole three characters. With no floor the check collapsed to\n122\t * \"does this short string occur anywhere in a band on screen\", and the needle is\n123\t * the CLIENT's own text, so it is attacker-parameterisable in exactly the way\n124\t * guard 5's capture-derived anchors were. Measured against the real\n125\t * `handleMessage` path with an inert paste (the picker case): the text \"yes\"\n126\t * matched a picker's own option label \"Yes, proceed…\" and the text \"1\" matched\n127\t * the picker's own row number — both returned `sent` and wrote the trailing\n128\t * `\\r` into an open picker.\n129\t *\n130\t * Same value and same reasoning as `SCREEN_MIN_ANCHOR_CHARS` (guard 5's remedy\n131\t * for the identical class), kept as its own name because the two paths are free\n132\t * to diverge.\n133\t */\n134\texport const MESSAGE_ECHO_MIN_ANCHOR_CHARS = 8;\n135\t\n136\t/**\n137\t * (MESSAGE-ECHO) Ceiling on how tall the echo search band may grow.\n138\t *\n139\t * The band tracks the message's own line count so a multi-line message can be\n140\t * found where it is rendered, but it is capped: without a cap a message made of\n141\t * many one-character lines would widen the search to \"anywhere in the viewport\",\n142\t * which is the property the banding exists to deny.\n143\t */\n144\texport const MESSAGE_ECHO_MAX_WINDOW_LINES = 16;\n145\t\n146\t// ---------------------------------------------------------------------------\n147\t// guard classification — enforced, not documentation\n148\t// ---------------------------------------------------------------------------\n149\t\n150\texport type GuardClass =\n151\t\t/** Outside the unauthenticated hook's reach. Only these may permit a write. */\n152\t\t| \"load_bearing\"\n153\t\t/** Fed by `notifications.hook`. May refuse; may never permit. */\n154\t\t| \"forgeable\"\n155\t\t/** Absence is a sound veto; presence is never evidence. */\n156\t\t| \"veto_only\"\n157\t\t/** Neither forgeable nor sufficient — a sanity condition. */\n158\t\t| \"supporting\";\n159\t\n160\texport const GUARD_CLASSES: Readonly<Record<AnswerGuardName, GuardClass>> = {\n161\t\ttranscript: \"load_bearing\",\n162\t\tscreen: \"load_bearing\",\n163\t\tbinding: \"forgeable\",\n164\t\tpermission_axis: \"forgeable\",\n165\t\tsession: \"supporting\",\n166\t\taskq_marker: \"veto_only\",\n167\t};\n168\t\n169\t/**\n170\t * (GUARD4-ABSTAIN) Forgeable guards that ABSTAIN rather than refuse once every\n171\t * load-bearing guard has passed.\n172\t *\n173\t * \"May refuse; may never permit\" is the right rule for a forgeable source in\n174\t * general, and it stays the rule for `binding` — which proves the captured\n175\t * question belongs to the agent session currently on the terminal, something\n176\t * neither the transcript nor the screen says anything about.\n177\t *\n178\t * `permission_axis` is different in two ways that together make its refusal\n179\t * worth less than the honest answers it was costing:\n180\t *\n181\t *   - IT ADDS NOTHING. The axis is `lastEventType === PermissionRequest` — \"a\n182\t *     permission request is the most recent thing this terminal reported\". By\n183\t *     the time it is read, guard 1 has proved the tool call is still unanswered\n184\t *     in the agent's own transcript and guard 5 has proved THIS question's\n185\t *     picker is on screen right now with the pressed row where the capture says\n186\t *     it is. Those two prove a pending permission request more directly than a\n187\t *     single latched enum ever did.\n188\t *   - IT IS A LATCH, AND ITS REFUSAL IS ITSELF FORGEABLE. Any later hook event\n189\t *     overwrites `lastEventType`, so an ordinary race between capture and answer\n190\t *     clears it and the wire code for that is indistinguishable from staleness.\n191\t *     And the same unauthenticated localhost hook that could forge the axis to\n192\t *     `true` can clear it to `false` — so leaving it able to refuse hands an\n193\t *     attacker a denial primitive while giving the defence nothing, which is the\n194\t *     wrong side of every trade in this file.\n195\t *\n196\t * The abstain is CONDITIONAL and the condition is checked, not assumed: it\n197\t * applies only when every guard in `LOAD_BEARING_GUARDS` has actually passed.\n198\t * The evaluation order already guarantees that at the point guard 4 runs, but a\n199\t * reordering must break the build's behaviour loudly rather than silently widen\n200\t * this, so the condition is evaluated from `evaluation` rather than inferred\n201\t * from position.\n202\t */\n203\texport const ABSTAINING_GUARDS: readonly AnswerGuardName[] = [\n204\t\t\"permission_axis\",\n205\t];\n206\t\n207\texport const LOAD_BEARING_GUARDS: readonly AnswerGuardName[] = (\n208\t\tObject.keys(GUARD_CLASSES) as AnswerGuardName[]\n209\t).filter((name) => GUARD_CLASSES[name] === \"load_bearing\");\n210\t\n211\t/**\n212\t * The order `evaluateGuards` MUST run the stack in, as data rather than as a\n213\t * hand-written sequence of statements.\n214\t *\n215\t * The classification above is only worth anything if the ordering it implies is\n216\t * mechanical. It was not: `assertGuardClassification` used to check nothing but\n217\t * \"at least one load-bearing guard exists\", while the header claimed a forgeable\n218\t * guard \"can never contribute to a permission\" and named that function as what\n219\t * kept it honest. The ordering happened to be correct; nothing made it stay\n220\t * correct, and a future guard classified `forgeable` and inserted early — the\n221\t * natural thing to do if it is cheap — would have been consulted on a path that\n222\t * permits, which is precisely what the classification exists to deny.\n223\t *\n224\t * Now: this array is asserted at module load to place every `load_bearing` guard\n225\t * ahead of every other class, and `evaluateGuards` asserts that it walks the\n226\t * stack in exactly this order, so drift is a crash rather than a silent\n227\t * weakening.\n228\t */\n229\texport const GUARD_EVALUATION_ORDER: readonly AnswerGuardName[] = [\n230\t\t\"transcript\",\n231\t\t\"screen\",\n232\t\t\"session\",\n233\t\t\"binding\",\n234\t\t\"permission_axis\",\n235\t\t\"askq_marker\",\n236\t];\n237\t\n238\t/**\n239\t * Run at module load. A guard added to `AnswerGuardName` without a class here is\n240\t * a compile error; a stack with no load-bearing guard at all, one that\n241\t * `GUARD_EVALUATION_ORDER` does not cover exactly, or an order that consults a\n242\t * forgeable guard before a load-bearing one is a startup crash. All of them beat\n243\t * discovering it after an answer landed on the wrong screen.\n244\t */\n245\tfunction assertGuardClassification(): void {\n246\t\tif (LOAD_BEARING_GUARDS.length === 0) {\n247\t\t\tthrow new Error(\n248\t\t\t\t\"(COMPANION-BRIDGE) the answer guard stack has no load-bearing guard; refusing to load\",\n249\t\t\t);\n250\t\t}\n251\t\tconst classified = Object.keys(GUARD_CLASSES) as AnswerGuardName[];\n252\t\tconst ordered = new Set(GUARD_EVALUATION_ORDER);\n253\t\tif (ordered.size !== GUARD_EVALUATION_ORDER.length) {\n254\t\t\tthrow new Error(\n255\t\t\t\t\"(COMPANION-BRIDGE) GUARD_EVALUATION_ORDER lists a guard twice; refusing to load\",\n256\t\t\t);\n257\t\t}\n258\t\tfor (const name of classified) {\n259\t\t\tif (!ordered.has(name)) {\n260\t\t\t\tthrow new Error(\n261\t\t\t\t\t`(COMPANION-BRIDGE) guard ${name} is classified but never evaluated; refusing to load`,\n262\t\t\t\t);\n263\t\t\t}\n264\t\t}\n265\t\tfor (const name of GUARD_EVALUATION_ORDER) {\n266\t\t\tif (!classified.includes(name)) {\n267\t\t\t\tthrow new Error(\n268\t\t\t\t\t`(COMPANION-BRIDGE) guard ${name} is evaluated but not classified; refusing to load`,\n269\t\t\t\t);\n270\t\t\t}\n271\t\t}\n272\t\tlet seenNonLoadBearing: AnswerGuardName | null = null;\n273\t\tfor (const name of GUARD_EVALUATION_ORDER) {\n274\t\t\tif (GUARD_CLASSES[name] === \"load_bearing\") {\n275\t\t\t\tif (seenNonLoadBearing !== null) {\n276\t\t\t\t\tthrow new Error(\n277\t\t\t\t\t\t`(COMPANION-BRIDGE) load-bearing guard ${name} is evaluated after ${seenNonLoadBearing} (${GUARD_CLASSES[seenNonLoadBearing]}); a guard that may never permit must not be consulted before one that does. Refusing to load`,\n278\t\t\t\t\t);\n279\t\t\t\t}\n280\t\t\t\tcontinue;\n281\t\t\t}\n282\t\t\tseenNonLoadBearing = name;\n283\t\t}\n284\t\t// (GUARD4-ABSTAIN) The abstain list was inert: it was a name the branch below\n285\t\t// happened to check against, with nothing stopping a guard being added to it\n286\t\t// that is load-bearing, or that runs BEFORE the guards whose passing is the\n287\t\t// entire premise of abstaining. Both are now startup crashes, so the list\n288\t\t// carries the weight the abstain branch gives it.\n289\t\tconst lastLoadBearing = Math.max(\n290\t\t\t...LOAD_BEARING_GUARDS.map((name) => GUARD_EVALUATION_ORDER.indexOf(name)),\n291\t\t);\n292\t\tfor (const name of ABSTAINING_GUARDS) {\n293\t\t\tif (GUARD_CLASSES[name] !== \"forgeable\") {\n294\t\t\t\tthrow new Error(\n295\t\t\t\t\t`(COMPANION-BRIDGE) guard ${name} may abstain but is classified ${GUARD_CLASSES[name]}; only a forgeable guard — one whose refusal is as forgeable as its permission would be — may abstain. Refusing to load`,\n296\t\t\t\t);\n297\t\t\t}\n298\t\t\tconst position = GUARD_EVALUATION_ORDER.indexOf(name);\n299\t\t\tif (position < 0) {\n300\t\t\t\tthrow new Error(\n301\t\t\t\t\t`(COMPANION-BRIDGE) guard ${name} may abstain but is never evaluated; refusing to load`,\n302\t\t\t\t);\n303\t\t\t}\n304\t\t\tif (position < lastLoadBearing) {\n305\t\t\t\tthrow new Error(\n306\t\t\t\t\t`(COMPANION-BRIDGE) guard ${name} may abstain but is evaluated at position ${position}, before the load-bearing guard at ${lastLoadBearing}; abstaining is only sound once every load-bearing guard has PASSED. Refusing to load`,\n307\t\t\t\t);\n308\t\t\t}\n309\t\t}\n310\t}\n311\tassertGuardClassification();\n312\t\n313\t// ---------------------------------------------------------------------------\n314\t// dependencies\n315\t// ---------------------------------------------------------------------------\n316\t\n317\t/** What a guard source reports. `null` means \"could not determine\" and fails closed. */\n318\texport type GuardSourceResult = boolean | null;\n319\t\n320\texport interface TerminalAgentInfo {\n321\t\tkind: AgentKind;\n322\t\t/** false => a plain shell. NEVER writable. */\n323\t\tbound: boolean;\n324\t\t/** The agent session this terminal is currently bound to, if known. */\n325\t\tagentSessionId: string | null;\n326\t}\n327\t\n328\t/**\n329\t * The host.db ids behind an opaque wire handle. These — and ONLY these — are\n330\t * what the pty writer accepts; the wire handle is a truncated SHA-256 and is"}]},"uuid":"4e063a48-dff1-44b8-bc8b-d551404e9bf0","timestamp":"2026-08-10T22:43:50.999Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\khair\\Code Projects\\fork-superset-windows-arm64\\packages\\host-service\\src\\companion\\answer.ts","content":"/**\n * (COMPANION-BRIDGE) — answer injection and idempotency (§11).\n *\n * (ANSWER-GUARDLESS) A pending, captured Claude question is directly answerable\n * from a paired phone or watch. After the request boundary validates question\n * identity and answer shape, `encodeAnswer` produces the proven byte sequence and\n * `injectSequence` writes it to the captured terminal under the per-terminal lock.\n * No transcript, screen, renderer, Windows interactive-session, agent-binding,\n * permission-latch or marker observation may veto or downgrade that write.\n *\n * The lock, answer-wide lease and durable request ledger remain: they prevent two\n * devices from interleaving bytes and make retries idempotent. Each PTY write is\n * counted only after the daemon acknowledges `pty.write`, and the response is\n * confirmed only after the ledger outcome is written and read back. An actual PTY\n * failure prevents confirmation; a ledger failure after landed bytes returns an\n * honest, duplicate-fenced `unconfirmed` outcome.\n *\n * Legacy guard-analysis helpers remain temporarily for historical tests. They\n * have no production caller; answer attempts record empty guard arrays and\n * `null` evaluation for persisted audit-schema compatibility.\n */\n\nimport type {\n\tAttemptLedger,\n\tLedgerRecord,\n\tStatusOutcome,\n} from \"./attempt-ledger\";\nimport { type AuditLog, hashJsonPayload } from \"./audit\";\nimport { ANSWER_ATTEMPT_RETENTION_MS } from \"./config\";\nimport type { AcknowledgedInputFailureKind } from \"../terminal/DaemonClient\";\nimport { sleep } from \"./crypto\";\nimport {\n\tcreateRawPtyWriter,\n\tencodeAnswer,\n\tfindForbiddenControlChar,\n\tfindUnpairedSurrogate,\n\ttype Keystroke,\n\tKeystrokeEncodingError,\n\tMESSAGE_ALLOWED_C0,\n\tprovenMultiSelectFreeTextDetectLabels,\n\ttype RawPtyWriter,\n\ttype RawWriteFn,\n\ttype RawWriteResult,\n\ttype ScreenExpectation,\n} from \"./keystrokes\";\nimport {\n\ttype LeaseRegistry,\n\ttype TerminalLockRegistry,\n\tTerminalLockTimeoutError,\n} from \"./lease\";\nimport type { PendingQuestion, QuestionStore } from \"./question-store\";\nimport {\n\ttype AgentKind,\n\ttype AnswerAttemptRecord,\n\ttype AnswerGuardName,\n\ttype AnswerRequest,\n\ttype AnswerResponse,\n\ttype AnswerStatusOutcome,\n\ttype AnswerStatusRequest,\n\ttype AnswerStatusResponse,\n\ttype AttemptFailureCode,\n\ttype AuditEntry,\n\ttype DurationMs,\n\ttype EpochMs,\n\ttype GuardEvaluation,\n\ttype MessageRequest,\n\ttype MessageResponse,\n\ttype QuestionId,\n\ttype QuestionItem,\n\ttype QuestionOption,\n\ttype RequestId,\n\tSealedError,\n\ttype SealedRequestContext,\n\ttype TerminalId,\n} from \"./types\";\n\n// ---------------------------------------------------------------------------\n// tunables (bridge-internal; none of these are on the wire)\n// ---------------------------------------------------------------------------\n\n/**\n * How long a request will wait for the per-terminal lock. On expiry NOTHING has\n * been written — the critical section never ran — and the client is told so.\n */\nexport const LOCK_WAIT_TIMEOUT_MS = 5_000;\n\n/** Poll interval while waiting for the emulator mirror to reflect our last byte. */\nexport const SCREEN_ADVANCE_POLL_MS = 25;\n\n/**\n * Hard ceiling on one keystroke sequence. Bounds how long the terminal lock can\n * be held, and keeps the sequence inside the answer lease's TTL.\n */\nexport const SEQUENCE_DEADLINE_MS = 10_000;\n\n/** PROTOCOL §7.5 — a message body is 1..8 192 chars. */\nexport const MESSAGE_MAX_CHARS = 8_192;\n\n/**\n * (MESSAGE-ECHO) How long `/v1/message` waits for the composer to render the\n * text it just pasted, before it will write the trailing submit.\n *\n * A paste of up to 8 192 chars can require a substantial repaint. The wait is\n * bounded because the\n * terminal lock is held throughout.\n */\nexport const MESSAGE_ECHO_TIMEOUT_MS = 2_000;\n\n/**\n * (MESSAGE-ECHO) Squashed characters of the message used as the on-screen\n * anchor. Long enough that matching it by chance is implausible, short enough to\n * survive the composer hard-wrapping.\n */\nexport const MESSAGE_ECHO_ANCHOR_CHARS = 24;\n\n/**\n * (MESSAGE-ECHO) The FLOOR on that anchor. Below it the echo proves nothing and\n * the submit is withheld.\n *\n * `MESSAGE_ECHO_ANCHOR_CHARS` is a ceiling — `slice(0, 24)` of a three-character\n * message is the whole three characters. With no floor the check collapsed to\n * \"does this short string occur anywhere in a band on screen\", and the needle is\n * the CLIENT's own text, so it is attacker-parameterisable in exactly the way\n * guard 5's capture-derived anchors were. Measured against the real\n * `handleMessage` path with an inert paste (the picker case): the text \"yes\"\n * matched a picker's own option label \"Yes, proceed…\" and the text \"1\" matched\n * the picker's own row number — both returned `sent` and wrote the trailing\n * `\\r` into an open picker.\n *\n * Same value and same reasoning as `SCREEN_MIN_ANCHOR_CHARS` (guard 5's remedy\n * for the identical class), kept as its own name because the two paths are free\n * to diverge.\n */\nexport const MESSAGE_ECHO_MIN_ANCHOR_CHARS = 8;\n\n/**\n * (MESSAGE-ECHO) Ceiling on how tall the echo search band may grow.\n *\n * The band tracks the message's own line count so a multi-line message can be\n * found where it is rendered, but it is capped: without a cap a message made of\n * many one-character lines would widen the search to \"anywhere in the viewport\",\n * which is the property the banding exists to deny.\n */\nexport const MESSAGE_ECHO_MAX_WINDOW_LINES = 16;\n\n// ---------------------------------------------------------------------------\n// guard classification — enforced, not documentation\n// ---------------------------------------------------------------------------\n\nexport type GuardClass =\n\t/** Outside the unauthenticated hook's reach. Only these may permit a write. */\n\t| \"load_bearing\"\n\t/** Fed by `notifications.hook`. May refuse; may never permit. */\n\t| \"forgeable\"\n\t/** Absence is a sound veto; presence is never evidence. */\n\t| \"veto_only\"\n\t/** Neither forgeable nor sufficient — a sanity condition. */\n\t| \"supporting\";\n\nexport const GUARD_CLASSES: Readonly<Record<AnswerGuardName, GuardClass>> = {\n\ttranscript: \"load_bearing\",\n\tscreen: \"load_bearing\",\n\tbinding: \"forgeable\",\n\tpermission_axis: \"forgeable\",\n\tsession: \"supporting\",\n\taskq_marker: \"veto_only\",\n};\n\n/**\n * (GUARD4-ABSTAIN) Forgeable guards that ABSTAIN rather than refuse once every\n * load-bearing guard has passed.\n *\n * \"May refuse; may never permit\" is the right rule for a forgeable source in\n * general, and it stays the rule for `binding` — which proves the captured\n * question belongs to the agent session currently on the terminal, something\n * neither the transcript nor the screen says anything about.\n *\n * `permission_axis` is different in two ways that together make its refusal\n * worth less than the honest answers it was costing:\n *\n *   - IT ADDS NOTHING. The axis is `lastEventType === PermissionRequest` — \"a\n *     permission request is the most recent thing this terminal reported\". By\n *     the time it is read, guard 1 has proved the tool call is still unanswered\n *     in the agent's own transcript and guard 5 has proved THIS question's\n *     picker is on screen right now with the pressed row where the capture says\n *     it is. Those two prove a pending permission request more directly than a\n *     single latched enum ever did.\n *   - IT IS A LATCH, AND ITS REFUSAL IS ITSELF FORGEABLE. Any later hook event\n *     overwrites `lastEventType`, so an ordinary race between capture and answer\n *     clears it and the wire code for that is indistinguishable from staleness.\n *     And the same unauthenticated localhost hook that could forge the axis to\n *     `true` can clear it to `false` — so leaving it able to refuse hands an\n *     attacker a denial primitive while giving the defence nothing, which is the\n *     wrong side of every trade in this file.\n *\n * The abstain is CONDITIONAL and the condition is checked, not assumed: it\n * applies only when every guard in `LOAD_BEARING_GUARDS` has actually passed.\n * The evaluation order already guarantees that at the point guard 4 runs, but a\n * reordering must break the build's behaviour loudly rather than silently widen\n * this, so the condition is evaluated from `evaluation` rather than inferred\n * from position.\n */\nexport const ABSTAINING_GUARDS: readonly AnswerGuardName[] = [\n\t\"permission_axis\",\n];\n\nexport const LOAD_BEARING_GUARDS: readonly AnswerGuardName[] = (\n\tObject.keys(GUARD_CLASSES) as AnswerGuardName[]\n).filter((name) => GUARD_CLASSES[name] === \"load_bearing\");\n\n/**\n * The order `evaluateGuards` MUST run the stack in, as data rather than as a\n * hand-written sequence of statements.\n *\n * The classification above is only worth anything if the ordering it implies is\n * mechanical. It was not: `assertGuardClassification` used to check nothing but\n * \"at least one load-bearing guard exists\", while the header claimed a forgeable\n * guard \"can never contribute to a permission\" and named that function as what\n * kept it honest. The ordering happened to be correct; nothing made it stay\n * correct, and a future guard classified `forgeable` and inserted early — the\n * natural thing to do if it is cheap — would have been consulted on a path that\n * permits, which is precisely what the classification exists to deny.\n *\n * Now: this array is asserted at module load to place every `load_bearing` guard\n * ahead of every other class, and `evaluateGuards` asserts that it walks the\n * stack in exactly this order, so drift is a crash rather than a silent\n * weakening.\n */\nexport const GUARD_EVALUATION_ORDER: readonly AnswerGuardName[] = [\n\t\"transcript\",\n\t\"screen\",\n\t\"session\",\n\t\"binding\",\n\t\"permission_axis\",\n\t\"askq_marker\",\n];\n\n/**\n * Run at module load. A guard added to `AnswerGuardName` without a class here is\n * a compile error; a stack with no load-bearing guard at all, one that\n * `GUARD_EVALUATION_ORDER` does not cover exactly, or an order that consults a\n * forgeable guard before a load-bearing one is a startup crash. All of them beat\n * discovering it after an answer landed on the wrong screen.\n */\nfunction assertGuardClassification(): void {\n\tif (LOAD_BEARING_GUARDS.length === 0) {\n\t\tthrow new Error(\n\t\t\t\"(COMPANION-BRIDGE) the answer guard stack has no load-bearing guard; refusing to load\",\n\t\t);\n\t}\n\tconst classified = Object.keys(GUARD_CLASSES) as AnswerGuardName[];\n\tconst ordered = new Set(GUARD_EVALUATION_ORDER);\n\tif (ordered.size !== GUARD_EVALUATION_ORDER.length) {\n\t\tthrow new Error(\n\t\t\t\"(COMPANION-BRIDGE) GUARD_EVALUATION_ORDER lists a guard twice; refusing to load\",\n\t\t);\n\t}\n\tfor (const name of classified) {\n\t\tif (!ordered.has(name)) {\n\t\t\tthrow new Error(\n\t\t\t\t`(COMPANION-BRIDGE) guard ${name} is classified but never evaluated; refusing to load`,\n\t\t\t);\n\t\t}\n\t}\n\tfor (const name of GUARD_EVALUATION_ORDER) {\n\t\tif (!classified.includes(name)) {\n\t\t\tthrow new Error(\n\t\t\t\t`(COMPANION-BRIDGE) guard ${name} is evaluated but not classified; refusing to load`,\n\t\t\t);\n\t\t}\n\t}\n\tlet seenNonLoadBearing: AnswerGuardName | null = null;\n\tfor (const name of GUARD_EVALUATION_ORDER) {\n\t\tif (GUARD_CLASSES[name] === \"load_bearing\") {\n\t\t\tif (seenNonLoadBearing !== null) {\n\t\t\t\tthrow new Error(\n\t\t\t\t\t`(COMPANION-BRIDGE) load-bearing guard ${name} is evaluated after ${seenNonLoadBearing} (${GUARD_CLASSES[seenNonLoadBearing]}); a guard that may never permit must not be consulted before one that does. Refusing to load`,\n\t\t\t\t);\n\t\t\t}\n\t\t\tcontinue;\n\t\t}\n\t\tseenNonLoadBearing = name;\n\t}\n\t// (GUARD4-ABSTAIN) The abstain list was inert: it was a name the branch below\n\t// happened to check against, with nothing stopping a guard being added to it\n\t// that is load-bearing, or that runs BEFORE the guards whose passing is the\n\t// entire premise of abstaining. Both are now startup crashes, so the list\n\t// carries the weight the abstain branch gives it.\n\tconst lastLoadBearing = Math.max(\n\t\t...LOAD_BEARING_GUARDS.map((name) => GUARD_EVALUATION_ORDER.indexOf(name)),\n\t);\n\tfor (const name of ABSTAINING_GUARDS) {\n\t\tif (GUARD_CLASSES[name] !== \"forgeable\") {\n\t\t\tthrow new Error(\n\t\t\t\t`(COMPANION-BRIDGE) guard ${name} may abstain but is classified ${GUARD_CLASSES[name]}; only a forgeable guard — one whose refusal is as forgeable as its permission would be — may abstain. Refusing to load`,\n\t\t\t);\n\t\t}\n\t\tconst position = GUARD_EVALUATION_ORDER.indexOf(name);\n\t\tif (position < 0) {\n\t\t\tthrow new Error(\n\t\t\t\t`(COMPANION-BRIDGE) guard ${name} may abstain but is never evaluated; refusing to load`,\n\t\t\t);\n\t\t}\n\t\tif (position < lastLoadBearing) {\n\t\t\tthrow new Error(\n\t\t\t\t`(COMPANION-BRIDGE) guard ${name} may abstain but is evaluated at position ${position}, before the load-bearing guard at ${lastLoadBearing}; abstaining is only sound once every load-bearing guard has PASSED. Refusing to load`,\n\t\t\t);\n\t\t}\n\t}\n}\nassertGuardClassification();\n\n// ---------------------------------------------------------------------------\n// dependencies\n// ---------------------------------------------------------------------------\n\n/** What a guard source reports. `null` means \"could not determine\" and fails closed. */\nexport type GuardSourceResult = boolean | null;\n\nexport interface TerminalAgentInfo {\n\tkind: AgentKind;\n\t/** false => a plain shell. NEVER writable. */\n\tbound: boolean;\n\t/** The agent session this terminal is currently bound to, if known. */\n\tagentSessionId: string | null;\n}\n\n/**\n * The host.db ids behind an opaque wire handle. These — and ONLY these — are\n * what the pty writer accepts; the wire handle is a truncated SHA-256 and is","numLines":330,"startLine":1,"totalLines":4259}},"sourceToolAssistantUUID":"c0c97517-fdb6-4601-8755-c56ffe092655","session_id":"41b65f55-7b51-4cfd-82d1-d1d1eec49d91","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\khair\\Code Projects\\fork-superset-windows-arm64","sessionId":"41b65f55-7b51-4cfd-82d1-d1d1eec49d91","version":"2.1.226","gitBranch":"main","slug":"jolly-singing-lemur"}
