answer into composer\n1097\t\t\t\t\t\t// text or an answer to the replacement picker. This is question identity,\n1098\t\t\t\t\t\t// not screen/transcript/session evidence.\n1099\t\t\t\t\t\trequireCurrentPendingAnswerQuestion(deps, request);\n1100\t\t\t\t\t\treturn injectSequence(deps, {\n1101\t\t\t\t\t\t\tquestion,\n1102\t\t\t\t\t\t\thost,\n1103\t\t\t\t\t\t\tkeystrokes,\n1104\t\t\t\t\t\t\tleaseId: lease.leaseId,\n1105\t\t\t\t\t\t\tacknowledgedInputSupported: prepared.acknowledgedInputSupported,\n1106\t\t\t\t\t\t\twriter,\n1107\t\t\t\t\t\t});\n1108\t\t\t\t\t},\n1109\t\t\t\t);\n1110\t\n1111\t\t\t\tif (result.kind === \"confirmed\") {\n1112\t\t\t\t\tconst resolvedAtMs = deps.now();\n1113\t\t\t\t\tconst record: AnswerAttemptRecord = {\n1114\t\t\t\t\t\t...baseAttempt,\n1115\t\t\t\t\t\tstatus: \"confirmed\",\n1116\t\t\t\t\t\tresolvedAtMs,\n1117\t\t\t\t\t\tfailureCode: null,\n1118\t\t\t\t\t\tguardsPassed: [],\n1119\t\t\t\t\t\tguardsAbstained: [],\n1120\t\t\t\t\t};\n1121\t\t\t\t\tif (!(await recordOutcome(deps, record))) {\n1122\t\t\t\t\t\tconst unconfirmed: AnswerAttemptRecord = {\n1123\t\t\t\t\t\t\t...record,\n1124\t\t\t\t\t\t\tstatus: \"unconfirmed\",\n1125\t\t\t\t\t\t\tresolvedAtMs: null,\n1126\t\t\t\t\t\t};\n1127\t\t\t\t\t\tdeps.log({\n1128\t\t\t\t\t\t\tevent: \"companion.answer.confirmed_downgraded_not_durable\",\n1129\t\t\t\t\t\t\tquestionId: request.questionId,\n1130\t\t\t\t\t\t\tterminalId: question.terminalId,\n1131\t\t\t\t\t\t\trequestId: request.requestId,\n1132\t\t\t\t\t\t});\n1133\t\t\t\t\t\t// A transient first failure may still allow this downgrade to commit. If\n1134\t\t\t\t\t\t// it does not, the original durable in-flight claim remains the fence.\n1135\t\t\t\t\t\tawait recordOutcome(deps, unconfirmed);\n1136\t\t\t\t\t\tawait appendAnswerAudit(deps, {\n1137\t\t\t\t\t\t\t...baseAudit,\n1138\t\t\t\t\t\t\ttsMs: resolvedAtMs,\n1139\t\t\t\t\t\t\tguards: null,\n1140\t\t\t\t\t\t\tguardsAbstained: [],\n1141\t\t\t\t\t\t\toutcome: \"unconfirmed\",\n1142\t\t\t\t\t\t