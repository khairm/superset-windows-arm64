eId, workspaceId),\n2278:\t\t\t\teq(terminalSessions.originWorkspaceId, workspaceId),\n2314:\tterminalId: string;\n2315:\tworkspaceId: string;\n2359:\tterminalId,\n2363:\tterminalId: string;\n2371:\treturn `Terminal session \"${terminalId}\" belongs to workspace \"${ownerWorkspaceId}\", not \"${requestedWorkspaceId}\".`;\n2375:\tterminalId,\n2376:\tworkspaceId,\n2391:\tconst existing = sessions.get(terminalId);\n2394:\t\t\tterminalId,\n2395:\t\t\townerWorkspaceId: existing.workspaceId,\n2396:\t\t\trequestedWorkspaceId: workspaceId,\n2406:\t\t.findFirst({ where: eq(terminalSessions.id, terminalId) })\n2409:\t\tterminalId,\n2411:\t\trequestedWorkspaceId: workspaceId,\n2417:\t// resolution and `getOrAdoptSession`), checked here on the row we already\n2426:\t\t\t\tterminalId,\n2427:\t\t\t\tworkspaceId,\n2432:\t\t\terror: `Terminal session \"${terminalId}\" is being disposed.`,\n2437:\t\t.findFirst({ where: eq(workspaces.id, workspaceId) })\n2490:\t\tterminalId,\n2491:\t\tworkspaceId,\n2508:\t\t\t\t(s) => s.id === terminalId && s.alive,\n2512:\t\t\t\t\terror: `Terminal session \"${terminalId}\" is not active; create it before connecting.`,\n2520:\t\t\t\t`[terminal] adopted existing daemon session ${terminalId} pid=${found.pid}`,\n2524:\t\t\t\topenResult = await daemon.open(terminalId, {\n2541:\t\t\t\t\tconst found = list.find((s) => s.id === terminalId && s.alive);\n2558:\t\t\t\t\t\t\twhere: eq(terminalSessions.id, terminalId),\n2566:\t\t\t\t\t\t\t\tterminalId,\n2567:\t\t\t\t\t\t\t\tworkspaceId,\n2579:\t\t\t\t\t\t\terror: `Terminal session \"${terminalId}\" is being disposed.`,\n2596:\t\t\t\t\t\t`[terminal] adopted existing daemon session ${terminalId} pid=${found.pid}`,\n2627:\t\tpty = makeDaemonPty(daemon, terminalId, openResult.pid);\n2631:\t\t\t\tid: terminalId,\n2632:\t\t\t\toriginWorkspaceId: workspaceId,\n2639:\t\t\t\t\toriginWorkspaceId: workspaceId,\n2663:\t\t\t{ terminalId, workspaceId, isAdopted, error },\n2676:\t\t\t\tconst closeResult = await closeDaemonSess