\n594-\tconst retentionMs = options.retentionMs ?? ANSWER_ATTEMPT_RETENTION_MS;\n595-\tconst records = new Map<RequestId, MessageAttemptRecord>();\n596-\treturn {\n597-\t\tget(requestId) {\n--\n606-\t\t\t\tif (nowMs - record.startedAtMs <= retentionMs) continue;\n607-\t\t\t\trecords.delete(requestId);\n608-\t\t\t\tdropped += 1;\n609-\t\t\t}\n610-\t\t\treturn dropped;\n611-\t\t},\n612-\t};\n613-}\n614-\n615-// ---------------------------------------------------------------------------\n616-// POST /v1/answer\n617-// ---------------------------------------------------------------------------\n618-\n619-/**\n620- * Advances the durable claim and reads it back from the DB before reporting\n621- * success. A PTY acknowledgement proves where the bytes went; only this readback\n622: * proves the outcome survived. Callers downgrade landed bytes to `unconfirmed`\n623- * when this returns false, while the original `in_flight` claim remains a fence.\n624- */\n625-async function recordOutcome(\n626-\tdeps: AnswerDeps,\n627-\trecord: AnswerAttemptRecord,\n628-): Promise<boolean> {\n629-\ttry {\n630-\t\tif (record.status === \"in_flight\") return true;\n631-\t\tdeps.ledger.recordOutcome({\n632-\t\t\trequestId: record.requestId,\n633-\t\t\tstatus: record.status,\n634-\t\t\tresolvedAtMs: record.resolvedAtMs,\n635-\t\t\tfailureCode: record.failureCode,\n636-\t\t\tguardsPassed: record.guardsPassed,\n637-\t\t\tleaseId: record.leaseId,\n638-\t\t});\n--\n763-\t}\n764-\tif (question.fingerprint !== request.fingerprint) {\n765-\t\tthrow sealed(\n766-\t\t\t410,\n767-\t\t\t\"stale_question\",\n768-\t\t\t\"fingerprint no longer matches; the question moved on\",\n769-\t\t);\n770-\t}\n771-\treturn question;\n772-}\n773-\n774-function requireCurrentPendingAnswerQuestion(\n775-\tdeps: AnswerDeps,\n776-\trequest: Pick<AnswerRequest, \"questionId\" | \"fingerprint\" | \"requestId\">,\n777-): PendingQuestion {\n778-\tconst question = requirePendingAnswerQuestion(deps, request);\n779:\tconst durableFence = deps.ledger.findQuestionFence(\n780-\t\trequest.questionId,\n781-\t\trequest.requestId,\n782-\t);\n783-\tif (durableFence !== null) {\n784-\t\tthrow sealed(\n785-\t\t\t409,\n786-\t\t\t\"already_resolved\",\n787-\t\t\t\"an answer for this question was already delivered or may have been delivered; it will not be typed again\",\n788-\t\t\t{\n789-\t\t\t\tresolvedBy: question.remoteAnswer?.resolvedBy ?? null,\n790-\t\t\t\tresolvedAtMs:\n791-\t\t\t\t\tquestion.remoteAnswer?.deliveredAtMs ?? durableFence.resolvedAtMs,\n792-\t\t\t\toutcome: \"answered\",\n793-\t\t\t},\n794-\t\t);\n795-\t}\n--\n871-\t\t);\n872-\t}\n873-\n874-\tif (claim.kind === \"replay\") {\n875-\t\tconst previous = claim.record;\n876-\t\tif (previous.status === \"failed\") {\n877-\t\t\t// The request-id fence stays closed, but legacy guard failures never\n878-\t\t\t// re-surface as a guard refusal. A fresh request may answer the still-open\n879-\t\t\t// question through the guardless path.\n880-\t\t\tthrow sealed(\n881-\t\t\t\t409,\n882-\t\t\t\t\"request_closed\",\n883-\t\t\t\t\"this request id already failed and is never re-executed; submit a new answer request\",\n884-\t\t\t);\n885-\t\t}\n886-\t\t// (ANSWER-INFLIGHT) The sequence for this very requestId is still typing.\n887:\t\t// Reporting `unconfirmed` here — which the client treats as terminal — for a","numLines":220,"totalLines":1169,"appliedLimit":220},"sourceToolAssistantUUID":"6a2f7b49-c7e8-4ead-bf5c-9a42d361b598","session_id":"41b65f55-7b51-4cfd-82d1-d1d1eec49d91","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\khair\\Code Projects\\fork-superset-windows-arm64","sessionId":"41b65f55-7b51-4cfd-82d1-d1d1eec49d91","version":"2.1.228","gitBranch":"main","slug":"jolly-singing-lemur"}
