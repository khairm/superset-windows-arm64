agent = normalizeAgentIdentity(input.agent);\n265\t\t\tconst occurredAt = Date.now();\n266\t\n267\t\t\tctx.eventBus.broadcastAgentLifecycle({\n268\t\t\t\tworkspaceId: terminalSession.originWorkspaceId,\n269\t\t\t\teventType,\n270\t\t\t\tterminalId: input.terminalId,\n271\t\t\t\t...(agent ? { agent } : {}),\n272\t\t\t\toccurredAt,\n273\t\t\t});\n274\t\n275\t\t\tctx.terminalAgentStore.recordEvent({\n276\t\t\t\tterminalId: input.terminalId,\n277\t\t\t\tworkspaceId: terminalSession.originWorkspaceId,\n278\t\t\t\teventType,\n279\t\t\t\t...(agent?.agentId ? { agentId: agent.agentId } : {}),\n280\t\t\t\t...(agent?.sessionId ? { agentSessionId: agent.sessionId } : {}),\n281\t\t\t\t...(agent?.definitionId ? { definitionId: agent.definitionId } : {}),\n282\t\t\t\toccurredAt,\n283\t\t\t});\n284\t\n285\t\t\t// (COMPANION-CAPTURE-HOOK) Strictly AFTER the dot work above, so a\n286\t\t\t// companion bridge fault can never alter or delay the agent-status\n287\t\t\t// broadcast: by the time anything below can throw, the dot has already\n288\t\t\t// moved. A throw here surfaces as a 500 the notify hook logs — loud, and\n289\t\t\t// harmless to the agent (the hook ignores the status beyond logging it).\n290\t\t\tforwardCompanionCapture({\n291\t\t\t\tpayload: input,\n292\t\t\t\tterminalId: input.terminalId,\n293\t\t\t\tworkspaceId: terminalSession.originWorkspaceId,\n294\t\t\t\toccurredAt,\n295\t\t\t});\n296\t\n297\t\t\t// An agent began working in this workspace — nudge the linked task\n298\t\t\t// to In Progress.\n299\t\t\tif (eventType === \"Start\") {\n300\t\t\t\tmarkLinkedTaskStarted(ctx, terminalSession.originWorkspaceId);\n301\t\t\t}\n302\t\n303\t\t\treturn { success: true, ignored: false as const };\n304\t\t}),\n305\t\n306\t\t/**\n307\t\t * (BUS-RESYNC) Durable agent status for every live terminal binding on this\n308\t\t * host. The WS event bus is fire-and-forget — an event broadcast while a\n309\t\t * renderer is disconnected is DESTROYED, and a blocked agent emits no\n310\t\t * further hook events, so a dot lost that way can never self-heal. The\n311\t\t * renderer refetches this on every bus (re)connect and reconciles.\n312\t\t *\n313\t\t * Read-only and cheap: a liveness-joined in-memory store read, one\n314\t\t * marker-directory read per bound terminal, and one covering read of the\n315\t\t * `terminal_sessions` primary key. On `queryProcedure` (repo rule: every\n316\t\t * `.query` carries a server-side timeout) so a wedged readdir rejects\n317\t\t * instead of leaving the renderer's resync promise pending forever — an\n318\t\t * un-settling promise would keep the epoch marked synced and disarm the\n319\t\t * retry, leaving the dots unreconciled for the life of the connection.\n320\t\t */\n321\t\tagentStatusSnapshot: queryProcedure\n322\t\t\t.input(\n323\t\t\t\tz\n324\t\t\t\t\t.object({\n325\t\t\t\t\t\t/**\n326\t\t\t\t\t\t * (GHOST-TERMINAL) Terminal ids the caller holds dot state for.\n327\t\t\t\t\t\t * When present, `knownTerminalIds` comes back intersected with\n328\t\t\t\t\t\t * these instead of listing every row the host has ever minted.\n329\t\t\t\t\t\t *\n330\t\t\t\t\t\t * Bounded at the boundary because it feeds `inArray`, which\n331\t\t\t\t\t\t * expands to one bound parameter per element: past SQLite's\n332\t\t\t\t\t\t * variable limit the query THROWS, the resync fails, and the\n333\t\t\t\t\t\t * renderer retries the same oversized input on every reconnect —\n334\t\t\t\t\t\t * dots frozen for the life of the connection. Rejected rather\n335\t\t\t\t\t\t * than truncated: a silently shortened candidate list makes the\n336\t\t\t\t\t\t * sweep treat present terminals as unknown, which is a wrong\n337\t\t\t\t\t\t * answer dressed as a right one. The renderer sends one id per\n338\t\t\t\t\t\t * terminal it holds dot state for (tens in practice, one per open\n339\t\t\t\t\t\t * pane), so 500 is far above anything legitimate and no host-side\n340\t\t\t\t\t\t * chunking is warranted.\n341\t\t\t\t\t\t *\n342\t\t\t\t\t\t * Element LENGTH is deliberately unbounded (min 1 only): the\n343\t\t\t\t\t\t * creation boundaries accept caller-supplied ids of any length\n344\t\t\t\t\t\t * (`terminal.createSession` takes a plain string, REST likewise),\n345\t\t\t\t\t\t * and a length cap here meant one long id with dot state poisoned\n346\t\t\t\t\t\t * every snapshot query for the host — reconciliation dead on a\n347\t\t\t\t\t\t * retry loop. SQLite is protected by the ARRAY cap, not element\n348\t\t\t\t\t\t * size.\n349\t\t\t\t\t\t */\n350\t\t\t\t\t\tcandidateTerminalIds: z.array(z.string().min(1)).max(500).optional(),\n351\t\t\t\t\t})\n352\t\t\t\t\t.optional(),\n353\t\t\t)\n354\t\t\t.query(async ({ ctx, input }): Promise<AgentStatusSnapshot> => {\n355\t\t\t\treturn buildAgentStatusSnapshot(\n356\t\t\t\t\tctx.terminalAgentStore,\n357\t\t\t\t\tctx.db,"}]},"uuid":"7778c206-5f9b-4410-b6ee-d48edd3d430a","timestamp":"2026-08-12T11:22:49.130Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\khair\\Code Projects\\fork-superset-windows-arm64\\packages\\host-service\\src\\trpc\\router\\notifications\\notifications.ts","content":"\t\t// killed, and would resurrect exactly the rows the reaper is trying to\n\t\t// finish killing.\n\t\tconst terminalSession = ctx.db.query.terminalSessions\n\t\t\t.findFirst({\n\t\t\t\twhere: eq(terminalSessions.id, input.terminalId),\n\t\t\t\tcolumns: { originWorkspaceId: true },\n\t\t\t})\n\t\t\t.sync();\n\n\t\tif (!terminalSession) {\n\t\t\treportUnknownTerminal({\n\t\t\t\tterminalId: input.terminalId,\n\t\t\t\teventType: input.eventType,\n\t\t\t\tmappedEventType: eventType,\n\t\t\t\tagentId: input.agent?.agentId,\n\t\t\t\tagentSessionId: input.agent?.sessionId,\n\t\t\t});\n\t\t\twarnDroppedCompanionCapture(\n\t\t\t\tinput,\n\t\t\t\t`terminal ${input.terminalId} has no session row`,\n\t\t\t);\n\t\t\treturn {\n\t\t\t\tsuccess: true,\n\t\t\t\tignored: true as const,\n\t\t\t\treason: \"unknown-terminal\" as const,\n\t\t\t};\n\t\t}\n\n\t\tif (!terminalSession.originWorksp