{"parentUuid":"c93fcfb7-9204-4ac7-b0be-6d63b338b1d7","isSidechain":false,"promptId":"74f0bdab-b623-4a5d-a0b9-48253b09cc75","type":"user","message":{"role":"user","content":[{"tool_use_id":"call_B1IgUlGRf62EawG4fprBnuzd","type":"tool_result","content":"1\t/**\n2\t * (COMPANION-BRIDGE) — answer injection and idempotency (§11).\n3\t *\n4\t * (ANSWER-GUARDLESS) A pending, captured Claude question is directly answerable\n5\t * from a paired phone or watch. After the request boundary validates question\n6\t * identity and answer shape, `encodeAnswer` produces the proven byte sequence and\n7\t * `injectSequence` writes it to the captured terminal under the per-terminal lock.\n8\t * No transcript, screen, renderer, Windows interactive-session, agent-binding,\n9\t * permission-latch or marker observation may veto or downgrade that write.\n10\t *\n11\t * The lock, answer-wide lease and durable request ledger remain: they prevent two\n12\t * devices from interleaving bytes and make retries idempotent. Each PTY write is\n13\t * counted only after the daemon acknowledges `pty.write`, and the response is\n14\t * confirmed only after the ledger outcome is written and read back. An actual PTY\n15\t * failure prevents confirmation; a ledger failure after landed bytes returns an\n16\t * honest, duplicate-fenced `unconfirmed` outcome.\n17\t *\n18\t * Answer attempts record empty guard arrays and `null` evaluation solely for\n19\t * persisted audit-schema compatibility.\n20\t */\n21\t\n22\timport type {\n23\t\tAttemptLedger,\n24\t\tLedgerRecord,\n25\t\tStatusOutcome,\n26\t} from \"./attempt-ledger\";\n27\timport { type AuditLog, hashJsonPayload } from \"./audit\";\n28\timport { ANSWER_ATTEMPT_RETENTION_MS } from \"./config\";\n29\timport type { AcknowledgedInputFailureKind } from \"../terminal/DaemonClient\";\n30\timport { sleep } from \"./crypto\";\n31\timport {\n32\t\tcreateRawPtyWriter,\n33\t\tencodeAnswer,\n34\t\tfindForbiddenControlChar,\n35\t\tfindUnpairedSurrogate,\n36\t\ttype Keystroke,\n37\t\tKeystrokeEncodingError,\n38\t\tMESSAGE_ALLOWED_C0,\n39\t\tprovenMultiSelectFreeTextDetectLabels,\n40\t\ttype RawPtyWriter,\n41\t\ttype RawWriteFn,\n42\t\ttype RawWriteResult,\n43\t} from \"./keystrokes\";\n44\timport {\n45\t\ttype LeaseRegistry,\n46\t\ttype TerminalLockRegistry,\n47\t\tTerminalLockTimeoutError,\n48\t} from \"./lease\";\n49\timport type { PendingQuestion, QuestionStore } from \"./question-store\";\n50\timport {\n51\t\ttype AgentKind,\n52\t\ttype AnswerAttemptRecord,\n53\t\ttype AnswerGuardName,\n54\t\ttype AnswerRequest,\n55\t\ttype AnswerResponse,\n56\t\ttype AnswerStatusOutcome,\n57\t\ttype AnswerStatusRequest,\n58\t\ttype AnswerStatusResponse,\n59\t\ttype AttemptFailureCode,\n60\t\ttype AuditEntry,\n61\t\ttype DurationMs,\n62\t\ttype EpochMs,\n63\t\ttype MessageRequest,\n64\t\ttype MessageResponse,\n65\t\ttype QuestionId,\n66\t\ttype QuestionItem,\n67\t\ttype RequestId,\n68\t\tSealedError,\n69\t\ttype SealedRequestContext,\n70\t\ttype TerminalId,\n71\t} from \"./types\";\n72\t\n73\t// ---------------------------------------------------------------------------\n74\t// tunables (bridge-internal; none of these are on the wire)\n75\t// ---------------------------------------------------------------------------\n76\t\n77\t/**\n78\t * How long a request will wait for the per-terminal lock. On expiry NOTHING has\n79\t * been written — the critical section never ran — and the client is told so.\n80\t */\n81\texport const LOCK_WAIT_TIMEOUT_MS = 5_000;\n82\t\n83\t/** Poll interval while waiting for the emulator mirror to reflect our last byte. */\n84\texport const SCREEN_ADVANCE_POLL_MS = 25;\n85\t\n86\t/**\n87\t * Hard ceiling on one keystroke sequence. Bounds how long the terminal lock can\n88\t * be held, and keeps the sequence inside the answer lease's TTL.\n89\t */\n90\texport const SEQUENCE_DEADLINE_MS = 10_000;\n91\t\n92\t/** PROTOCOL §7.5 — a message body is 1..8 192 chars. */\n93\texport const MESSAGE_MAX_CHARS = 8_192;\n94\t\n95\t/**\n96\t * (MESSAGE-ECHO) How long `/v1/message` waits for the composer to render the\n97\t * text it just pasted, before it will write the trailing submit.\n98\t *\n99\t * A paste of up to 8 192 chars can require a substantial repaint. The wait is\n100\t * bounded because the\n101\t * terminal lock is held throughout.\n102\t */\n103\texport const MESSAGE_ECHO_TIMEOUT_MS = 2_000;\n104\t\n105\t/**\n106\t * (MESSAGE-ECHO) Squashed characters of the message used as the on-screen\n107\t * anchor. Long enough that matching it by chance is implausible, short enough to\n108\t * survive the composer hard-wrapping.\n109\t */\n110\texport const MESSAGE_ECHO_ANCHOR_CHARS = 24;\n111\t\n112\t/**\n113\t * (MESSAGE-ECHO) The FLOOR on that anchor. Below it the echo proves nothing and\n114\t * the submit is withheld.\n115\t *\n116\t * `MESSAGE_ECHO_ANCHOR_CHARS` is a ceiling — `slice(0, 24)` of a three-character\n117\t * message is the whole three characters. With no floor the check collapsed to\n118\t * \"does this short string occur anywhere in a band on screen\", and the needle is\n119\t * the CLIENT's own text, so it is attacker-parameterisable in exactly the way\n120\t * guard 5's capture-derived anchors were. Measured against the real\n121\t * `handleMessage` path with an inert paste (the picker case): the text \"yes\"\n122\t * matched a picker's own option label \"Yes, proceed…\" and the text \"1\" matched\n123\t * the picker's own row number — both returned `sent` and wrote the trailing\n124\t * `\\r` into an open picker.\n125\t *\n126\t * Same value and same reasoning as `SCREEN_MIN_ANCHOR_CHARS` (guard 5's remedy\n127\t * for the identical class), kept as its own name because the two paths are free\n128\t * to diverge.\n129\t */\n130\texport const MESSAGE_ECHO_MIN_ANCHOR_CHARS = 8;\n131\t\n132\t/**\n133\t * (MESSAGE-ECHO) Ceiling on how tall the echo search band may grow.\n134\t *\n135\t * The band tracks the message's own line count so a multi-line message can be\n136\t * found where it is rendered, but it is capped: without a cap a message made of\n137\t * many one-character lines would widen the search to \"anywhere in the viewport\",\n138\t * which is the property the banding exists to deny.\n139\t */\n140\texport const MESSAGE_ECHO_MAX_WINDOW_LINES = 16;\n141\t\n142\t// ---------------------------------------------------------------------------\n143\t// dependencies\n144\t// ---------------------------------------------------------------------------\n145\t\n146\t/** What a guard source reports. `null` means \"could not determine\" and fails closed. */\n147\texport type GuardSourceResult = boolean | null;\n148\t\n149\texport interface TerminalAgentInfo {\n150\t\tkind: AgentKind;\n151\t\t/** false => a plain shell. NEVER writable. */\n152\t\tbound: boolean;\n153\t\t/** The agent session this terminal is currently bound to, if known. */\n154\t\tagentSessionId: string | null;\n155\t}\n156\t\n157\t/**\n158\t * The host.db ids behind an opaque wire handle. These — and ONLY these — are\n159\t * what the pty writer accepts; the wire handle is a truncated SHA-256 and is\n160\t * never a key in the live session map.\n161\t */\n162\texport interface HostTerminalRef {\n163\t\t/** host.db `terminal_sessions.id`. */\n164\t\thostTerminalId: string;\n165\t\t/** host.db `workspaces.id`. */\n166\t\thostWorkspaceId: string;\n167\t}\n168\t\n169\t/**\n170\t * Everything the answer path needs from the rest of host-service.\n171\t *\n172\t * Note the two writers are deliberately DIFFERENT SHAPES so neither can be\n173\t * passed where the other belongs:\n174\t *  - `writer` is a `RawPtyWriter`, mintable only by `createRawPtyWriter`, which\n175\t *    requires the acknowledged raw-writer runtime marker. Bracketed paste is\n176\t *    INERT against the picker, while fire-and-forget input cannot report daemon\n177\t *    refusal, so either wrong writer fails at bridge startup;\n178\t *  - `writeFramed` is async and takes `{text, submit}`, and is used ONLY by\n179\t *    `handleMessage`, which never touches a picker.\n180\t */\n181\texport interface AnswerDeps {\n182\t\t/**\n183\t\t * Raw, unframed, ACKNOWLEDGED pty write. MUST be the composition-root adapter\n184\t\t * around `writeAcknowledgedInputToSession` from `../terminal/terminal`; its\n185\t\t * `prepare` method is bound to host.db in THIS process so a detached session is\n186\t\t * adopted headlessly before the answer lease and final identity check. The\n187\t\t * runtime marker prevents wiring paste framing or fire-and-forget input.\n188\t\t */\n189\t\twriteInput: RawWriteFn;\n190\t\t/**\n191\t\t * Paste-framed write, for `/v1/message` ONLY. Deliberately a different shape\n192\t\t * (async, `{text, submit}`) so it cannot be swapped with `writeInput`. Never\n193\t\t * reachable from the injector.\n194\t\t *\n195\t\t * `terminalId` / `workspaceId` are HOST.DB ids from `resolveHostTerminal`, not\n196\t\t * wire handles — the field names are the pty writer's, and the writer looks\n197\t\t * them up in its live session map.\n198\t\t *\n199\t\t * NOTE, because the header comment on `handleMessage` used to get this wrong:\n200\t\t * `submit: true` appends `\\r` OUTSIDE the bracketed-paste frame. The body is\n201\t\t * inert against a picker; that `\\r` is not. (MESSAGE-ECHO) is why the message\n202\t\t * path calls this TWICE — once with `submit: false` for the body, and once\n203\t\t * with an empty body and `submit: true` for the commit, with a positive screen\n204\t\t * check in between.\n205\t\t */\n206\t\twriteFramed(input: {\n207\t\t\tterminalId: string;\n208\t\t\tworkspaceId: string;\n209\t\t\ttext: string;\n210\t\t\tsubmit: boolean;\n211\t\t}): Promise<{ success: true } | { error: string }>;\n212\t\t/**\n213\t\t * The terminal's VISIBLE VIEWPORT as plain text. Guard 5's source.\n214\t\t *\n215\t\t * Viewport, not buffer: Claude Code renders inline in the normal buffer, so a\n216\t\t * whole-buffer snapshot carries up to 1 000 lines of scrollback containing\n217\t\t * every earlier picker render, and guard 5 would confirm against one of those.\n218\t\t */\n219\t\tsnapshotScreen(terminalId: TerminalId): Promise<string>;\n220\t\n221\t\tlocks: TerminalLockRegistry;\n222\t\tleases: LeaseRegistry;\n223\t\t/**\n224\t\t * (ANSWER-LEDGER) The durable idempotency + status ledger, and the fence that\n225\t\t * closes the status/answer race. It replaced a JSON store that sat here beside\n226\t\t * it during the migration; there is only one now.\n227\t\t */\n228\t\tledger: AttemptLedger;\n229\t\tmessageAttempts: MessageAttemptStore;\n230\t\tquestions: QuestionStore;\n231\t\taudit: AuditLog;\n232\t\tnow(): EpochMs;\n233\t\t/**\n234\t\t * When THIS bridge lifetime began — the same value `HeartbeatResponse`\n235\t\t * carries (§6.3). `/v1/answer/status` reports it so a client can tell \"no\n236\t\t * record because it never arrived\" from \"no record because this bridge is\n237\t\t * younger than the write\". It is a constant per mount, not a clock.\n238\t\t */\n239\t\tbridgeStartedMs: EpochMs;\n240\t\n241\t\t/**\n242\t\t * Maps an OPAQUE wire terminal handle (§0.1) back to the host.db ids the pty\n243\t\t * writer actually understands. `null` => refuse; never guessed.\n244\t\t *\n245\t\t * Both ids come back together on purpose. They were previously resolved\n246\t\t * separately, and the answer path ended up calling the pty writer with the\n247\t\t * WIRE HANDLE as `terminalId` and the real host id as `workspaceId` — a pair\n248\t\t * that can never match a live session, so every answer failed\n249\t\t * `Terminal session not found` while looking like a guard problem. `TerminalId`\n250\t\t * is a `string` alias, so nothing in the type system catches that; resolving\n251\t\t * the pair in one call is what makes it unrepresentable.\n252\t\t */\n253\t\tresolveHostTerminal(terminalId: TerminalId): Promise<HostTerminalRef | null>;\n254\t\n255\t\t/** Current agent binding, used only by `/v1/message`. */\n256\t\tagentBinding(terminalId: TerminalId): Promise<TerminalAgentInfo | null>;\n257\t\n258\t\t/** Whether the pty session is alive, used only by `/v1/message`. */\n259\t\tsessionActive(terminalId: TerminalId): Promise<GuardSourceResult>;\n260\t\n261\t\t/** Current permission-axis latch, used only to keep `/v1/message` off pickers. */\n262\t\tpermissionAxisLatched(terminalId: TerminalId): Promise<GuardSourceResult>;\n263\t\n264\t\t/** Structured diagnostics. Never carries question or answer text. */\n265\t\tlog(event: Record<string, unknown>): void;\n266\t}\n267\t\n268\t/**\n269\t * One probe per distinct writer function, not one per request.\n270\t *\n271\t * The composition root SHOULD call `assertAnswerDeps` at bridge start so the\n272\t * acknowledged-writer marker is checked before the first answer of the day.\n273\t */\n274\tconst rawWriters = new WeakMap<RawWriteFn, RawPtyWriter>();\n275\t\n276\tfunction rawWriterFor(deps: AnswerDeps): RawPtyWriter {\n277\t\tconst existing = rawWriters.get(deps.writeInput);\n278\t\tif (existing !== undefined) return existing;\n279\t\tconst writer = createRawPtyWriter(deps.writeInput);\n280\t\trawWriters.set(deps.writeInput, writer);\n281\t\treturn writer;\n282\t}\n283\t\n284\t/**\n285\t * Startup check for the composition root. Proves the raw writer is the raw\n286\t * writer before any question can be answered, and fails loud if it is not.\n287\t */\n288\texport function assertAnswerDeps(deps: AnswerDeps): void {\n289\t\trawWriterFor(deps);\n290\t\tif (typeof deps.writeFramed !== \"function\") {\n291\t\t\tthrow new Error(\n292\t\t\t\t\"(COMPANION-BRIDGE) answer deps: writeFramed must be writeFramedInputToSession — /v1/message needs paste framing\",\n293\t\t\t);\n294\t\t}\n295\t\tif (typeof deps.snapshotScreen !== \"function\") {\n296\t\t\tthrow new Error(\n297\t\t\t\t\"(COMPANION-BRIDGE) answer deps: snapshotScreen is required for /v1/message picker checks\",\n298\t\t\t);\n299\t\t}\n300\t}\n301\t\n302\t// ---------------------------------------------------------------------------\n303\t// message-path screen helpers\n304\t// ---------------------------------------------------------------------------\n305\t\n306\t/** Squashed characters used to identify the item's header. */\n307\tconst SCREEN_HEADER_ANCHOR_CHARS = 12;\n308\t\n309\t/** Squashed characters used when an item has no usable header. */\n310\tconst SCREEN_QUESTION_ANCHOR_CHARS = 24;\n311\t\n312\t/** Minimum prompt anchor length accepted as evidence by `/v1/message`. */\n313\tconst SCREEN_MIN_ANCHOR_CHARS = 8;\n314\t\n315\ttype PromptMatchReason =\n316\t\t| \"match\"\n317\t\t| \"empty_screen\"\n318\t\t| \"anchor_absent\"\n319\t\t| \"anchor_too_weak\";\n320\t\n321\tinterface PromptScreenMatch {\n322\t\tok: boolean;\n323\t\treason: PromptMatchReason;\n324\t}\n325\t\n326\t/** Lowercase and strip ALL whitespace: immune to indentation and hard wraps. */\n327\tfunction squash(text: string): string {\n328\t\treturn text.toLowerCase().replace(/\\s+/g, \"\");\n329\t}\n330\t\n331\t/**\n332\t * How many adjacent screen lines a single logical row may be assembled from.\n333\t *\n334\t * Squashing strips newlines too, so squashing the WHOLE screen lets an anchor be\n335\t * assembled from fragments on lines that are nowhere near each other — the digit\n336\t * from one place, the label from another. Two is the smallest window that still\n337\t * tolerates the emulator hard-wrapping one long row across a column boundary,\n338\t * which is the reason whitespace is stripped in the first place.\n339\t */\n340\tconst SCREEN_LINE_WINDOW = 2;\n341\t\n342\t/**\n343\t * The screen as a set of squashed, overlapping line windows.\n344\t *\n345\t * A match must lie WITHIN one window, so a row cannot be built out of text from\n346\t * opposite ends of the buffer. Any match contained in a single line is also\n347\t * contained in the window that starts at that line, so nothing that used to\n348\t * match legitimately stops matching.\n349\t *\n350\t * `windowLines` is a parameter because the needle's own height varies: a picker\n351\t * row is one line (plus wrap slack), while (MESSAGE-ECHO) searches for a message\n352\t * the user may have written across several. Callers that omit it get the picker\n353\t * default and are unaffected.\n354\t */\n355\tfunction squashedWindows(\n356\t\tscreen: string,\n357\t\twindowLines: number = SCREEN_LINE_WINDOW,\n358\t): string[] {\n359\t\tconst lines = screen.split(\"\\n\");\n360\t\t// NO whole-screen special case for short screens. It returned a single window\n361\t\t// covering everything, which breaks the invariant every caller relies on —\n362\t\t// window i starts at line i — so a two-line screen could not match a row that\n363\t\t// was plainly on it. The general loop below handles any length.\n364\t\tconst windows: string[] = [];\n365\t\t// EVERY line starts a window, including the last one (whose window is just\n366\t\t// itself). Stopping a line early left the final line unable to START a window,\n367\t\t// which was invisible while the row pattern was an unanchored substring search\n368\t\t// — the row could still be found inside the previous line's window — and became\n369\t\t// a refusal the moment (GUARD5-ROW-ANCHOR) required the row to begin its\n370\t\t// window. A picker whose last option is the last line of the viewport is\n371\t\t// ordinary, not suspicious.\n372\t\tfor (let i = 0; i < lines.length; i += 1) {\n373\t\t\twindows.push(squash(lines.slice(i, i + windowLines).join(\"\")));\n374\t\t}\n375\t\treturn windows;\n376\t}\n377\t\n378\tfunction anyWindowIncludes(\n379\t\twindows: readonly string[],\n380\t\tneedle: string,\n381\t): boolean {\n382\t\treturn windows.some((window) => window.includes(needle));\n383\t}\n384\t\n385\tfunction anchorOf(text: string, maxChars: number): string {\n386\t\treturn squash(text).slice(0, maxChars);\n387\t}\n388\t\n389\t/**\n390\t * Prompt anchor used only to refuse `/v1/message` when a recently retired\n391\t * question may still be rendered. Short anchors are inconclusive.\n392\t */\n393\tfunction promptAnchor(item: QuestionItem): string {\n394\t\tconst header = anchorOf(item.header, SCREEN_HEADER_ANCHOR_CHARS);\n395\t\tif (header.length >= SCREEN_MIN_ANCHOR_CHARS) return header;\n396\t\tconst question = anchorOf(item.question, SCREEN_QUESTION_ANCHOR_CHARS);\n397\t\tif (question.length >= SCREEN_MIN_ANCHOR_CHARS) return question;\n398\t\treturn \"\";\n399\t}\n400\t\n401\tfunction matchPromptOnScreen(input: {\n402\t\tscreen: string;\n403\t\titem: QuestionItem;\n404\t}): PromptScreenMatch {\n405\t\tconst windows = squashedWindows(input.screen);\n406\t\tif (windows.every((window) => window.length === 0)) {\n407\t\t\treturn { ok: false, reason: \"empty_screen\" };\n408\t\t}\n409\t\n410\t\tconst anchor = promptAnchor(input.item);\n411\t\tif (anchor.length === 0) {\n412\t\t\treturn { ok: false, reason: \"anchor_too_weak\" };\n413\t\t}\n414\t\tif (!anyWindowIncludes(windows, anchor)) {\n415\t\t\treturn { ok: false, reason: \"anchor_absent\" };\n416\t\t}\n417\t\treturn { ok: true, reason: \"match\" };\n418\t}\n419\t\n420\t/**\n421\t * (GUARD5-ANCHOR / PICKER-CHROME) Does the viewport show the STRUCTURE of a\n422\t * picker — a run of numbered rows in ascending digit order starting at 1?\n423\t *\n424\t * Nothing in this function comes from a capture: it is the only screen evidence\n425\t * the bridge has that no caller can parameterise. It is deliberately used ONLY\n426\t * where a false positive is a refusal:\n427\t *   - `/v1/message`, where a picker on screen must block the trailing `\\r`.\n428\t * It is NOT used to permit anything.\n429\t *\n430\t * IT ERRS TOWARD MATCHING, deliberately and asymmetrically. A false positive\n431\t * costs one refused message, which the user retries or types at the desk. A\n432\t * false NEGATIVE writes a bare `\\r` into an open picker, which toggles a\n433\t * multi-select row or submits an N-question review screen irreversibly. So the\n434\t * two bounds that used to make this miss ordinary renders are gone:\n435\t *\n436\t *  - there is NO cap on the distance between consecutive rows. A cap of two\n437\t *    lines was measured to miss a picker whose first option label WRAPPED across\n438\t *    three lines, and a picker with two blank lines between rows. Ascending\n439\t *    digit order across the whole viewport is the structure being looked for;\n440\t *    the gap was never part of it.\n441\t *  - leading decoration is unbounded (`[^0-9A-Za-z]*`) rather than capped at\n442\t *    eight characters, so box drawing plus a selection caret plus deep\n443\t *    indentation cannot push the digit out of reach. The character class still\n444\t *    cannot cross a letter or another digit, so this does not match mid-line\n445\t *    numbers.\n446\t *\n447\t * An agent that printed an ordinary numbered list still matches, and that is\n448\t * still the correct trade.\n449\t */\n450\texport const PICKER_CHROME_MIN_ROWS = 2;\n451\tconst PICKER_CHROME_ROW = /^[^0-9A-Za-z]*([1-9])[.)\\]:]?\\s+\\S/;\n452\t\n453\texport function screenShowsPickerChrome(screen: string): boolean {\n454\t\tconst lines = screen.split(\"\\n\");\n455\t\t/** Which digit the run expects next. */\n456\t\tlet expected = 1;\n457\t\tlet run = 0;\n458\t\tfor (let i = 0; i < lines.length; i += 1) {\n459\t\t\tconst line = lines[i];\n460\t\t\tif (line === undefined) continue;\n461\t\t\tconst match = PICKER_CHROME_ROW.exec(line);\n462\t\t\tif (match === null) continue;\n463\t\t\tconst digit = Number(match[1]);\n464\t\t\tif (run > 0 && digit === expected) {\n465\t\t\t\trun += 1;\n466\t\t\t\texpected += 1;\n467\t\t\t\tif (run >= PICKER_CHROME_MIN_ROWS) return true;\n468\t\t\t\tcontinue;\n469\t\t\t}\n470\t\t\tif (digit === 1) {\n471\t\t\t\trun = 1;\n472\t\t\t\texpected = 2;\n473\t\t\t\tif (run >= PICKER_CHROME_MIN_ROWS) return true;\n474\t\t\t}\n475\t\t\t// A numbered line that neither continues the run nor starts one is IGNORED,\n476\t\t\t// not treated as the end of the run. Resetting here was a third way to miss\n477\t\t\t// a wrapped label, on top of the gap cap and the decoration cap: a\n478\t\t\t// continuation line reading \"   3 tables and rebuilding every index\" matches\n479\t\t\t// this row pattern with digit 3, and between rows 1 and 2 that reset dropped\n480\t\t\t// the run and the picker went undetected. Skipping instead can only ever\n481\t\t\t// ADD matches, which on this detector is the refusing direction.\n482\t\t}\n483\t\treturn false;\n484\t}\n485\t\n486\t/**\n487\t * Checks whether a recently retired question's prompt remains visible. Used\n488\t * only by `/v1/message` in the refusing direction; option rows are irrelevant.\n489\t */\n490\tfunction matchPromptStillOnScreen(input: {\n491\t\tscreen: string;\n492\t\titem: QuestionItem;\n493\t}): PromptScreenMatch {\n494\t\treturn matchPromptOnScreen(input);\n495\t}\n496\t\n497\t/** The sealed codes this module is allowed to emit. A closed set, per §10. */\n498\ttype SealedCode =\n499\t\t| \"stale_question\"\n500\t\t| \"already_resolved\"\n501\t\t| \"lease_held\"\n502\t\t| \"guard_failed\"\n503\t\t| \"picker_open\"\n504\t\t| \"capability_unsupported\"\n505\t\t/** (ANSWER-LEDGER) The fence. See where it is thrown for why not `already_resolved`. */\n506\t\t| \"request_closed\"\n507\t\t| \"write_disabled\"\n508\t\t| \"bad_request\"\n509\t\t| \"internal\";\n510\t\n511\tfunction sealed(\n512\t\tstatusCode: number,\n513\t\tcode: SealedCode,\n514\t\tmessage: string,\n515\t\tdetail: Record<string, unknown> | null = null,\n516\t): SealedError {\n517\t\treturn new SealedError(statusCode, {\n518\t\t\tcode,\n519\t\t\tmessage,\n520\t\t\tretryAfterMs: null,\n521\t\t\tdetail,\n522\t\t});\n523\t}\n524\t\n525\t/**\n526\t * Maps a pure encoding failure. Every one of these provably wrote nothing: the\n527\t * encoder runs before the lock is taken and touches no terminal.\n528\t */\n529\tfunction sealedFromEncoding(error: KeystrokeEncodingError): SealedError {\n530\t\tif (error.reason === \"shape_unproven\") {\n531\t\t\treturn sealed(\n532\t\t\t\t501,\n533\t\t\t\t\"capability_unsupported\",\n534\t\t\t\t\"this prompt shape has no proven byte sequence and is refused rather than guessed; answer it at the desk\",\n535\t\t\t\t{ capability: \"answer.multiselect\", reason: error.reason },\n536\t\t\t);\n537\t\t}\n538\t\treturn sealed(400, \"bad_request\", error.message, { reason: error.reason });\n539\t}\n540\t\n541\t// ---------------------------------------------------------------------------\n542\t// idempotency\n543\t// ---------------------------------------------------------------------------\n544\t//\n545\t// (ANSWER-LEDGER) The ~900-line JSON attempt store that used to live here — its\n546\t// `answer-attempts.json`, its rise-only witness, its quarantine and degrade\n547\t// paths, its PRUNE-FLOOR and STORE-CLOSED guards — is gone. `attempt-ledger.ts`\n548\t// replaced it with a table and a transaction.\n549\t//\n550\t// It was not deleted for being untidy. It could not close the race it existed to\n551\t// describe: a status read can overtake an admitted answer, and deciding between\n552\t// them needs an atomic compare-and-set that a read-modify-rewrite of a file\n553\t// cannot provide. Every mechanism above was in service of DETECTING that the file\n554\t// had rolled back, which was a true and useless thing to know.\n555\t//\n556\t// Two accepted weaknesses went with it. Its durability rested on an undocumented\n557\t// inference about NTFS rename ordering (see `writeFileDurable`); SQLite's is\n558\t// documented, and asserted at FULL. And it validated the file as a WHOLE, so one\n559\t// incoherent record quarantined every other record's 24 hours — rows validate\n560\t// individually now, so a corrupt row costs exactly one requestId its status.\n561\t//\n562\t// The message path keeps its own small in-memory store below: a message has no\n563\t// question and no lease, and it makes no coverage claim, so it needs none of this.\n564\t\n565\t/**\n566\t * §7.5 — the message path's own idempotency record. Kept separate from\n567\t * `AnswerAttemptRecord` rather than folded into it: a message has no question\n568\t * and no lease, and inventing empty values for those would put fiction into the\n569\t * audit trail the residual race (§11.7) depends on.\n570\t */\n571\texport interface MessageAttemptRecord {\n572\t\trequestId: RequestId;\n573\t\tterminalId: TerminalId;\n574\t\tstartedAtMs: EpochMs;\n575\t\tstatus: \"sent\" | \"unconfirmed\" | \"failed\";\n576\t\tsentAtMs: EpochMs | null;\n577\t}\n578\t\n579\texport interface MessageAttemptStore {\n580\t\tget(requestId: RequestId): MessageAttemptRecord | null;\n581\t\tput(record: MessageAttemptRecord): void;\n582\t\tprune(nowMs: EpochMs): number;\n583\t}\n584\t\n585\texport function createMessageAttemptStore(\n586\t\toptions: { retentionMs?: DurationMs } = {},\n587\t): MessageAttemptStore {\n588\t\tconst retentionMs = options.retentionMs ?? ANSWER_ATTEMPT_RETENTION_MS;\n589\t\tconst records = new Map<RequestId, MessageAttemptRecord>();\n590\t\treturn {\n591\t\t\tget(requestId) {\n592\t\t\t\treturn records.get(requestId) ?? null;\n593\t\t\t},\n594\t\t\tput(record) {\n595\t\t\t\trecords.set(record.requestId, record);\n596\t\t\t},\n597\t\t\tprune(nowMs) {\n598\t\t\t\tlet dropped = 0;\n599\t\t\t\tfor (const [requestId, record] of [...records]) {\n600\t\t\t\t\tif (nowMs - record.startedAtMs <= retentionMs) continue;\n601\t\t\t\t\trecords.delete(requestId);\n602\t\t\t\t\tdropped += 1;\n603\t\t\t\t}\n604\t\t\t\treturn dropped;\n605\t\t\t},\n606\t\t};\n607\t}\n608\t\n609\t// ---------------------------------------------------------------------------\n610\t// POST /v1/answer\n611\t// ---------------------------------------------------------------------------\n612\t\n613\t/**\n614\t * Advances the durable claim and reads it back from the DB before reporting\n615\t * success. A PTY acknowledgement proves where the bytes went; only this readback\n616\t * proves the outcome survived. Callers downgrade landed bytes to `unconfirmed`\n617\t * when this returns false, while the original `in_flight` claim remains a fence.\n618\t */\n619\tasync function recordOutcome(\n620\t\tdeps: AnswerDeps,\n621\t\trecord: AnswerAttemptRecord,\n622\t): Promise<boolean> {\n623\t\ttry {\n624\t\t\tif (record.status === \"in_flight\") return true;\n625\t\t\tdeps.ledger.recordOutcome({\n626\t\t\t\trequestId: record.requestId,\n627\t\t\t\tstatus: record.status,\n628\t\t\t\tresolvedAtMs: record.resolvedAtMs,\n629\t\t\t\tfailureCode: record.failureCode,\n630\t\t\t\tguardsPassed: record.guardsPassed,\n631\t\t\t\tleaseId: record.leaseId,\n632\t\t\t});\n633\t\t\tconst durable = deps.ledger.get(record.requestId);\n634\t\t\tif (durable?.status !== record.status) {\n635\t\t\t\tthrow new Error(\n636\t\t\t\t\t`ledger outcome verification read ${durable?.status ?? \"missing\"}, expected ${record.status}`,\n637\t\t\t\t);\n638\t\t\t}\n639\t\t\treturn true;\n640\t\t} catch (error) {\n641\t\t\tdeps.log({\n642\t\t\t\tevent: \"companion.answer.attempt_persist_failed\",\n643\t\t\t\trequestId: record.requestId,\n644\t\t\t\tquestionId: record.questionId,\n645\t\t\t\tstatus: record.status,\n646\t\t\t\terror: error instanceof Error ? error.message : String(error),\n647\t\t\t});\n648\t\t\treturn false;\n649\t\t}\n650\t}"}]},"uuid":"c2962c34-3fc1-431f-819d-08f0ced016cf","timestamp":"2026-08-10T22:49:48.341Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\khair\\Code Projects\\fork-superset-windows-arm64\\packages\\host-service\\src\\companion\\answer.ts","content":"/**\n * (COMPANION-BRIDGE) — answer injection and idempotency (§11).\n *\n * (ANSWER-GUARDLESS) A pending, captured Claude question is directly answerable\n * from a paired phone or watch. After the request boundary validates question\n * identity and answer shape, `encodeAnswer` produces the proven byte sequence and\n * `injectSequence` writes it to the captured terminal under the per-terminal lock.\n * No transcript, screen, renderer, Windows interactive-session, agent-binding,\n * permission-latch or marker observation may veto or downgrade that write.\n *\n * The lock, answer-wide lease and durable request ledger remain: they prevent two\n * devices from interleaving bytes and make retries idempotent. Each PTY write is\n * counted only after the daemon acknowledges `pty.write`, and the response is\n * confirmed only after the ledger outcome is written and read back. An actual PTY\n * failure prevents confirmation; a ledger failure after landed bytes returns an\n * honest, duplicate-fenced `unconfirmed` outcome.\n *\n * Answer attempts record empty guard arrays and `null` evaluation solely for\n * persisted audit-schema compatibility.\n */\n\nimport type {\n\tAttemptLedger,\n\tLedgerRecord,\n\tStatusOutcome,\n} from \"./attempt-ledger\";\nimport { type AuditLog, hashJsonPayload } from \"./audit\";\nimport { ANSWER_ATTEMPT_RETENTION_MS } from \"./config\";\nimport type { AcknowledgedInputFailureKind } from \"../terminal/DaemonClient\";\nimport { sleep } from \"./crypto\";\nimport {\n\tcreateRawPtyWriter,\n\tencodeAnswer,\n\tfindForbiddenControlChar,\n\tfindUnpairedSurrogate,\n\ttype Keystroke,\n\tKeystrokeEncodingError,\n\tMESSAGE_ALLOWED_C0,\n\tprovenMultiSelectFreeTextDetectLabels,\n\ttype RawPtyWriter,\n\ttype RawWriteFn,\n\ttype RawWriteResult,\n} from \"./keystrokes\";\nimport {\n\ttype LeaseRegistry,\n\ttype TerminalLockRegistry,\n\tTerminalLockTimeoutError,\n} from \"./lease\";\nimport type { PendingQuestion, QuestionStore } from \"./question-store\";\nimport {\n\ttype AgentKind,\n\ttype AnswerAttemptRecord,\n\ttype AnswerGuardName,\n\ttype AnswerRequest,\n\ttype AnswerResponse,\n\ttype AnswerStatusOutcome,\n\ttype AnswerStatusRequest,\n\ttype AnswerStatusResponse,\n\ttype AttemptFailureCode,\n\ttype AuditEntry,\n\ttype DurationMs,\n\ttype EpochMs,\n\ttype MessageRequest,\n\ttype MessageResponse,\n\ttype QuestionId,\n\ttype QuestionItem,\n\ttype RequestId,\n\tSealedError,\n\ttype SealedRequestContext,\n\ttype TerminalId,\n} from \"./types\";\n\n// ---------------------------------------------------------------------------\n// tunables (bridge-internal; none of these are on the wire)\n// ---------------------------------------------------------------------------\n\n/**\n * How long a request will wait for the per-terminal lock. On expiry NOTHING has\n * been written — the critical section never ran — and the client is told so.\n */\nexport const LOCK_WAIT_TIMEOUT_MS = 5_000;\n\n/** Poll interval while waiting for the emulator mirror to reflect our last byte. */\nexport const SCREEN_ADVANCE_POLL_MS = 25;\n\n/**\n * Hard ceiling on one keystroke sequence. Bounds how long the terminal lock can\n * be held, and keeps the sequence inside the answer lease's TTL.\n */\nexport const SEQUENCE_DEADLINE_MS = 10_000;\n\n/** PROTOCOL §7.5 — a message body is 1..8 192 chars. */\nexport const MESSAGE_MAX_CHARS = 8_192;\n\n/**\n * (MESSAGE-ECHO) How long `/v1/message` waits for the composer to render the\n * text it just pasted, before it will write the trailing submit.\n *\n * A paste of up to 8 192 chars can require a substantial repaint. The wait is\n * bounded because the\n * terminal lock is held throughout.\n */\nexport const MESSAGE_ECHO_TIMEOUT_MS = 2_000;\n\n/**\n * (MESSAGE-ECHO) Squashed characters of the message used as the on-screen\n * anchor. Long enough that matching it by chance is implausible, short enough to\n * survive the composer hard-wrapping.\n */\nexport const MESSAGE_ECHO_ANCHOR_CHARS = 24;\n\n/**\n * (MESSAGE-ECHO) The FLOOR on that anchor. Below it the echo proves nothing and\n * the submit is withheld.\n *\n * `MESSAGE_ECHO_ANCHOR_CHARS` is a ceiling — `slice(0, 24)` of a three-character\n * message is the whole three characters. With no floor the check collapsed to\n * \"does this short string occur anywhere in a band on screen\", and the needle is\n * the CLIENT's own text, so it is attacker-parameterisable in exactly the way\n * guard 5's capture-derived anchors were. Measured against the real\n * `handleMessage` path with an inert paste (the picker case): the text \"yes\"\n * matched a picker's own option label \"Yes, proceed…\" and the text \"1\" matched\n * the picker's own row number — both returned `sent` and wrote the trailing\n * `\\r` into an open picker.\n *\n * Same value and same reasoning as `SCREEN_MIN_ANCHOR_CHARS` (guard 5's remedy\n * for the identical class), kept as its own name because the two paths are free\n * to diverge.\n */\nexport const MESSAGE_ECHO_MIN_ANCHOR_CHARS = 8;\n\n/**\n * (MESSAGE-ECHO) Ceiling on how tall the echo search band may grow.\n *\n * The band tracks the message's own line count so a multi-line message can be\n * found where it is rendered, but it is capped: without a cap a message made of\n * many one-character lines would widen the search to \"anywhere in the viewport\",\n * which is the property the banding exists to deny.\n */\nexport const MESSAGE_ECHO_MAX_WINDOW_LINES = 16;\n\n// ---------------------------------------------------------------------------\n// dependencies\n// ---------------------------------------------------------------------------\n\n/** What a guard source reports. `null` means \"could not determine\" and fails closed. */\nexport type GuardSourceResult = boolean | null;\n\nexport interface TerminalAgentInfo {\n\tkind: AgentKind;\n\t/** false => a plain shell. NEVER writable. */\n\tbound: boolean;\n\t/** The agent session this terminal is currently bound to, if known. */\n\tagentSessionId: string | null;\n}\n\n/**\n * The host.db ids behind an opaque wire handle. These — and ONLY these — are\n * what the pty writer accepts; the wire handle is a truncated SHA-256 and is\n * never a key in the live session map.\n */\nexport interface HostTerminalRef {\n\t/** host.db `terminal_sessions.id`. */\n\thostTerminalId: string;\n\t/** host.db `workspaces.id`. */\n\thostWorkspaceId: string;\n}\n\n/**\n * Everything the answer path needs from the rest of host-service.\n *\n * Note the two writers are deliberately DIFFERENT SHAPES so neither can be\n * passed where the other belongs:\n *  - `writer` is a `RawPtyWriter`, mintable only by `createRawPtyWriter`, which\n *    requires the acknowledged raw-writer runtime marker. Bracketed paste is\n *    INERT against the picker, while fire-and-forget input cannot report daemon\n *    refusal, so either wrong writer fails at bridge startup;\n *  - `writeFramed` is async and takes `{text, submit}`, and is used ONLY by\n *    `handleMessage`, which never touches a picker.\n */\nexport interface AnswerDeps {\n\t/**\n\t * Raw, unframed, ACKNOWLEDGED pty write. MUST be the composition-root adapter\n\t * around `writeAcknowledgedInputToSession` from `../terminal/terminal`; its\n\t * `prepare` method is bound to host.db in THIS process so a detached session is\n\t * adopted headlessly before the answer lease and final identity check. The\n\t * runtime marker prevents wiring paste framing or fire-and-forget input.\n\t */\n\twriteInput: RawWriteFn;\n\t/**\n\t * Paste-framed write, for `/v1/message` ONLY. Deliberately a different shape\n\t * (async, `{text, submit}`) so it cannot be swapped with `writeInput`. Never\n\t * reachable from the injector.\n\t *\n\t * `terminalId` / `workspaceId` are HOST.DB ids from `resolveHostTerminal`, not\n\t * wire handles — the field names are the pty writer's, and the writer looks\n\t * them up in its live session map.\n\t *\n\t * NOTE, because the header comment on `handleMessage` used to get this wrong:\n\t * `submit: true` appends `\\r` OUTSIDE the bracketed-paste frame. The body is\n\t * inert against a picker; that `\\r` is not. (MESSAGE-ECHO) is why the message\n\t * path calls this TWICE — once with `submit: false` for the body, and once\n\t * with an empty body and `submit: true` for the commit, with a positive screen\n\t * check in between.\n\t */\n\twriteFramed(input: {\n\t\tterminalId: string;\n\t\tworkspaceId: string;\n\t\ttext: string;\n\t\tsubmit: boolean;\n\t}): Promise<{ success: true } | { error: string }>;\n\t/**\n\t * The terminal's VISIBLE VIEWPORT as plain text. Guard 5's source.\n\t *\n\t * Viewport, not buffer: Claude Code renders inline in the normal buffer, so a\n\t * whole-buffer snapshot carries up to 1 000 lines of scrollback containing\n\t * every earlier picker render, and guard 5 would confirm against one of those.\n\t */\n\tsnapshotScreen(terminalId: TerminalId): Promise<string>;\n\n\tlocks: TerminalLockRegistry;\n\tleases: LeaseRegistry;\n\t/**\n\t * (ANSWER-LEDGER) The durable idempotency + status ledger, and the fence that\n\t * closes the status/answer race. It replaced a JSON store that sat here beside\n\t * it during the migration; there is only one now.\n\t */\n\tledger: AttemptLedger;\n\tmessageAttempts: MessageAttemptStore;\n\tquestions: QuestionStore;\n\taudit: AuditLog;\n\tnow(): EpochMs;\n\t/**\n\t * When THIS bridge lifetime began — the same value `HeartbeatResponse`\n\t * carries (§6.3). `/v1/answer/status` reports it so a client can tell \"no\n\t * record because it never arrived\" from \"no record because this bridge is\n\t * younger than the write\". It is a constant per mount, not a clock.\n\t */\n\tbridgeStartedMs: EpochMs;\n\n\t/**\n\t * Maps an OPAQUE wire terminal handle (§0.1) back to the host.db ids the pty\n\t * writer actually understands. `null` => refuse; never guessed.\n\t *\n\t * Both ids come back together on purpose. They were previously resolved\n\t * separately, and the answer path ended up calling the pty writer with the\n\t * WIRE HANDLE as `terminalId` and the real host id as `workspaceId` — a pair\n\t * that can never match a live session, so every answer failed\n\t * `Terminal session not found` while looking like a guard problem. `TerminalId`\n\t * is a `string` alias, so nothing in the type system catches that; resolving\n\t * the pair in one call is what makes it unrepresentable.\n\t */\n\tresolveHostTerminal(terminalId: TerminalId): Promise<HostTerminalRef | null>;\n\n\t/** Current agent binding, used only by `/v1/message`. */\n\tagentBinding(terminalId: TerminalId): Promise<TerminalAgentInfo | null>;\n\n\t/** Whether the pty session is alive, used only by `/v1/message`. */\n\tsessionActive(terminalId: TerminalId): Promise<GuardSourceResult>;\n\n\t/** Current permission-axis latch, used only to keep `/v1/message` off pickers. */\n\tpermissionAxisLatched(terminalId: TerminalId): Promise<GuardSourceResult>;\n\n\t/** Structured diagnostics. Never carries question or answer text. */\n\tlog(event: Record<string, unknown>): void;\n}\n\n/**\n * One probe per distinct writer function, not one per request.\n *\n * The composition root SHOULD call `assertAnswerDeps` at bridge start so the\n * acknowledged-writer marker is checked before the first answer of the day.\n */\nconst rawWriters = new WeakMap<RawWriteFn, RawPtyWriter>();\n\nfunction rawWriterFor(deps: AnswerDeps): RawPtyWriter {\n\tconst existing = rawWriters.get(deps.writeInput);\n\tif (existing !== undefined) return existing;\n\tconst writer = createRawPtyWriter(deps.writeInput);\n\trawWriters.set(deps.writeInput, writer);\n\treturn writer;\n}\n\n/**\n * Startup check for the composition root. Proves the raw writer is the raw\n * writer before any question can be answered, and fails loud if it is not.\n */\nexport function assertAnswerDeps(deps: AnswerDeps): void {\n\trawWriterFor(deps);\n\tif (typeof deps.writeFramed !== \"function\") {\n\t\tthrow new Error(\n\t\t\t\"(COMPANION-BRIDGE) answer deps: writeFramed must be writeFramedInputToSession — /v1/message needs paste framing\",\n\t\t);\n\t}\n\tif (typeof deps.snapshotScreen !== \"function\") {\n\t\tthrow new Error(\n\t\t\t\"(COMPANION-BRIDGE) answer deps: snapshotScreen is required for /v1/message picker checks\",\n\t\t);\n\t}\n}\n\n// ---------------------------------------------------------------------------\n// message-path screen helpers\n// ---------------------------------------------------------------------------\n\n/** Squashed characters used to identify the item's header. */\nconst SCREEN_HEADER_ANCHOR_CHARS = 12;\n\n/** Squashed characters used when an item has no usable header. */\nconst SCREEN_QUESTION_ANCHOR_CHARS = 24;\n\n/** Minimum prompt anchor length accepted as evidence by `/v1/message`. */\nconst SCREEN_MIN_ANCHOR_CHARS = 8;\n\ntype PromptMatchReason =\n\t| \"match\"\n\t| \"empty_screen\"\n\t| \"anchor_absent\"\n\t| \"anchor_too_weak\";\n\ninterface PromptScreenMatch {\n\tok: boolean;\n\treason: PromptMatchReason;\n}\n\n/** Lowercase and strip ALL whitespace: immune to indentation and hard wraps. */\nfunction squash(text: string): string {\n\treturn text.toLowerCase().replace(/\\s+/g, \"\");\n}\n\n/**\n * How many adjacent screen lines a single logical row may be assembled from.\n *\n * Squashing strips newlines too, so squashing the WHOLE screen lets an anchor be\n * assembled from fragments on lines that are nowhere near each other — the digit\n * from one place, the label from another. Two is the smallest window that still\n * tolerates the emulator hard-wrapping one long row across a column boundary,\n * which is the reason whitespace is stripped in the first place.\n */\nconst SCREEN_LINE_WINDOW = 2;\n\n/**\n * The screen as a set of squashed, overlapping line windows.\n *\n * A match must lie WITHIN one window, so a row cannot be built out of text from\n * opposite ends of the buffer. Any match contained in a single line is also\n * contained in the window that starts at that line, so nothing that used to\n * match legitimately stops matching.\n *\n * `windowLines` is a parameter because the needle's own height varies: a picker\n * row is one line (plus wrap slack), while (MESSAGE-ECHO) searches for a message\n * the user may have written across several. Callers that omit it get the picker\n * default and are unaffected.\n */\nfunction squashedWindows(\n\tscreen: string,\n\twindowLines: number = SCREEN_LINE_WINDOW,\n): string[] {\n\tconst lines = screen.split(\"\\n\");\n\t// NO whole-screen special case for short screens. It returned a single window\n\t// covering everything, which breaks the invariant every caller relies on —\n\t// window i starts at line i — so a two-line screen could not match a row that\n\t// was plainly on it. The general loop below handles any length.\n\tconst windows: string[] = [];\n\t// EVERY line starts a window, including the last one (whose window is just\n\t// itself). Stopping a line early left the final line unable to START a window,\n\t// which was invisible while the row pattern was an unanchored substring search\n\t// — the row could still be found inside the previous line's window — and became\n\t// a refusal the moment (GUARD5-ROW-ANCHOR) required the row to begin its\n\t// window. A picker whose last option is the last line of the viewport is\n\t// ordinary, not suspicious.\n\tfor (let i = 0; i < lines.length; i += 1) {\n\t\twindows.push(squash(lines.slice(i, i + windowLines).join(\"\")));\n\t}\n\treturn windows;\n}\n\nfunction anyWindowIncludes(\n\twindows: readonly string[],\n\tneedle: string,\n): boolean {\n\treturn windows.some((window) => window.includes(needle));\n}\n\nfunction anchorOf(text: string, maxChars: number): string {\n\treturn squash(text).slice(0, maxChars);\n}\n\n/**\n * Prompt anchor used only to refuse `/v1/message` when a recently retired\n * question may still be rendered. Short anchors are inconclusive.\n */\nfunction promptAnchor(item: QuestionItem): string {\n\tconst header = anchorOf(item.header, SCREEN_HEADER_ANCHOR_CHARS);\n\tif (header.length >= SCREEN_MIN_ANCHOR_CHARS) return header;\n\tconst question = anchorOf(item.question, SCREEN_QUESTION_ANCHOR_CHARS);\n\tif (question.length >= SCREEN_MIN_ANCHOR_CHARS) return question;\n\treturn \"\";\n}\n\nfunction matchPromptOnScreen(input: {\n\tscreen: string;\n\titem: QuestionItem;\n}): PromptScreenMatch {\n\tconst windows = squashedWindows(input.screen);\n\tif (windows.every((window) => window.length === 0)) {\n\t\treturn { ok: false, reason: \"empty_screen\" };\n\t}\n\n\tconst anchor = promptAnchor(input.item);\n\tif (anchor.length === 0) {\n\t\treturn { ok: false, reason: \"anchor_too_weak\" };\n\t}\n\tif (!anyWindowIncludes(windows, anchor)) {\n\t\treturn { ok: false, reason: \"anchor_absent\" };\n\t}\n\treturn { ok: true, reason: \"match\" };\n}\n\n/**\n * (GUARD5-ANCHOR / PICKER-CHROME) Does the viewport show the STRUCTURE of a\n * picker — a run of numbered rows in ascending digit order starting at 1?\n *\n * Nothing in this function comes from a capture: it is the only screen evidence\n * the bridge has that no caller can parameterise. It is deliberately used ONLY\n * where a false positive is a refusal:\n *   - `/v1/message`, where a picker on screen must block the trailing `\\r`.\n * It is NOT used to permit anything.\n *\n * IT ERRS TOWARD MATCHING, deliberately and asymmetrically. A false positive\n * costs one refused message, which the user retries or types at the desk. A\n * false NEGATIVE writes a bare `\\r` into an open picker, which toggles a\n * multi-select row or submits an N-question review screen irreversibly. So the\n * two bounds that used to make this miss ordinary renders are gone:\n *\n *  - there is NO cap on the distance between consecutive rows. A cap of two\n *    lines was measured to miss a picker whose first option label WRAPPED across\n *    three lines, and a picker with two blank lines between rows. Ascending\n *    digit order across the whole viewport is the structure being looked for;\n *    the gap was never part of it.\n *  - leading decoration is unbounded (`[^0-9A-Za-z]*`) rather than capped at\n *    eight characters, so box drawing plus a selection caret plus deep\n *    indentation cannot push the digit out of reach. The character class still\n *    cannot cross a letter or another digit, so this does not match mid-line\n *    numbers.\n *\n * An agent that printed an ordinary numbered list still matches, and that is\n * still the correct trade.\n */\nexport const PICKER_CHROME_MIN_ROWS = 2;\nconst PICKER_CHROME_ROW = /^[^0-9A-Za-z]*([1-9])[.)\\]:]?\\s+\\S/;\n\nexport function screenShowsPickerChrome(screen: string): boolean {\n\tconst lines = screen.split(\"\\n\");\n\t/** Which digit the run expects next. */\n\tlet expected = 1;\n\tlet run = 0;\n\tfor (let i = 0; i < lines.length; i += 1) {\n\t\tconst line = lines[i];\n\t\tif (line === undefined) continue;\n\t\tconst match = PICKER_CHROME_ROW.exec(line);\n\t\tif (match === null) continue;\n\t\tconst digit = Number(match[1]);\n\t\tif (run > 0 && digit === expected) {\n\t\t\trun += 1;\n\t\t\texpected += 1;\n\t\t\tif (run >= PICKER_CHROME_MIN_ROWS) return true;\n\t\t\tcontinue;\n\t\t}\n\t\tif (digit === 1) {\n\t\t\trun = 1;\n\t\t\texpected = 2;\n\t\t\tif (run >= PICKER_CHROME_MIN_ROWS) return true;\n\t\t}\n\t\t// A numbered line that neither continues the run nor starts one is IGNORED,\n\t\t// not treated as the end of the run. Resetting here was a third way to miss\n\t\t// a wrapped label, on top of the gap cap and the decoration cap: a\n\t\t// continuation line reading \"   3 tables and rebuilding every index\" matches\n\t\t// this row pattern with digit 3, and between rows 1 and 2 that reset dropped\n\t\t// the run and the picker went undetected. Skipping instead can only ever\n\t\t// ADD matches, which on this detector is the refusing direction.\n\t}\n\treturn false;\n}\n\n/**\n * Checks whether a recently retired question's prompt remains visible. Used\n * only by `/v1/message` in the refusing direction; option rows are irrelevant.\n */\nfunction matchPromptStillOnScreen(input: {\n\tscreen: string;\n\titem: QuestionItem;\n}): PromptScreenMatch {\n\treturn matchPromptOnScreen(input);\n}\n\n/** The sealed codes this module is allowed to emit. A closed set, per §10. */\ntype SealedCode =\n\t| \"stale_question\"\n\t| \"already_resolved\"\n\t| \"lease_held\"\n\t| \"guard_failed\"\n\t| \"picker_open\"\n\t| \"capability_unsupported\"\n\t/** (ANSWER-LEDGER) The fence. See where it is thrown for why not `already_resolved`. */\n\t| \"request_closed\"\n\t| \"write_disabled\"\n\t| \"bad_request\"\n\t| \"internal\";\n\nfunction sealed(\n\tstatusCode: number,\n\tcode: SealedCode,\n\tmessage: string,\n\tdetail: Record<string, unknown> | null = null,\n): SealedError {\n\treturn new SealedError(statusCode, {\n\t\tcode,\n\t\tmessage,\n\t\tretryAfterMs: null,\n\t\tdetail,\n\t});\n}\n\n/**\n * Maps a pure encoding failure. Every one of these provably wrote nothing: the\n * encoder runs before the lock is taken and touches no terminal.\n */\nfunction sealedFromEncoding(error: KeystrokeEncodingError): SealedError {\n\tif (error.reason === \"shape_unproven\") {\n\t\treturn sealed(\n\t\t\t501,\n\t\t\t\"capability_unsupported\",\n\t\t\t\"this prompt shape has no proven byte sequence and is refused rather than guessed; answer it at the desk\",\n\t\t\t{ capability: \"answer.multiselect\", reason: error.reason },\n\t\t);\n\t}\n\treturn sealed(400, \"bad_request\", error.message, { reason: error.reason });\n}\n\n// ---------------------------------------------------------------------------\n// idempotency\n// ---------------------------------------------------------------------------\n//\n// (ANSWER-LEDGER) The ~900-line JSON attempt store that used to live here — its\n// `answer-attempts.json`, its rise-only witness, its quarantine and degrade\n// paths, its PRUNE-FLOOR and STORE-CLOSED guards — is gone. `attempt-ledger.ts`\n// replaced it with a table and a transaction.\n//\n// It was not deleted for being untidy. It could not close the race it existed to\n// describe: a status read can overtake an admitted answer, and deciding between\n// them needs an atomic compare-and-set that a read-modify-rewrite of a file\n// cannot provide. Every mechanism above was in service of DETECTING that the file\n// had rolled back, which was a true and useless thing to know.\n//\n// Two accepted weaknesses went with it. Its durability rested on an undocumented\n// inference about NTFS rename ordering (see `writeFileDurable`); SQLite's is\n// documented, and asserted at FULL. And it validated the file as a WHOLE, so one\n// incoherent record quarantined every other record's 24 hours — rows validate\n// individually now, so a corrupt row costs exactly one requestId its status.\n//\n// The message path keeps its own small in-memory store below: a message has no\n// question and no lease, and it makes no coverage claim, so it needs none of this.\n\n/**\n * §7.5 — the message path's own idempotency record. Kept separate from\n * `AnswerAttemptRecord` rather than folded into it: a message has no question\n * and no lease, and inventing empty values for those would put fiction into the\n * audit trail the residual race (§11.7) depends on.\n */\nexport interface MessageAttemptRecord {\n\trequestId: RequestId;\n\tterminalId: TerminalId;\n\tstartedAtMs: EpochMs;\n\tstatus: \"sent\" | \"unconfirmed\" | \"failed\";\n\tsentAtMs: EpochMs | null;\n}\n\nexport interface MessageAttemptStore {\n\tget(requestId: RequestId): MessageAttemptRecord | null;\n\tput(record: MessageAttemptRecord): void;\n\tprune(nowMs: EpochMs): number;\n}\n\nexport function createMessageAttemptStore(\n\toptions: { retentionMs?: DurationMs } = {},\n): MessageAttemptStore {\n\tconst retentionMs = options.retentionMs ?? ANSWER_ATTEMPT_RETENTION_MS;\n\tconst records = new Map<RequestId, MessageAttemptRecord>();\n\treturn {\n\t\tget(requestId) {\n\t\t\treturn records.get(requestId) ?? null;\n\t\t},\n\t\tput(record) {\n\t\t\trecords.set(record.requestId, record);\n\t\t},\n\t\tprune(nowMs) {\n\t\t\tlet dropped = 0;\n\t\t\tfor (const [requestId, record] of [...records]) {\n\t\t\t\tif (nowMs - record.startedAtMs <= retentionMs) continue;\n\t\t\t\trecords.delete(requestId);\n\t\t\t\tdropped += 1;\n\t\t\t}\n\t\t\treturn dropped;\n\t\t},\n\t};\n}\n\n// ---------------------------------------------------------------------------\n// POST /v1/answer\n// ---------------------------------------------------------------------------\n\n/**\n * Advances the durable claim and reads it back from the DB before reporting\n * success. A PTY acknowledgement proves where the bytes went; only this readback\n * proves the outcome survived. Callers downgrade landed bytes to `unconfirmed`\n * when this returns false, while the original `in_flight` claim remains a fence.\n */\nasync function recordOutcome(\n\tdeps: AnswerDeps,\n\trecord: AnswerAttemptRecord,\n): Promise<boolean> {\n\ttry {\n\t\tif (record.status === \"in_flight\") return true;\n\t\tdeps.ledger.recordOutcome({\n\t\t\trequestId: record.requestId,\n\t\t\tstatus: record.status,\n\t\t\tresolvedAtMs: record.resolvedAtMs,\n\t\t\tfailureCode: record.failureCode,\n\t\t\tguardsPassed: record.guardsPassed,\n\t\t\tleaseId: record.leaseId,\n\t\t});\n\t\tconst durable = deps.ledger.get(record.requestId);\n\t\tif (durable?.status !== record.status) {\n\t\t\tthrow new Error(\n\t\t\t\t`ledger outcome verification read ${durable?.status ?? \"missing\"}, expected ${record.status}`,\n\t\t\t);\n\t\t}\n\t\treturn true;\n\t} catch (error) {\n\t\tdeps.log({\n\t\t\tevent: \"companion.answer.attempt_persist_failed\",\n\t\t\trequestId: record.requestId,\n\t\t\tquestionId: record.questionId,\n\t\t\tstatus: record.status,\n\t\t\terror: error instanceof Error ? error.message : String(error),\n\t\t});\n\t\treturn false;\n\t}\n}","numLines":650,"startLine":1,"totalLines":2361}},"sourceToolAssistantUUID":"c93fcfb7-9204-4ac7-b0be-6d63b338b1d7","session_id":"41b65f55-7b51-4cfd-82d1-d1d1eec49d91","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\khair\\Code Projects\\fork-superset-windows-arm64","sessionId":"41b65f55-7b51-4cfd-82d1-d1d1eec49d91","version":"2.1.226","gitBranch":"main","slug":"jolly-singing-lemur"}
