UENCE_DEADLINE_MS).toBe(170_000);\n671\t\t});\n672\t});\n673\t\n674\tdescribe(\"(ANSWER-GUARDLESS) direct PTY injection\", () => {\n675\t\tit(\"confirms successful writes without consulting transcript, screen, session, binding, permission, or marker sources\", async () => {\n676\t\t\tlet now = 1_000;\n677\t\t\tconst written: string[] = [];\n678\t\t\tconst writer = testWriter((data) => {\n679\t\t\t\twritten.push(data);\n680\t\t\t\treturn { success: true };\n681\t\t\t});\n682\t\t\tconst forbidden = () => {\n683\t\t\t\tthrow new Error(\"legacy guard source was consulted\");\n684\t\t\t};\n685\t\t\tconst deps = stubDeps({\n686\t\t\t\tnow: () => now++,\n687\t\t\t\tleases: testLeases(() => ({\n688\t\t\t\t\tok: true as const,\n689\t\t\t\t\tlease: {\n690\t\t\t\t\t\t...LEASE,\n691\t\t\t\t\t\texpiresAtMs: now + MAX_SEQUENCE_DEADLINE_MS,\n692\t\t\t\t\t},\n693\t\t\t\t})),\n694\t\t\t\tsnapshotScreen: forbidden,\n695\t\t\t\tsessionActive: forbidden,\n696\t\t\t\tagentBinding: forbidden,\n697\t\t\t\tpermissionAxisLatched: forbidden,\n698\t\t\t});\n699\t\n700\t\t\tconst result = await run(writer, deps);\n701\t\n702\t\t\texpect(result).toEqual({ kind: \"confirmed\" });\n703\t\t\texpect(written).toEqual([\"1\", \"\\r\"]);\n704\t\t});\n705\t\n706\t\tit(\"queues the whole sequence in one legacy frame before reporting an unknown v2 outcome\", async () => {\n707\t\t\tconst queued: string[] = [];\n708\t\t\tconst writer = testWriter((data) => {\n709\t\t\t\tqueued.push(data);\n710\t\t\t\treturn {\n711\t\t\t\t\terror: \"daemon protocol 2 cannot acknowledge input\",\n712\t\t\t\t\twriteOutcome: \"unknown\",\n713\t\t\t\t};\n714\t\t\t});\n715\t\n716\t\t\texpect(await run(writer, stubDeps(), false)).toMatchObject({\n717\t\t\t\tkind: \"unconfirmed\",\n718\t\t\t\twritten: 0,\n719\t\t\t\tabortedAt: KEYSTROKES.length,\n720\t\t\t\twriteOutcome: \"unknown\",\n721\t\t\t});\n722\t\t\texpect(queued).toEqual([KEYSTROKES.map((key) => key.data).join(\"\")]);\n723\t\t});\n724\t\n725\t\tit(\"reports an acknowledged writer rejection as a zero-write failure\", async () => {\n726\t\t\tconst writer = createRawPtyWriter(\n727\t\t\t\tObject.assign(\n728\t\t\t\t\tasync () => {\n729\t\t\t\t\t\tthrow new Error(\"daemon disconnected\");\n730\t\t\t\t\t},\n731\t\t\t\t\t{\n732\t\t\t\t\t\twriterKind: RAW_PTY_WRITER_KIND,\n733\t\t\t\t\t\tprepare: async () => ({\n734\t\t\t\t\t\t\tacknowledgedInputSupported: true,\n735\t\t\t\t\t\t\tsuccess: true as const,\n736\t\t\t\t\t\t}),\n737\t\t\t\t\t},\n738\t\t\t\t),\n739\t\t\t);\n740\t\n741\t\t\texpect(await run(writer)).toMatchObject({\n742\t\t\t\tkind: \"unconfirmed\",\n743\t\t\t\twritten: 0,\n744\t\t\t\tabortedAt: 0,\n745\t\t\t\twriteOutcome: \"unknown\",\n746\t\t\t\treason: \"pty write threw\",\n747\t\t\t});\n748\t\t});\n749\t\n750\t\tit(\"reports a known zero-write refusal without fabricating guard evidence\", async () => {\n751\t\t\tconst writer = testWriter(() => ({\n752\t\t\t\terror: \"pty unavailable\",\n753\t\t\t\twriteOutcome: \"not_written\",\n754\t\t\t}));\n755\t\n756\t\t\tconst result = await run(writer);\n757\t\n758\t\t\texpect(result).toMatchObject({\n759\t\t\t\tkind: \"unconfirmed\",\n760\t\t\t\twritten: 0,\n761\t\t\t\tabortedAt: 0,\n762\t\t\t\treason: \"pty write refused: pty unavailable\",\n763\t\t\t});\n764\t\t});\n765\t\n766\t\tit(\"reports only an actual PTY write refusal after partial input\", async () => {\n767\t\t\tlet writes = 0;\n768\t\t\tconst writer = testWriter(() => {\n769\t\t\t\twrites += 1;\n770\t\t\t\treturn writes === 1\n771\t\t\t\t\t? { success: true }\n772\t\t\t\t\t: { error: \"pty unavailable\", writeOutcome: \"not_written\" };\n773\t\t\t});\n774\t\n775\t\t\tconst result = await run(writer);\n776\t\n777\t\t\texpect(result).toMatchObject({\n778\t\t\t\tkind: \"unconfirmed\",\n779\t\t\t\twritten: 1,\n780\t\t\t\tabortedAt: 1,\n781\t\t\t\treason: \"pty write refused: pty unavailable\",\n782\t\t\t});\n783\t\t});\n784\t});\n785\t\n786\t// ---------------------------------------------------------------------------\n787\t// (ANSWER-GUARDLESS) the REPLAY contract\n788\t//\n789\t// A durable ledger row has no abstain column and, since the guard stack was\n790\t// removed, no guard evaluation to reconstruct either. `ledgerRecordToResponse`\n791\t// is the only place a §11.4 replay decides what to say about that, and it is a\n792\t// pure record-to-response mapper, so the derivation is pinned here.\n793\t// ---------------------------------------------------------------------------\n794\t\n795\tfunction ledgerRow(overrides: Partial<LedgerRecord> = {}): LedgerRecord {\n796\t\treturn {\n797\t\t\trequestId:\n798\t\t\t\t\"00000000-0000-4000-8000-000000000001\" as LedgerRecord[\"requestId\"],\n799\t\t\tstatus: \"confirmed\",\n800\t\t\tquestionId: \"q-guardless\",\n801\t\t\tdeviceId: \"device-guardless\",\n802\t\t\tsurface: \"phone\",\n803\t\t\tleaseId: \"lease-guardless\",\n804\t\t\tstartedAtMs: 1 as LedgerRecord[\"startedAtMs\"],\n805\t\t\tcreatedAtMs: 1 as LedgerRecord[\"createdAtMs\"],\n806\t\t\tresolvedAtMs: 2 as LedgerRecord[\"resolvedAtMs\"],\n807\t\t\tfailureCode: null,\n808\t\t\tguardsPassed: [],\n809\t\t\tcoverageEpoch: \"epoch-1\",\n810\t\t\t...overrides,\n811\t\t};\n812\t}\n813\t\n814\tdescribe(\"(ANSWER-GUARDLESS) a replayed answer\", () => {\n815\t\tit(\"reports nothing abstained on a confirmed row\", () => {\n816\t\t\tconst response = ledgerRecordToResponse(ledgerRow());\n817\t\n818\t\t\texpect(response.status).toBe(\"confirmed\");\n819\t\t\texpect(response.resolvedAtMs).toBe(2 as LedgerRecord[\"resolvedAtMs\"]);\n820\t\t\texpect(response.guardsPassed).toEqual([]);\n821\t\t\texpect(response.guardsAbstained).toEqual([]);\n822\t\t});\n823\t\n824\t\tit(\"says it CANNOT SAY for a row that is not confirmed — never []\", () => {\n825\t\t\tconst response = ledgerRecordToResponse(\n826\t\t\t\tledgerRow({ status: \"unconfirmed\", resolvedAtMs: null }),\n827\t\t\t);\n828\t\n829\t\t\texpect(response.status).toBe(\"unconfirmed\");\n830\t\t\texpect(response.resolvedAtMs).toBeNull();\n831\t\t\texpect(response.guardsAbstained).toBeNull();\n832\t\t});\n833\t\n834\t\tit(\"replays a legacy row's stored guard evidence without inferring new outcomes\", () => {\n835\t\t\t// Rows written by an older bridge still name the guards that build\n836\t\t\t// evaluated. They are reported verbatim, and nothing is derived from which\n837\t\t\t// guards are absent.\n838\t\t\tconst response = ledgerRecordToResponse(\n839\t\t\t\tledgerRow({ guardsPassed: [\"transcript\", \"screen\", \"session\"] }),\n840\t\t\t);\n841\t\n842\t\t\texpect(response.guardsPassed).toEqual([\"transcript\", \"screen\", \"session\"]);\n843\t\t\texpect(response.guardsAbstained).toEqual([]);\n844\t\t});\n845\t\n846\t\tit(\"reports an absent lease as absent rather than inventing one\", () => {\n847\t\t\t// The claim is made before the lease is acquired, so a row whose attempt\n848\t\t\t// died between the two has no lease to report.\n849\t\t\tconst response = ledgerRecordToResponse(\n850\t\t\t\tledgerRow({ status: \"failed\", leaseId: null, questionId: null }),\n851\t\t\t);\n852\t\n853\t\t\texpect(response.status).toBe(\"unconfirmed\");\n854\t\t\texpect(response.leaseId).toBe(\"\");\n855\t\t\texpect(response.questionId).toBe(\"\");\n856\t\t});\n857\t});\n858\t"}]},"uuid":"841ab464-d461-4b84-8b8a-b2d4fafc4c65","timestamp":"2026-08-12T17:57:36.698Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\khair\\Code Projects\\fork-superset-windows-arm64\\packages\\host-service\\src\\companion\\answer-guardless.test.ts","content":"\t\t});\n\t\tconst writer = testWriter((data) => {\n\t\t\tevents.push(`write:${JSON.stringify(data)}`);\n\t\t\treturn { success: true };\n\t\t});\n\n\t\tawait expect(run(writer, deps)).rejects.toThrow(\"timer unavailable\");\n\t\texpect(events).toEqual([\n\t\t\t\"extend\",\n\t\t\t'write:\"1\"',\n\t\t\t`delay:${ANSWER_INTER_FRAME_DELAY_MS}`,\n\t\t]);\n\t});\n\n\tit(\"stops on a lease failure immediately after the inter-frame wait\", async () => {\n\t\tconst events: string[] = [];\n\t\tlet extensions = 0;\n\t\tconst deps = stubDeps({\n\t\t\tdelay: async (ms) => {\n\t\t\t\tevents.push(`delay:${ms}`);\n\t\t\t},\n\t\t\tleases: testLeases(() => {\n\t\t\t\textensions += 1;\n\t\t\t\tevents.push(\"extend\");\n\t\t\t\treturn extensions === 1\n\t\t\t\t\t? { ok: true as const, lease: LEASE }\n\t\t\t\t\t: { ok: false as const, reason: \"expired\" as const };\n\t\t\t}),\n\t\t});\n\t\tconst writer = testWriter((data) => {\n\t\t\tevents.push(`write:${JSON.stringify(data)}`);\n\t\t\treturn { success: true };\n\t\t});\n\n\t\texpect(await run(writer, deps)).toMatchObject({\n\t\t\tkind: \"unconfirmed\",\n\t\t\treason: \"lease expired\",\n\t\t\twritten: 1,\n\t\t\tabortedAt: 1,\n\t\t});\n\t\texpect(events).toEqual([\n\t\t\t\"extend\",\n\t\t\t'write:\"1\"',\n\t\t\t`delay:${ANSWER_INTER_FRAME_DELAY_MS}`,\n\t\t\t\"extend\",\n\t\t]);\n\t});\n\n\tit(\"bounds the maximum legal encoded sequence and its pacing deadline\", () => {\n\t\texpect(MAX_ENCODED_ANSWER_FRAMES).toBe(321);\n\t\texpect(MAX_SEQUENCE_DEADLINE_MS).toBe(170_000);\n\t});\n});\n\ndescribe(\"(ANSWER-GUARDLESS) direct PTY injection\", () => {\n\tit(\"confirms successful writes without consulting transcript, screen, session, binding, permission, or marker sources\", async () => {\n\t\tlet now = 1_000;\n\t\tconst written: string[] = [];\n\t\tconst writer = testWriter((data) => {\n\t\t\twritten.push(data);\n\t\t\treturn { success: true };\n\t\t});\n\t\tconst forbidden = () => {\n\t\t\tthrow new Error(\"legacy guard source was consulted\");\n\t\t};\n\t\tconst deps = stubDeps({\n\t\t\tnow: () => now++,\n\t\t\tleases: testLeases(() => ({\n\t\t\t\tok: true as const,\n\t\t\t\tlease: {\n\t\t\t\t\t...LEASE,\n\t\t\t\t\texpiresAtMs: now + MAX_SEQUENCE_DEADLINE_MS,\n\t\t\t\t},\n\t\t\t})),\n\t\t\tsnapshotScreen: forbidden,\n\t\t\tsessionActive: forbidden,\n\t\t\tagentBinding: forbidden,\n\t\t\tpermissionAxisLatched: forbidden,\n\t\t});\n\n\t\tconst result = await run(writer, deps);\n\n\t\texpect(result).toEqual({ kind: \"confirmed\" });\n\t\texpect(written).toEqual([\"1\", \"\\r\"]);\n\t});\n\n\tit(\"queues the whole sequence in one legacy frame before reporting an unknown v2 outcome\", async () => {\n\t\tconst queued: string[] = [];\n\t\tconst writer = testWriter((data) => {\n\t\t\tqueued.push(data);\n\t\t\treturn {\n\t\t\t\terror: \"daemon protocol 2 cannot acknowledge input\",\n\t\t\t\twriteOutcome: \"unknown\",\n\t\t\t};\n\t\t});\n\n\t\texpect(await run(writer, stubDeps(), false)).toMatchObject({\n\t\t\tkind: \"unconfirmed\",\n\t\t\twritten: 0,\n\t\t\tabortedAt: KEYSTROKES.length,\n\t\t\twriteOutcome: \"unknown\",\n\t\t});\n\t\texpect(queued).toEqual([KEYSTROKES.map((key) => key.data).join(\"\")]);\n\t});\n\n\tit(\"reports an acknowledged writer rejection as a zero-write failure\", async () => {\n\t\tconst writer = createRawPtyWriter(\n\t\t\tObject.assign(\n\t\t\t\tasync () => {\n\t\t\t\t\tthrow new Error(\"daemon disconnected\");\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\twriterKind: RAW_PTY_WRITER_KIND,\n\t\t\t\t\tprepare: async () => ({\n\t\t\t\t\t\tacknowledgedInputSupported: true,\n\t\t\t\t\t\tsuccess: true as const,\n\t\t\t\t\t}),\n\t\t\t\t},\n\t\t\t),\n\t\t);\n\n\t\texpect(await run(writer)).toMatchObject({\n\t\t\tkind: \"unconfirmed\",\n\t\t\twritten: 0,\n\t\t\tabortedAt: 0,\n\t\t\twriteOutcome: \"unknown\",\n\t\t\treason: \"pty write threw\",\n\t\t});\n\t});\n\n\tit(\"reports a known zero-write refusal without fabricating guard evidence\", async () => {\n\t\tconst writer = testWriter(() => ({\n\t\t\terror: \"pty unavailable\",\n\t\t\twriteOutcome: \"not_written\",\n\t\t}));\n\n\t\tconst result = await run(writer);\n\n\t\texpect(result).toMatchObject({\n\t\t\tkind: \"unconfirmed\",\n\t\t\twritten: 0,\n\t\t\tabortedAt: 0,\n\t\t\treason: \"pty write refused: pty unavailable\",\n\t\t});\n\t});\n\n\tit(\"reports only an actual PTY write refusal after partial input\", async () => {\n\t\tlet writes = 0;\n\t\tconst writer = testWriter(() => {\n\t\t\twrites += 1;\n\t\t\treturn writes === 1\n\t\t\t\t? { success: true }\n\t\t\t\t: { error: \"pty unavailable\", writeOutcome: \"not_written\" };\n\t\t});\n\n\t\tconst result = await run(writer);\n\n\t\texpect(result).toMatchObject({\n\t\t\tkind: \"unconfirmed\",\n\t\t\twritten: 1,\n\t\t\tabortedAt: 1,\n\t\t\treason: \"pty write refused: pty unavailable\",\n\t\t});\n\t});\n});\n\n// ---------------------------------------------------------------------------\n// (ANSWER-GUARDLESS) the REPLAY contract\n//\n// A durable ledger row has no abstain column and, since the guard stack was\n// removed, no guard evaluation to reconstruct either. `ledgerRecordToResponse`\n// is the only place a §11.4 replay decides what to say about that, and it is a\n// pure record-to-response mapper, so the derivation is pinned here.\n// ---------------------------------------------------------------------------\n\nfunction ledgerRow(overrides: Partial<LedgerRecord> = {}): LedgerRecord {\n\treturn {\n\t\trequestId:\n\t\t\t\"00000000-0000-4000-8000-000000000001\" as LedgerRecord[\"requestId\"],\n\t\tstatus: \"confirmed\",\n\t\tquestionId: \"q-guardless\",\n\t\tdeviceId: \"device-guardless\",\n\t\tsurface: \"phone\",\n\t\tleaseId: \"lease-guardless\",\n\t\tstartedAtMs: 1 as LedgerRecord[\"startedAtMs\"],\n\t\tcreatedAtMs: 1 as LedgerRecord[\"createdAtMs\"],\n\t\tresolvedAtMs: 2 as LedgerRecord[\"resolvedAtMs\"],\n\t\tfailureCode: null,\n\t\tguardsPassed: [],\n\t\tcoverageEpoch: \"epoch-1\",\n\t\t...overrides,\n\t};\n}\n\ndescribe(\"(ANSWER-GUARDLESS) a replayed answer\", () => {\n\tit(\"reports nothing abstained on a confirmed row\", () => {\n\t\tconst response = ledgerRecordToResponse(ledgerRow());\n\n\t\texpect(response.status).toBe(\"confirmed\");\n\t\texpect(response.resolvedAtMs).toBe(2 as LedgerRecord[\"resolvedAtMs\"]);\n\t\texpect(response.guardsPassed).toEqual([]);\n\t\texpect(response.guardsAbstained).toEqual([]);\n\t});\n\n\tit(\"says it CANNOT SAY for a row that is not confirmed — never []\", () => {\n\t\tconst response = ledgerRecordToResponse(\n\t\t\tledgerRow({ status: \"unconfirmed\", resolvedAtMs: null }),\n\t\t);\n\n\t\texpect(response.status).toBe(\"unconfirmed\");\n\t\texpect(response.resolvedAtMs).toBeNull();\n\t\texpect(response.guardsAbstained).toBeNull();\n\t});\n\n\tit(\"replays a legacy row's stored guard evidence without inferring new outcomes\", () => {\n\t\t// Rows written by an older bridge still name the guards that build\n\t\t// evaluated. They are reported verbatim, and nothing is derived from which\n\t\t// guards are absent.\n\t\tconst response = ledgerRecordToResponse(\n\t\t\tledgerRow({ guardsPassed: [\"transcript\", \"screen\", \"session\"] }),\n\t\t);\n\n\t\texpect(response.guardsPassed).toEqual([\"transcript\", \"screen\", \"session\"]);\n\t\texpect(response.guardsAbstained).toEqual([]);\n\t});\n\n\tit(\"reports an absent lease as absent rather than inventing one\", () => {\n\t\t// The claim is made before the lease is acquired, so a row whose attempt\n\t\t// died between the two has no lease to report.\n\t\tconst response = ledgerRecordToResponse(\n\t\t\tledgerRow({ status: \"failed\", leaseId: null, questionId: null }),\n\t\t);\n\n\t\texpect(response.status).toBe(\"unconfirmed\");\n\t\texpect(response.leaseId).toBe(\"\");\n\t\texpect(response.questionId).toBe(\"\");\n\t});\n});\n","numLines":239,"startLine":620,"totalLines":858}},"sourceToolAssistantUUID":"f94c3da5-c45b-4c1a-a80d-f54dcb191b0d","session_id":"41b65f55-7b51-4cfd-82d1-d1d1eec49d91","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\khair\\Code Projects\\fork-superset-windows-arm64","sessionId":"41b65f55-7b51-4cfd-82d1-d1d1eec49d91","version":"2.1.228","gitBranch":"main","slug":"jolly-singing-lemur"}
