\t\t\t\treason: \"pty write refused: pty unavailable\",\n576\t\t\t});\n577\t\t});\n578\t});\n579\t\n580\t// ---------------------------------------------------------------------------\n581\t// (ANSWER-PACING) deterministic inter-keystroke pacing\n582\t//\n583\t// Proven on real Claude Code 2.1.228: discrete frames written back-to-back are\n584\t// acknowledged in ~1 ms and outrun the picker's own transitions, dropping\n585\t// keystrokes. The delay is pacing, never a guard — these tests pin its exact\n586\t// placement, the lease-extension ordering around it, the widened deadline, and\n587\t// the untouched legacy path.\n588\t// ---------------------------------------------------------------------------\n589\t\n590\tfunction selectDigit(questionIndex: number): Keystroke {\n591\t\treturn {\n592\t\t\tkind: \"select_digit\",\n593\t\t\tdata: \"1\",\n594\t\t\tquestionIndex,\n595\t\t\toptionIndex: 0,\n596\t\t\texpect: { kind: \"item_picker\", itemIndex: questionIndex },\n597\t\t\tsubmits: false,\n598\t\t};\n599\t}\n600\t\n601\tfunction reviewReturn(questionIndex: number): Keystroke {\n602\t\treturn {\n603\t\t\tkind: \"submit_return\",\n604\t\t\tdata: \"\\r\",\n605\t\t\tquestionIndex,\n606\t\t\toptionIndex: null,\n607\t\t\texpect: { kind: \"same_prompt\", itemIndex: questionIndex },\n608\t\t\tsubmits: true,\n609\t\t};\n610\t}\n611\t\n612\t/** N-1 digits then the review return — the single_select_many byte shape. */\n613\tfunction digitSequence(frames: number): Keystroke[] {\n614\t\tconst keystrokes: Keystroke[] = [];\n615\t\tfor (let i = 0; i < frames - 1; i += 1) keystrokes.push(selectDigit(i));\n616\t\tkeystrokes.push(reviewReturn(frames - 1));\n617\t\treturn keystrokes;\n618\t}\n619\t\n620\tfunction pacedHarness(\n621\t\toptions: { waitAdvancesClock?: boolean; failWait?: boolean } = {},\n622\t) {\n623\t\tlet now = 1_000;\n624\t\tconst timeline: string[] = [];\n625\t\tconst events: Record<string, unknown>[] = [];\n626\t\tconst writer = testWriter((data) => {\n627\t\t\ttimeline.push(`write:${JSON.stringify(data)}`);\n628\t\t\treturn { success: true };\n629\t\t});\n630\t\tconst deps = stubDeps({\n631\t\t\tnow: () => now,\n632\t\t\twait: async (ms) => {\n633\t\t\t\ttimeline.push(`wait:${ms}`);\n634\t\t\t\tif (options.failWait) throw new Error(\"timer subsystem gone\");\n635\t\t\t\tif (options.waitAdvancesClock) now += ms;\n636\t\t\t},\n637\t\t\tleases: testLeases((_leaseId, nowMs) => {\n638\t\t\t\ttimeline.push(\"extend\");\n639\t\t\t\treturn {\n640\t\t\t\t\tok: true as const,\n641\t\t\t\t\tlease: { ...LEASE, expiresAtMs: nowMs + 15_000 },\n642\t\t\t\t};\n643\t\t\t}),\n644\t\t\tlog: (event) => events.push(event),\n645\t\t});\n646\t\tconst inject = (keystrokes: Keystroke[], acknowledgedInputSupported = true) =>\n647\t\t\tinjectSequence(deps, {\n648\t\t\t\tquestion: QUESTION,\n649\t\t\t\thost: HOST,\n650\t\t\t\tkeystrokes,\n651\t\t\t\tleaseId: \"lease-guardless\",\n652\t\t\t\tacknowledgedInputSupported,\n653\t\t\t\twriter,\n654\t\t\t});\n655\t\treturn { inject, timeline, events };\n656\t}\n657\t\n658\tdescribe(\"(ANSWER-PACING) deterministic inter-keystroke pacing\", () => {\n659\t\tit(\"sleeps the exact delay after every non-final acknowledged keystroke and never after the final one\", async () => {\n660\t\t\tconst harness = pacedHarness();\n661\t\t\tconst freetext: Keystroke[] = [\n662\t\t\t\t{\n663\t\t\t\t\tkind: \"freetext_open\",\n664\t\t\t\t\tdata: \"2\",\n665\t\t\t\t\tquestionIndex: 0,\n666\t\t\t\t\toptionIndex: 1,\n667\t\t\t\t\texpect: { kind: \"item_picker\", itemIndex: 0 },\n668\t\t\t\t\tsubmits: false,\n669\t\t\t\t},\n670\t\t\t\t{\n671\t\t\t\t\tkind: \"freetext_body\",\n672\t\t\t\t\tdata: \"typed at the wrist\",\n673\t\t\t\t\tquestionIndex: 0,\n674\t\t\t\t\toptionIndex: 1,\n675\t\t\t\t\texpect: { kind: \"same_prompt\", itemIndex: 0 },\n676\t\t\t\t\tsubmits: false,\n677\t\t\t\t},\n678\t\t\t\t{\n679\t\t\t\t\tkind: \"submit_return\",\n680\t\t\t\t\tdata: \"\\r\",\n681\t\t\t\t\tquestionIndex: 0,\n682\t\t\t\t\toptionIndex: 1,\n683\t\t\t\t\texpect: { kind: \"same_prompt\", itemIndex: 0 },\n684\t\t\t\t\tsubmits: true,\n685\t\t\t\t},\n686\t\t\t];\n687\t\n688\t\t\texpect(await harness.inject(freetext)).toEqual({ kind: \"confirmed\" });\n689\t\t\texpect(harness.timeline).toEqual([\n690\t\t\t\t\"extend\",\n691\t\t\t\t'write:\"2\"',\n692\t\t\t\t`wait:${INTER_KEYSTROKE_DELAY_MS}`,\n693\t\t\t\t\"extend\",\n694\t\t\t\t'write:\"typed at the wrist\"',\n695\t\t\t\t`wait:${INTER_KEYSTROKE_DELAY_MS}`,\n696\t\t\t\t\"extend\",\n697\t\t\t\t'write:\"\\\\r\"',\n698\t\t\t]);\n699\t\t});\n700\t\n701\t\tit(\"extends the lease after the delay, immediately before every post-delay write\", async () => {\n702\t\t\tconst harness = pacedHarness();\n703\t\t\tawait harness.inject(digitSequence(3));\n704\t\n705\t\t\tfor (let i = 0; i < harness.timeline.length; i += 1) {\n706\t\t\t\tif (!harness.timeline[i]?.startsWith(\"wait:\")) continue;\n707\t\t\t\texpect(harness.timeline[i + 1]).toBe(\"extend\");\n708\t\t\t\texpect(harness.timeline[i + 2]?.startsWith(\"write:\")).toBe(true);\n709\t\t\t}\n710\t\t});\n711\t\n712\t\tit(\"never paces the legacy protocol-v2 single-frame write\", async () => {\n713\t\t\tconst harness = pacedHarness();\n714\t\t\tawait harness.inject(digitSequence(3), false);\n715\t\n716\t\t\texpect(harness.timeline).toEqual([\"extend\", 'write:\"11\\\\r\"']);\n717\t\t});\n718\t\n719\t\tit(\"widens the deadline by the pacing budget so a long paced sequence still confirms\", async () => {\n720\t\t\t// 25 frames spend 24 × 500 ms = 12 s sleeping — past the bare 10 s write\n721\t\t\t// budget, inside the widened one. Under a fixed deadline this sequence\n722\t\t\t// aborts mid-prompt.\n723\t\t\tconst frames = 25;\n724\t\t\texpect((frames - 1) * INTER_KEYSTROKE_DELAY_MS).toBeGreaterThan(\n725\t\t\t\tSEQUENCE_DEADLINE_MS,\n726\t\t\t);\n727\t\t\tconst harness = pacedHarness({ waitAdvancesClock: true });\n728\t\n729\t\t\texpect(await harness.inject(digitSequence(frames))).toEqual({\n730\t\t\t\tkind: \"confirmed\",\n731\t\t\t});\n732\t\t\texpect(\n733\t\t\t\tharness.timeline.filter((entry) => entry.startsWith(\"write:\")).length,\n734\t\t\t).toBe(frames);\n735\t\t});\n736\t\n737\t\tit(\"still aborts once the widened deadline is genuinely exhausted\", async () => {\n738\t\t\tlet now = 1_000;\n739\t\t\tconst writer = testWriter(() => ({ success: true }));\n740\t\t\tconst deps = stubDeps({\n741\t\t\t\tnow: () => now,\n742\t\t\t\twait: async () => {\n743\t\t\t\t\t// One pathological stall that burns the write budget AND the whole\n744\t\t\t\t\t// pacing budget for this 2-frame sequence.\n745\t\t\t\t\tnow += SEQUENCE_DEADLINE_MS + INTER_KEYSTROKE_DELAY_MS + 1;\n746\t\t\t\t},\n747\t\t\t});\n748\t\n749\t\t\tconst result = await injectSequence(deps, {\n750\t\t\t\tquestion: QUESTION,\n751\t\t\t\thost: HOST,\n752\t\t\t\tkeystrokes: KEYSTROKES,\n753\t\t\t\tleaseId: \"lease-guardless\",\n754\t\t\t\tacknowledgedInputSupported: true,\n755\t\t\t\twriter,\n756\t\t\t});\n757\t\n758\t\t\texpect(result).toMatchObject({\n759\t\t\t\tkind: \"unconfirmed\",\n760\t\t\t\twritten: 1,\n761\t\t\t\tabortedAt: 1,\n762\t\t\t\treason: \"sequence deadline exceeded\",\n763\t\t\t\twriteOutcome: \"not_written\",\n764\t\t\t});\n765\t\t});\n766\t\n767\t\tit(\"logs a throwing pacing sleep and never downgrades the landed writes\", async () => {\n768\t\t\tconst harness = pacedHarness({ failWait: true });\n769\t\n770\t\t\texpect(await harness.inject(digitSequence(2))).toEqual({\n771\t\t\t\tkind: \"confirmed\",\n772\t\t\t});\n773\t\t\texpect(harness.events).toContainEqual(\n774\t\t\t\texpect.objectContaining({\n775\t\t\t\t\tevent: \"companion.answer.pacing_wait_failed\",\n776\t\t\t\t\terror: \"timer subsystem gone\",\n777\t\t\t\t}),\n778\t\t\t);\n779\t\t});\n780\t\n781\t\tit(\"fails loud at startup when the pacing sleep is not wired\", () => {\n782\t\t\texpect(() =>\n783\t\t\t\tassertAnswerDeps({\n784\t\t\t\t\twriteInput: Object.assign(async () => ({ success: true as const }), {\n785\t\t\t\t\t\twriterKind: RAW_PTY_WRITER_KIND,\n786\t\t\t\t\t\tprepare: async () => ({\n787\t\t\t\t\t\t\tsuccess: true as const,\n788\t\t\t\t\t\t\tacknowledgedInputSupported: true,\n789\t\t\t\t\t\t}),\n790\t\t\t\t\t}),\n791\t\t\t\t\tnudgeRepaint: () => ({ success: true as const }),\n792\t\t\t\t\twriteFramed: async () => ({ success: true as const }),\n793\t\t\t\t\tsnapshotScreen: async () => \"\",\n794\t\t\t\t} as unknown as AnswerDeps),\n795\t\t\t).toThrow(\"wait\");\n796\t\t});\n797\t});\n798\t\n799\t// ---------------------------------------------------------------------------\n800\t// (ANSWER-GUARDLESS) the REPLAY contract\n801\t//\n802\t// A durable ledger row has no abstain column and, since the guard stack was\n803\t// removed, no guard evaluation to reconstruct either. `ledgerRecordToResponse`\n804\t// is the only place a §11.4 replay decides what to say about that, and it is a\n805\t// pure record-to-response mapper, so the derivation is pinned here.\n806\t// ---------------------------------------------------------------------------\n807\t\n808\tfunction ledgerRow(overrides: Partial<LedgerRecord> = {}): LedgerRecord {\n809\t\treturn {\n810\t\t\trequestId:\n811\t\t\t\t\"00000000-0000-4000-8000-000000000001\" as LedgerRecord[\"requestId\"],\n812\t\t\tstatus: \"confirmed\",\n813\t\t\tquestionId: \"q-guardless\",\n814\t\t\tdeviceId: \"device-guardless\",\n815\t\t\tsurface: \"phone\",\n816\t\t\tleaseId: \"lease-guardless\",\n817\t\t\tstartedAtMs: 1 as LedgerRecord[\"startedAtMs\"],\n818\t\t\tcreatedAtMs: 1 as LedgerRecord[\"createdAtMs\"],\n819\t\t\tresolvedAtMs: 2 as LedgerRecord[\"resolvedAtMs\"],\n820\t\t\tfailureCode: null,\n821\t\t\tguardsPassed: [],\n822\t\t\tcoverageEpoch: \"epoch-1\",\n823\t\t\t...overrides,\n824\t\t};\n825\t}\n826\t\n827\tdescribe(\"(ANSWER-GUARDLESS) a replayed answer\", () => {\n828\t\tit(\"reports nothing abstained on a confirmed row\", () => {\n829\t\t\tconst response = ledgerRecordToResponse(ledgerRow());\n830\t\n831\t\t\texpect(response.status).toBe(\"confirmed\");\n832\t\t\texpect(response.resolvedAtMs).toBe(2 as LedgerRecord[\"resolvedAtMs\"]);\n833\t\t\texpect(response.guardsPassed).toEqual([]);\n834\t\t\texpect(response.guardsAbstained).toEqual([]);\n835\t\t});\n836\t\n837\t\tit(\"says it CANNOT SAY for a row that is not confirmed — never []\", () => {\n838\t\t\tconst response = ledgerRecordToResponse(\n839\t\t\t\tledgerRow({ status: \"unconfirmed\", resolvedAtMs: null }),\n840\t\t\t);\n841\t\n842\t\t\texpect(response.status).toBe(\"unconfirmed\");\n843\t\t\texpect(response.resolvedAtMs).toBeNull();\n844\t\t\texpect(response.guardsAbstained).toBeNull();\n845\t\t});\n846\t\n847\t\tit(\"replays a legacy row's stored guard evidence without inferring new outcomes\", () => {\n848\t\t\t// Rows written by an older bridge still name the guards that build\n849\t\t\t// evaluated. They are reported verbatim, and nothing is derived from which\n850\t\t\t// guards are absent.\n851\t\t\tconst response = ledgerRecordToResponse(\n852\t\t\t\tledgerRow({ guardsPassed: [\"transcript\", \"screen\", \"session\"] }),\n853\t\t\t);\n854\t\n855\t\t\texpect(response.guardsPassed).toEqual([\"transcript\", \"screen\", \"session\"]);\n856\t\t\texpect(response.guardsAbstained).toEqual([]);\n857\t\t});\n858\t\n859\t\tit(\"reports an absent lease as absent rather than inventing one\", () => {\n860\t\t\t// The claim is made before the lease is acquired, so a row whose attempt\n861\t\t\t// died between the two has no lease to report.\n862\t\t\tconst response = ledgerRecordToResponse(\n863\t\t\t\tledgerRow({ status: \"failed\", leaseId: null, questionId: null }),\n864\t\t\t);\n865\t\n866\t\t\texpect(response.status).toBe(\"unconfirmed\");\n867\t\t\texpect(response.leaseId).toBe(\"\");\n868\t\t\texpect(response.questionId).toBe(\"\");\n869\t\t});\n870\t});\n871\t"}]},"uuid":"ade8cb9e-4044-4cb5-9162-948183dcc933","timestamp":"2026-08-12T17:37:34.231Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\khair\\Code Projects\\fork-superset-windows-arm64\\packages\\host-service\\src\\companion\\answer-guardless.test.ts","content":"\t\tconst writer = createRawPtyWriter(\n\t\t\tObject.assign(\n\t\t\t\tasync () => {\n\t\t\t\t\tthrow new Error(\"daemon disconnected\");\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\twriterKind: RAW_PTY_WRITER_KIND,\n\t\t\t\t\tprepare: async () => ({\n\t\t\t\t\t\tacknowledgedInputSupported: true,\n\t\t\t\t\t\tsuccess: true as const,\n\t\t\t\t\t}),\n\t\t\t\t},\n\t\t\t),\n\t\t);\n\n\t\texpect(await run(writer)).toMatchObject({\n\t\t\tkind: \"unconfirmed\",\n\t\t\twritten: 0,\n\t\t\tabortedAt: 0,\n\t\t\twriteOutcome: \"unknown\",\n\t\t\treason: \"pty write threw\",\n\t\t});\n\t});\n\n\tit(\"reports a known zero-write refusal without fabricating guard evidence\", async () => {\n\t\tconst writer = testWriter(() => ({\n\t\t\terror: \"pty unavailable\",\n\t\t\twriteOutcome: \"not_written\",\n\t\t}));\n\n\t\tconst result = await run(writer);\n\n\t\texpect(result).toMatchObject({\n\t\t\tkind: \"unconfirmed\",\n\t\t\twritten: 0,\n\t\t\tabortedAt: 0,\n\t\t\treason: \"pty write refused: pty unavailable\",\n\t\t});\n\t});\n\n\tit(\"reports only an actual PTY write refusal after partial input\", async () => {\n\t\tlet writes = 0;\n\t\tconst writer = testWriter(() => {\n\t\t\twrites += 1;\n\t\t\treturn writes === 1\n\t\t\t\t? { success: true }\n\t\t\t\t: { error: \"pty unavailable\", writeOutcome: \"not_written\" };\n\t\t});\n\n\t\tconst result = await run(writer);\n\n\t\texpect(result).toMatchObject({\n\t\t\tkind: \"unconfirmed\",\n\t\t\twritten: 1,\n\t\t\tabortedAt: 1,\n\t\t\treason: \"pty write refused: pty unavailable\",\n\t\t});\n\t});\n});\n\n// ---------------------------------------------------------------------------\n// (ANSWER-PACING) deterministic inter-keystroke pacing\n//\n// Proven on real Claude Code 2.1.228: discrete frames written back-to-back are\n// acknowledged in ~1 ms and outrun the picker's own transitions, dropping\n// keystrokes. The delay is pacing, never a guard — these tests pin its exact\n// placement, the lease-extension ordering around it, the widened deadline, and\n// the untouched legacy path.\n// ---------------------------------------------------------------------------\n\nfunction selectDigit(questionIndex: number): Keystroke {\n\treturn {\n\t\tkind: \"select_digit\",\n\t\tdata: \"1\",\n\t\tquestionIndex,\n\t\toptionIndex: 0,\n\t\texpect: { kind: \"item_picker\", itemIndex: questionIndex },\n\t\tsubmits: false,\n\t};\n}\n\nfunction reviewReturn(questionIndex: number): Keystroke {\n\treturn {\n\t\tkind: \"submit_return\",\n\t\tdata: \"\\r\",\n\t\tquestionIndex,\n\t\toptionIndex: null,\n\t\texpect: { kind: \"same_prompt\", itemIndex: questionIndex },\n\t\tsubmits: true,\n\t};\n}\n\n/** N-1 digits then the review return — the single_select_many byte shape. */\nfunction digitSequence(frames: number): Keystroke[] {\n\tconst keystrokes: Keystroke[] = [];\n\tfor (let i = 0; i < frames - 1; i += 1) keystrokes.push(selectDigit(i));\n\tkeystrokes.push(reviewReturn(frames - 1));\n\treturn keystrokes;\n}\n\nfunction pacedHarness(\n\toptions: { waitAdvancesClock?: boolean; failWait?: boolean } = {},\n) {\n\tlet now = 1_000;\n\tconst timeline: string[] = [];\n\tconst events: Record<string, unknown>[] = [];\n\tconst writer = testWriter((data) => {\n\t\ttimeline.push(`write:${JSON.stringify(data)}`);\n\t\treturn { success: true };\n\t});\n\tconst deps = stubDeps({\n\t\tnow: () => now,\n\t\twait: async (ms) => {\n\t\t\ttimeline.push(`wait:${ms}`);\n\t\t\tif (options.failWait) throw new Error(\"timer subsystem gone\");\n\t\t\tif (options.waitAdvancesClock) now += ms;\n\t\t},\n\t\tleases: testLeases((_leaseId, nowMs) => {\n\t\t\ttimeline.push(\"extend\");\n\t\t\treturn {\n\t\t\t\tok: true as const,\n\t\t\t\tlease: { ...LEASE, expiresAtMs: nowMs + 15_000 },\n\t\t\t};\n\t\t}),\n\t\tlog: (event) => events.push(event),\n\t});\n\tconst inject = (keystrokes: Keystroke[], acknowledgedInputSupported = true) =>\n\t\tinjectSequence(deps, {\n\t\t\tquestion: QUESTION,\n\t\t\thost: HOST,\n\t\t\tkeystrokes,\n\t\t\tleaseId: \"lease-guardless\",\n\t\t\tacknowledgedInputSupported,\n\t\t\twriter,\n\t\t});\n\treturn { inject, timeline, events };\n}\n\ndescribe(\"(ANSWER-PACING) deterministic inter-keystroke pacing\", () => {\n\tit(\"sleeps the exact delay after every non-final acknowledged keystroke and never after the final one\", async () => {\n\t\tconst harness = pacedHarness();\n\t\tconst freetext: Keystroke[] = [\n\t\t\t{\n\t\t\t\tkind: \"freetext_open\",\n\t\t\t\tdata: \"2\",\n\t\t\t\tquestionIndex: 0,\n\t\t\t\toptionIndex: 1,\n\t\t\t\texpect: { kind: \"item_picker\", itemIndex: 0 },\n\t\t\t\tsubmits: false,\n\t\t\t},\n\t\t\t{\n\t\t\t\tkind: \"freetext_body\",\n\t\t\t\tdata: \"typed at the wrist\",\n\t\t\t\tquestionIndex: 0,\n\t\t\t\toptionIndex: 1,\n\t\t\t\texpect: { kind: \"same_prompt\", itemIndex: 0 },\n\t\t\t\tsubmits: false,\n\t\t\t},\n\t\t\t{\n\t\t\t\tkind: \"submit_return\",\n\t\t\t\tdata: \"\\r\",\n\t\t\t\tquestionIndex: 0,\n\t\t\t\toptionIndex: 1,\n\t\t\t\texpect: { kind: \"same_prompt\", itemIndex: 0 },\n\t\t\t\tsubmits: true,\n\t\t\t},\n\t\t];\n\n\t\texpect(await harness.inject(freetext)).toEqual({ kind: \"confirmed\" });\n\t\texpect(harness.timeline).toEqual([\n\t\t\t\"extend\",\n\t\t\t'write:\"2\"',\n\t\t\t`wait:${INTER_KEYSTROKE_DELAY_MS}`,\n\t\t\t\"extend\",\n\t\t\t'write:\"typed at the wrist\"',\n\t\t\t`wait:${INTER_KEYSTROKE_DELAY_MS}`,\n\t\t\t\"extend\",\n\t\t\t'write:\"\\\\r\"',\n\t\t]);\n\t});\n\n\tit(\"extends the lease after the delay, immediately before every post-delay write\", async () => {\n\t\tconst harness = pacedHarness();\n\t\tawait harness.inject(digitSequence(3));\n\n\t\tfor (let i = 0; i < harness.timeline.length; i += 1) {\n\t\t\tif (!harness.timeline[i]?.startsWith(\"wait:\")) continue;\n\t\t\texpect(harness.timeline[i + 1]).toBe(\"extend\");\n\t\t\texpect(harness.timeline[i + 2]?.startsWith(\"write:\")).toBe(true);\n\t\t}\n\t});\n\n\tit(\"never paces the legacy protocol-v2 single-frame write\", async () => {\n\t\tconst harness = pacedHarness();\n\t\tawait harness.inject(digitSequence(3), false);\n\n\t\texpect(harness.timeline).toEqual([\"extend\", 'write:\"11\\\\r\"']);\n\t});\n\n\tit(\"widens the deadline by the pacing budget so a long paced sequence still confirms\", async () => {\n\t\t// 25 frames spend 24 × 500 ms = 12 s sleeping — past the bare 10 s write\n\t\t// budget, inside the widened one. Under a fixed deadline this sequence\n\t\t// aborts mid-prompt.\n\t\tconst frames = 25;\n\t\texpect((frames - 1) * INTER_KEYSTROKE_DELAY_MS).toBeGreaterThan(\n\t\t\tSEQUENCE_DEADLINE_MS,\n\t\t);\n\t\tconst harness = pacedHarness({ waitAdvancesClock: true });\n\n\t\texpect(await harness.inject(digitSequence(frames))).toEqual({\n\t\t\tkind: \"confirmed\",\n\t\t});\n\t\texpect(\n\t\t\tharness.timeline.filter((entry) => entry.startsWith(\"write:\")).length,\n\t\t).toBe(frames);\n\t});\n\n\tit(\"still aborts once the widened deadline is genuinely exhausted\", async () => {\n\t\tlet now = 1_000;\n\t\tconst writer = testWriter(() => ({ success: true }));\n\t\tconst deps = stubDeps({\n\t\t\tnow: () => now,\n\t\t\twait: async () => {\n\t\t\t\t// One pathological stall that burns the write budget AND the whole\n\t\t\t\t// pacing budget for this 2-frame sequence.\n\t\t\t\tnow += SEQUENCE_DEADLINE_MS + INTER_KEYSTROKE_DELAY_MS + 1;\n\t\t\t},\n\t\t});\n\n\t\tconst result = await injectSequence(deps, {\n\t\t\tquestion: QUESTION,\n\t\t\thost: HOST,\n\t\t\tkeystrokes: KEYSTROKES,\n\t\t\tleaseId: \"lease-guardless\",\n\t\t\tacknowledgedInputSupported: true,\n\t\t\twriter,\n\t\t});\n\n\t\texpect(result).toMatchObject({\n\t\t\tkind: \"unconfirmed\",\n\t\t\twritten: 1,\n\t\t\tabortedAt: 1,\n\t\t\treason: \"sequence deadline exceeded\",\n\t\t\twriteOutcome: \"not_written\",\n\t\t});\n\t});\n\n\tit(\"logs a throwing pacing sleep and never downgrades the landed writes\", async () => {\n\t\tconst harness = pacedHarness({ failWait: true });\n\n\t\texpect(await harness.inject(digitSequence(2))).toEqual({\n\t\t\tkind: \"confirmed\",\n\t\t});\n\t\texpect(harness.events).toContainEqual(\n\t\t\texpect.objectContaining({\n\t\t\t\tevent: \"companion.answer.pacing_wait_failed\",\n\t\t\t\terror: \"timer subsystem gone\",\n\t\t\t}),\n\t\t);\n\t});\n\n\tit(\"fails loud at startup when the pacing sleep is not wired\", () => {\n\t\texpect(() =>\n\t\t\tassertAnswerDeps({\n\t\t\t\twriteInput: Object.assign(async () => ({ success: true as const }), {\n\t\t\t\t\twriterKind: RAW_PTY_WRITER_KIND,\n\t\t\t\t\tprepare: async () => ({\n\t\t\t\t\t\tsuccess: true as const,\n\t\t\t\t\t\tacknowledgedInputSupported: true,\n\t\t\t\t\t}),\n\t\t\t\t}),\n\t\t\t\tnudgeRepaint: () => ({ success: true as const }),\n\t\t\t\twriteFramed: async () => ({ success: true as const }),\n\t\t\t\tsnapshotScreen: async () => \"\",\n\t\t\t} as unknown as AnswerDeps),\n\t\t).toThrow(\"wait\");\n\t});\n});\n\n// ---------------------------------------------------------------------------\n// (ANSWER-GUARDLESS) the REPLAY contract\n//\n// A durable ledger row has no abstain column and, since the guard stack was\n// removed, no guard evaluation to reconstruct either. `ledgerRecordToResponse`\n// is the only place a §11.4 replay decides what to say about that, and it is a\n// pure record-to-response mapper, so the derivation is pinned here.\n// ---------------------------------------------------------------------------\n\nfunction ledgerRow(overrides: Partial<LedgerRecord> = {}): LedgerRecord {\n\treturn {\n\t\trequestId:\n\t\t\t\"00000000-0000-4000-8000-000000000001\" as LedgerRecord[\"requestId\"],\n\t\tstatus: \"confirmed\",\n\t\tquestionId: \"q-guardless\",\n\t\tdeviceId: \"device-guardless\",\n\t\tsurface: \"phone\",\n\t\tleaseId: \"lease-guardless\",\n\t\tstartedAtMs: 1 as LedgerRecord[\"startedAtMs\"],\n\t\tcreatedAtMs: 1 as LedgerRecord[\"createdAtMs\"],\n\t\tresolvedAtMs: 2 as LedgerRecord[\"resolvedAtMs\"],\n\t\tfailureCode: null,\n\t\tguardsPassed: [],\n\t\tcoverageEpoch: \"epoch-1\",\n\t\t...overrides,\n\t};\n}\n\ndescribe(\"(ANSWER-GUARDLESS) a replayed answer\", () => {\n\tit(\"reports nothing abstained on a confirmed row\", () => {\n\t\tconst response = ledgerRecordToResponse(ledgerRow());\n\n\t\texpect(response.status).toBe(\"confirmed\");\n\t\texpect(response.resolvedAtMs).toBe(2 as LedgerRecord[\"resolvedAtMs\"]);\n\t\texpect(response.guardsPassed).toEqual([]);\n\t\texpect(response.guardsAbstained).toEqual([]);\n\t});\n\n\tit(\"says it CANNOT SAY for a row that is not confirmed — never []\", () => {\n\t\tconst response = ledgerRecordToResponse(\n\t\t\tledgerRow({ status: \"unconfirmed\", resolvedAtMs: null }),\n\t\t);\n\n\t\texpect(response.status).toBe(\"unconfirmed\");\n\t\texpect(response.resolvedAtMs).toBeNull();\n\t\texpect(response.guardsAbstained).toBeNull();\n\t});\n\n\tit(\"replays a legacy row's stored guard evidence without inferring new outcomes\", () => {\n\t\t// Rows written by an older bridge still name the guards that build\n\t\t// evaluated. They are reported verbatim, and nothing is derived from which\n\t\t// guards are absent.\n\t\tconst response = ledgerRecordToResponse(\n\t\t\tledgerRow({ guardsPassed: [\"transcript\", \"screen\", \"session\"] }),\n\t\t);\n\n\t\texpect(response.guardsPassed).toEqual([\"transcript\", \"screen\", \"session\"]);\n\t\texpect(response.guardsAbstained).toEqual([]);\n\t});\n\n\tit(\"reports an absent lease as absent rather than inventing one\", () => {\n\t\t// The claim is made before the lease is acquired, so a row whose attempt\n\t\t// died between the two has no lease to report.\n\t\tconst response = ledgerRecordToResponse(\n\t\t\tledgerRow({ status: \"failed\", leaseId: null, questionId: null }),\n\t\t);\n\n\t\texpect(response.status).toBe(\"unconfirmed\");\n\t\texpect(response.leaseId).toBe(\"\");\n\t\texpect(response.questionId).toBe(\"\");\n\t});\n});\n","numLines":352,"startLine":520,"totalLines":871}},"sourceToolAssistantUUID":"8943b103-d24e-42dd-a19b-d3b66dcdd321","session_id":"41b65f55-7b