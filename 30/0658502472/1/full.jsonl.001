{"parentUuid":"a7c95894-0526-428a-b4d4-c0dea76989b8","isSidechain":false,"promptId":"5548f27b-2b1d-4e0e-84da-bd27822c3dc9","type":"user","message":{"role":"user","content":[{"tool_use_id":"call_a4EEwvP0D8LEXDrMVAPnHLUO","type":"tool_result","content":"1\t#!/usr/bin/env node\n2\t// Feature-marker survival gate, standalone. Mirrors run_marker_gate in\n3\t// nightly-merge.yml: parse the fenced ```markers block in FEATURES.md\n4\t// (lines are \"<token>\\t<glob-root>\") and require every token to appear\n5\t// somewhere under its root. An empty/renamed block fails LOUD (a vacuous\n6\t// pass would let a repair silently delete a feature).\n7\t// Used by the CI build-repair loop to prove an AI repair removed no feature.\n8\timport { execFileSync } from \"node:child_process\";\n9\timport { readFileSync } from \"node:fs\";\n10\t\n11\tconst features = readFileSync(\"FEATURES.md\", \"utf8\");\n12\tconst m = features.match(/^```markers\\r?\\n([\\s\\S]*?)^```/m);\n13\tif (!m) {\n14\t\tconsole.error(\"::error::FEATURES.md markers block is missing — the marker gate would pass vacuously. Refusing to pass.\");\n15\t\tprocess.exit(1);\n16\t}\n17\tconst lines = m[1]\n18\t\t.split(/\\r?\\n/)\n19\t\t.map((l) => l.trim())\n20\t\t.filter((l) => l.length > 0);\n21\tif (lines.length === 0) {\n22\t\tconsole.error(\"::error::FEATURES.md markers block is empty — the marker gate would pass vacuously. Refusing to pass.\");\n23\t\tprocess.exit(1);\n24\t}\n25\t\n26\tlet missing = 0;\n27\tfor (const line of lines) {\n28\t\tconst tab = line.indexOf(\"\\t\");\n29\t\t// Parity with the awk gate in nightly-merge.yml: a tab-less line there\n30\t\t// yields an empty root and reports MISSING — fail loud here too rather\n31\t\t// than silently defaulting to repo root.\n32\t\tif (tab === -1) {\n33\t\t\tconsole.error(`::error::malformed FEATURES.md marker line (no tab separator): '${line}'`);\n34\t\t\tprocess.exit(1);\n35\t\t}\n36\t\tconst tok = line.slice(0, tab);\n37\t\tconst root = line.slice(tab + 1).trim();\n38\t\tif (!tok || !root) {\n39\t\t\tconsole.error(`::error::malformed FEATURES.md marker line (empty token or root): '${line}'`);\n40\t\t\tprocess.exit(1);\n41\t\t}\n42\t\tlet found = false;\n43\t\ttry {\n44\t\t\t// -r recursive, -q quiet, -s no fs errors, -F fixed string\n45\t\t\texecFileSync(\"grep\", [\"-rqsF\", \"--\", tok, root], { stdio: \"ignore\" });\n46\t\t\tfound = true;\n47\t\t} catch {\n48\t\t\tfound = false;\n49\t\t}\n50\t\tif (found) {\n51\t\t\tconsole.log(`  OK   ${tok} (${root})`);\n52\t\t} else {\n53\t\t\tconsole.error(`::error::feature marker MISSING: '${tok}' under ${root}`);\n54\t\t\tmissing++;\n55\t\t}\n56\t}\n57\tif (missing > 0) {\n58\t\tconsole.error(`::error::${missing} feature marker(s) missing — refusing to pass.`);\n59\t\tprocess.exit(1);\n60\t}\n61\tconsole.log(`All ${lines.length} feature markers present.`);\n62\t"}]},"uuid":"a70d213c-91c7-4171-9a53-289c1583760e","timestamp":"2026-08-12T18:03:41.908Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\khair\\Code Projects\\fork-superset-windows-arm64\\scripts\\check-feature-markers.mjs","content":"#!/usr/bin/env node\n// Feature-marker survival gate, standalone. Mirrors run_marker_gate in\n// nightly-merge.yml: parse the fenced ```markers block in FEATURES.md\n// (lines are \"<token>\\t<glob-root>\") and require every token to appear\n// somewhere under its root. An empty/renamed block fails LOUD (a vacuous\n// pass would let a repair silently delete a feature).\n// Used by the CI build-repair loop to prove an AI repair removed no feature.\nimport { execFileSync } from \"node:child_process\";\nimport { readFileSync } from \"node:fs\";\n\nconst features = readFileSync(\"FEATURES.md\", \"utf8\");\nconst m = features.match(/^```markers\\r?\\n([\\s\\S]*?)^```/m);\nif (!m) {\n\tconsole.error(\"::error::FEATURES.md markers block is missing — the marker gate would pass vacuously. Refusing to pass.\");\n\tprocess.exit(1);\n}\nconst lines = m[1]\n\t.split(/\\r?\\n/)\n\t.map((l) => l.trim())\n\t.filter((l) => l.length > 0);\nif (lines.length === 0) {\n\tconsole.error(\"::error::FEATURES.md markers block is empty — the marker gate would pass vacuously. Refusing to pass.\");\n\tprocess.exit(1);\n}\n\nlet missing = 0;\nfor (const line of lines) {\n\tconst tab = line.indexOf(\"\\t\");\n\t// Parity with the awk gate in nightly-merge.yml: a tab-less line there\n\t// yields an empty root and reports MISSING — fail loud here too rather\n\t// than silently defaulting to repo root.\n\tif (tab === -1) {\n\t\tconsole.error(`::error::malformed FEATURES.md marker line (no tab separator): '${line}'`);\n\t\tprocess.exit(1);\n\t}\n\tconst tok = line.slice(0, tab);\n\tconst root = line.slice(tab + 1).trim();\n\tif (!tok || !root) {\n\t\tconsole.error(`::error::malformed FEATURES.md marker line (empty token or root): '${line}'`);\n\t\tprocess.exit(1);\n\t}\n\tlet found = false;\n\ttry {\n\t\t// -r recursive, -q quiet, -s no fs errors, -F fixed string\n\t\texecFileSync(\"grep\", [\"-rqsF\", \"--\", tok, root], { stdio: \"ignore\" });\n\t\tfound = true;\n\t} catch {\n\t\tfound = false;\n\t}\n\tif (found) {\n\t\tconsole.log(`  OK   ${tok} (${root})`);\n\t} else {\n\t\tconsole.error(`::error::feature marker MISSING: '${tok}' under ${root}`);\n\t\tmissing++;\n\t}\n}\nif (missing > 0) {\n\tconsole.error(`::error::${missing} feature marker(s) missing — refusing to pass.`);\n\tprocess.exit(1);\n}\nconsole.log(`All ${lines.length} feature markers present.`);\n","numLines":62,"startLine":1,"totalLines":62}},"sourceToolAssistantUUID":"a7c95894-0526-428a-b4d4-c0dea76989b8","session_id":"41b65f55-7b51-4cfd-82d1-d1d1eec49d91","userType":"external","entrypoint":"cli","cwd":"C:\\Users\\khair\\Code Projects\\fork-superset-windows-arm64","sessionId":"41b65f55-7b51-4cfd-82d1-d1d1eec49d91","version":"2.1.228","gitBranch":"main","slug":"jolly-singing-lemur"}
